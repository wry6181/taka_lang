fn tk_kind_name(i32 k) -> sview {
    if (k == K_IDENT) { return tk_sview("IDENT", 5); }
    if (k == K_WILDCARD) { return tk_sview("_", 1); }
    if (k == K_INT) { return tk_sview("INT", 3); }
