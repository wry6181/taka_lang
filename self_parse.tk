    if (k == K_DOTDOT) { return tk_sview("..", 2); }
    if (k == K_ARROW) { return tk_sview("->", 2); }
    if (k == K_FATARROW) { return tk_sview("=>", 2); }
    if (k == K_QMARK) { return tk_sview("?", 1); }
    if (k == K_EQ) { return tk_sview("=", 1); }
    if (k == K_EQEQ) { return tk_sview("==", 2); }
    if (k == K_BANGEQ) { return tk_sview("!=", 2); }
    if (k == K_BANG) { return tk_sview("!", 1); }
    if (k == K_TILDE) { return tk_sview("~", 1); }
    if (k == K_PLUS) { return tk_sview("+", 1); }
    if (k == K_MINUS) { return tk_sview("-", 1); }
