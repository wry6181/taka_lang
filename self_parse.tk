struct Arena { u8* buf, u64 cap, u64 pos, }

fn arena_mk(u8* buf, u64 cap) -> Arena {
    Arena a = Arena { buf: buf, cap: cap, pos: 0, };
    return a;
}

fn arena_alloc(Arena* a, u64 n) -> u8* {
    u64 start = (a.pos + 7) / 8 * 8;
    u64 end = start + n;
    if (end > a.cap) {
        return null;
    }
    a.pos = end;
    return a.buf + start;
}

fn zac(Arena* a, u64 n) -> u8* {
    u8* m = arena_alloc(a, n);
    if (m == null) {
        return null;
    }
    mut u64 i = 0;
    while (i < n) {
        m[i] = 0;
        i = i + 1;
    }
    return m;
}

fn str_eq(sview a, sview b) -> bool {
    if (a.len != b.len) {
        return false;
    }
    mut u64 i = 0;
    while (i < a.len as u64) {
        if (a.ptr[i] != b.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn i32_to_str(i32 x, Arena* a) -> sview {
    u8* buf = arena_alloc(a, 12);
    bool neg = x < 0;
    mut u64 n = x as u64;
    if (neg) {
        n = (0 - x) as u64;
    }
    mut u64 end = 12;
    if (n == 0) {
        end = end - 1;
        buf[end] = 48;
    }
    while (n > 0) {
        u64 d = n % 10;
        n = n / 10;
        end = end - 1;
        buf[end] = (48 + d) as u8;
    }
    mut u64 at = end;
    if (neg) {
        at = at - 1;
        buf[at] = 45;
    }
    u64 len = 12 - at;
    sview s = tk_sview_u8(buf + at, len);
    return s;
}

// growable vector of 8-byte items (pointers); mirrors BAPPEND.
struct Vec { u8* buf, u64 len, u64 cap, }
struct Slot { u8* p, }

fn vec_new() -> Vec* {
    u8* m = tk_malloc(24);
    Vec* v = m as Vec*;
    v.buf = null;
    v.len = 0;
    v.cap = 0;
    return v;
}

fn vec_push(Vec* v, u8* x) {
    if (v.len == v.cap) {
        mut u64 ncap = 8;
        if (v.cap != 0) {
            ncap = v.cap + v.cap;
        }
        u8* nb = tk_malloc(ncap * 8);
        mut u64 i = 0;
        while (i < v.len) {
            Slot* d = (nb + i * 8) as Slot*;
            Slot* s = (v.buf + i * 8) as Slot*;
            d.p = s.p;
            i = i + 1;
        }
        v.buf = nb;
        v.cap = ncap;
    }
    Slot* dst = (v.buf + v.len * 8) as Slot*;
    dst.p = x;
    v.len = v.len + 1;
    return;
}

fn vec_get(Vec* v, u64 i) -> u8* {
    Slot* s = (v.buf + i * 8) as Slot*;
    return s.p;
}

