    if (str_eq(w, tk_sview("if", 2))) { return K_IF; }
    if (str_eq(w, tk_sview("else", 4))) { return K_ELSE; }
    if (str_eq(w, tk_sview("while", 5))) { return K_WHILE; }
    if (str_eq(w, tk_sview("match", 5))) { return K_MATCH; }
    if (str_eq(w, tk_sview("break", 5))) { return K_BREAK; }
    if (str_eq(w, tk_sview("continue", 8))) { return K_CONTINUE; }
    if (str_eq(w, tk_sview("return", 6))) { return K_RETURN; }
    if (str_eq(w, tk_sview("defer", 5))) { return K_DEFER; }
    if (str_eq(w, tk_sview("perform", 7))) { return K_PERFORM; }
    if (str_eq(w, tk_sview("handle", 6))) { return K_HANDLE; }
    if (str_eq(w, tk_sview("with", 4))) { return K_WITH; }
    if (str_eq(w, tk_sview("resume", 6))) { return K_RESUME; }
    if (str_eq(w, tk_sview("transact", 8))) { return K_TRANSACT; }
    if (str_eq(w, tk_sview("spawn", 5))) { return K_SPAWN; }
    if (str_eq(w, tk_sview("as", 2))) { return K_AS; }
    if (str_eq(w, tk_sview("sizeof", 6))) { return K_SIZEOF; }
    if (str_eq(w, tk_sview("offsetof", 8))) { return K_OFFSETOF; }
    if (str_eq(w, tk_sview("true", 4))) { return K_TRUE; }
    if (str_eq(w, tk_sview("false", 5))) { return K_FALSE; }
    if (str_eq(w, tk_sview("null", 4))) { return K_NULL; }
    if (str_eq(w, tk_sview("undef", 5))) { return K_UNDEF; }
    if (str_eq(w, tk_sview("Self", 4))) { return K_SELF; }
    if (str_eq(w, tk_sview("i8", 2))) { return K_I8; }
    if (str_eq(w, tk_sview("i16", 3))) { return K_I16; }
    if (str_eq(w, tk_sview("i32", 3))) { return K_I32; }
    if (str_eq(w, tk_sview("i64", 3))) { return K_I64; }
    if (str_eq(w, tk_sview("u8", 2))) { return K_U8; }
    if (str_eq(w, tk_sview("u16", 3))) { return K_U16; }
    if (str_eq(w, tk_sview("u32", 3))) { return K_U32; }
    if (str_eq(w, tk_sview("u64", 3))) { return K_U64; }
    if (str_eq(w, tk_sview("f32", 3))) { return K_F32; }
    if (str_eq(w, tk_sview("f64", 3))) { return K_F64; }
    if (str_eq(w, tk_sview("char", 4))) { return K_CHAR_TY; }
    if (str_eq(w, tk_sview("bool", 4))) { return K_BOOL; }
    if (str_eq(w, tk_sview("sview", 5))) { return K_SVIEW; }
    if (str_eq(w, tk_sview("never", 5))) { return K_NEVER; }
    if (str_eq(w, tk_sview("io", 2))) { return K_IO; }
    if (str_eq(w, tk_sview("alloc", 5))) { return K_ALLOC; }
    if (str_eq(w, tk_sview("reads", 5))) { return K_READS; }
    if (str_eq(w, tk_sview("writes", 6))) { return K_WRITES; }
    if (str_eq(w, tk_sview("decides", 7))) { return K_DECIDES; }
    if (str_eq(w, tk_sview("suspends", 8))) { return K_SUSPENDS; }
    if (str_eq(w, tk_sview("transacts", 9))) { return K_TRANSACTS; }
    if (str_eq(w, tk_sview("pure", 4))) { return K_PURE; }
    if (str_eq(w, tk_sview("ownership", 9))) { return K_OWNERSHIP; }
    return K_IDENT;
}

