}

fn tk_make(TkLex* lx, i32 kind, u64 start, i32 line, i32 col) -> TkTok {
    TkTok t = TkTok { kind: kind, start: lx.src + start, len: lx.pos - start, line: line, col: col, };
    return t;
}

fn tk_is_alpha(u8 c) -> bool {
    if (c >= 97 && c <= 122) { return true; }
    if (c >= 65 && c <= 90) { return true; }
    return false;
}

fn tk_is_digit(u8 c) -> bool {
    if (c >= 48 && c <= 57) { return true; }
    return false;
}

fn tk_is_alnum(u8 c) -> bool {
    if (tk_is_alpha(c)) { return true; }
