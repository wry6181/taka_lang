i32 K_WHILE = 28;
i32 K_MATCH = 29;
i32 K_BREAK = 30;
i32 K_CONTINUE = 31;
i32 K_RETURN = 32;
i32 K_DEFER = 33;
i32 K_PERFORM = 34;
i32 K_HANDLE = 35;
i32 K_WITH = 36;
i32 K_RESUME = 37;
i32 K_TRANSACT = 38;
i32 K_SPAWN = 39;
i32 K_AS = 40;
i32 K_SIZEOF = 41;
i32 K_OFFSETOF = 42;
i32 K_TRUE = 43;
i32 K_FALSE = 44;
i32 K_NULL = 45;
i32 K_UNDEF = 46;
i32 K_SELF = 47;
i32 K_I8 = 48;
i32 K_I16 = 49;
i32 K_I32 = 50;
i32 K_I64 = 51;
i32 K_U8 = 52;
i32 K_U16 = 53;
i32 K_U32 = 54;
i32 K_U64 = 55;
i32 K_F32 = 56;
i32 K_F64 = 57;
i32 K_CHAR_TY = 58;
i32 K_BOOL = 59;
i32 K_SVIEW = 60;
i32 K_NEVER = 61;
i32 K_IO = 62;
i32 K_ALLOC = 63;
i32 K_READS = 64;
i32 K_WRITES = 65;
i32 K_DECIDES = 66;
i32 K_SUSPENDS = 67;
i32 K_TRANSACTS = 68;
i32 K_PURE = 69;
i32 K_OWNERSHIP = 70;
i32 K_EFFECT_KW = 71;
i32 K_LPAREN = 72;
i32 K_RPAREN = 73;
i32 K_LBRACE = 74;
i32 K_RBRACE = 75;
i32 K_LBRACK = 76;
i32 K_RBRACK = 77;
i32 K_SEMI = 78;
i32 K_COMMA = 79;
i32 K_COLON = 80;
i32 K_COLON2 = 81;
i32 K_DOT = 82;
i32 K_DOTDOT = 83;
i32 K_ARROW = 84;
i32 K_FATARROW = 85;
i32 K_QMARK = 86;
i32 K_EQ = 87;
i32 K_EQEQ = 88;
i32 K_BANGEQ = 89;
i32 K_BANG = 90;
i32 K_TILDE = 91;
i32 K_PLUS = 92;
i32 K_MINUS = 93;
i32 K_STAR = 94;
i32 K_SLASH = 95;
i32 K_PERCENT = 96;
i32 K_LT = 97;
i32 K_GT = 98;
i32 K_LTEQ = 99;
i32 K_GTEQ = 100;
i32 K_SHL = 101;
i32 K_SHR = 102;
i32 K_AMP = 103;
i32 K_AMP2 = 104;
i32 K_PIPE = 105;
i32 K_PIPE2 = 106;
i32 K_CARET = 107;
i32 K_PLUS_EQ = 108;
i32 K_MINUS_EQ = 109;
i32 K_STAR_EQ = 110;
i32 K_SLASH_EQ = 111;
i32 K_PERCENT_EQ = 112;
i32 K_SHL_EQ = 113;
i32 K_SHR_EQ = 114;
i32 K_AMP_EQ = 115;
i32 K_PIPE_EQ = 116;
i32 K_CARET_EQ = 117;
i32 K_PLUSPLUS = 118;
i32 K_MINUSMINUS = 119;
i32 K_EOF = 120;
i32 K_ERROR = 121;

struct Expr { i32 kind, u8* tstart, u64 tlen, Vec* path, Vec* targs, Expr* lhs, Expr* rhs, Expr* cond, Expr* then_e, Expr* else_e, i32 op, Type* cast_to, Expr* callee, Expr* index, char* field, Vec* args, Vec* sfields, Vec* elems, Expr* fill_elem, Expr* fill_n, Expr* scrut, Vec* arms, Vec* stmts, Expr* trailing, }
struct Stmt { i32 kind, bool is_mut, Type* ty, Vec* names, Vec* inits, Expr* e1, Expr* e2, i32 op, bool has_assign, Vec* stmts, Expr* trailing, bool has_trailing, Expr* cond, Expr* cond_ex, Vec* then_s, Expr* then_t, Vec* eifs, Vec* els, Expr* els_t, bool has_els, Stmt* for_init_decl, Stmt* for_init_simple, bool for_init_empty, bool for_init_is_decl, Expr* for_cond, bool has_for_cond, Stmt* for_incr, bool has_incr, Expr* m_scrut, Vec* m_arms, Expr* ret_e, bool has_ret, char* label, bool defer_is_block, Vec* defer_blk, Stmt* defer_simple, }
struct Pat { i32 kind, u8* tstart, u64 tlen, i32 tkind, bool is_mut, char* name, Vec* path, Vec* args, Vec* fields, bool has_dotdot, Vec* or_next, }
struct Type { i32 kind, bool is_const, i32 stars, bool is_ref, i32 prim, Vec* path, Vec* gargs, Vec* elems, Type* elem, }
struct Item { i32 kind, char* fn_name, Vec* params, Type* ret, bool is_proto, Vec* body, Expr* trail, char* sname, Vec* fields, char* ename, Vec* vars, Stmt* gdecl, }
struct ArmE { Pat* pat, Expr* guard, Expr* body, }
struct ArmS { Pat* pat, Expr* guard, Vec* bs, }
struct SF { char* field, Expr* e, }
struct FP { char* field, Pat* pat, }
struct Param { bool is_mut, Type* ty, char* nm, }
struct SFld { Type* ty, char* nm, }
struct Variant { char* vn, bool has_tuple, Vec* ts, bool has_struct, Vec* fs, bool has_disc, Expr* disc, }
struct EIF { Expr* c, Expr* e, Vec* s, Expr* t, }

// ---- sexp reader ----
struct SX { bool is_int, u64 ival, u8* sdata, u64 slen, Vec* kids, }
struct SXB { u8* src, u64 len, u64 pos, }

fn sxberr(char* msg) {
    tk_eprint("sexp parse error: " as u8*, 18);
    tk_eprint(msg as u8*, tk_strlen(msg));
    tk_eprint("\n" as u8*, 1);
    tk_set_exit(1);
    return;
}

fn sx_skip(SXB* b) {
    while (b.pos < b.len) {
        u8 c = b.src[b.pos];
        if (c == 32 || c == 10 || c == 13 || c == 9) {
            b.pos = b.pos + 1;
        } else {
            break;
        }
    }
    return;
}

fn sx_new(Arena* a) -> SX* {
    mut u8* m = zac(a, 40);
    if (m == null) {
        return null;
    }
    SX* s = m as SX*;
    return s;
}

fn sx_read(Arena* a, SXB* b) -> SX* {
    sx_skip(b);
    if (b.pos >= b.len) {
        return null;
    }
    u8 c = b.src[b.pos];
    if (c == 40) {
        b.pos = b.pos + 1;
        SX* s = sx_new(a);
        if (s == null) {
            return null;
        }
        while (true) {
            sx_skip(b);
            if (b.pos >= b.len) {
                return null;
            }
            if (b.src[b.pos] == 41) {
                b.pos = b.pos + 1;
                break;
            }
            mut SX* k = sx_read(a, b);
            if (k == null) {
                return null;
            }
            s.kids = vpush(s.kids, k as u8*);
        }
        return s;
    }
    if (c == 41) {
        return null;
    }
    if (c == 34) {
        b.pos = b.pos + 1;
        SX* s = sx_new(a);
        if (s == null) {
            return null;
        }
        u8* tmp = tk_malloc(65536);
        mut u64 n = 0;
        while (b.pos < b.len && b.src[b.pos] != 34) {
            if (n >= 65530) {
                tk_free(tmp);
                return null;
            }
            u8 d = b.src[b.pos];
            if (d == 92) {
                b.pos = b.pos + 1;
                if (b.pos >= b.len) {
                    break;
                }
                u8 e = b.src[b.pos];
                if (e == 110) {
                    tmp[n] = 10;
                } else if (e == 92) {
                    tmp[n] = 92;
                } else if (e == 34) {
                    tmp[n] = 34;
                } else {
                    tmp[n] = e;
                }
                n = n + 1;
                b.pos = b.pos + 1;
            } else {
                tmp[n] = d;
                n = n + 1;
                b.pos = b.pos + 1;
            }
        }
        if (b.pos < b.len) {
            b.pos = b.pos + 1;
        }
        u8* cp = arena_alloc(a, n + 1);
        mut u64 i = 0;
        while (i < n) {
            cp[i] = tmp[i];
            i = i + 1;
        }
        cp[n] = 0;
        tk_free(tmp);
        s.sdata = cp;
        s.slen = n;
        return s;
    }
    if (c >= 48 && c <= 57) {
        SX* s = sx_new(a);
        if (s == null) {
            return null;
        }
        s.is_int = true;
        mut u64 v = 0;
        while (b.pos < b.len && b.src[b.pos] >= 48 && b.src[b.pos] <= 57) {
            v = v * 10 + (b.src[b.pos] - 48) as u64;
            b.pos = b.pos + 1;
        }
        s.ival = v;
        return s;
    }
    SX* s = sx_new(a);
    if (s == null) {
        return null;
    }
    u64 start = b.pos;
    while (b.pos < b.len && b.src[b.pos] != 32 && b.src[b.pos] != 10 && b.src[b.pos] != 13 && b.src[b.pos] != 9 && b.src[b.pos] != 40 && b.src[b.pos] != 41) {
        b.pos = b.pos + 1;
    }
    s.sdata = b.src + start;
    s.slen = b.pos - start;
    return s;
}
fn sx_eq(SX* s, char* lit, u64 n) -> bool {
    if (s == null || s.is_int || s.slen != n) {
        return false;
    }
    mut u64 i = 0;
    while (i < n) {
        if (s.sdata[i] != lit[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn sx_int(SX* s) -> u64 {
    return s.ival;
}

fn sx_kid(SX* s, u64 i) -> SX* {
    return vec_get(s.kids, i) as SX*;
}

fn sx_nul(Arena* a, SX* s) -> char* {
    mut u8* m = arena_alloc(a, s.slen + 1);
    if (m == null) {
        return "oom";
    }
    mut u64 i = 0;
    while (i < s.slen) {
        m[i] = s.sdata[i];
        i = i + 1;
    }
    m[s.slen] = 0;
    return m as char*;
}

fn cv_type(Arena* a, SX* s) -> Type* {
    mut u8* m = zac(a, 64);
    if (m == null) {
        return null;
    }
    Type* t = m as Type*;
    SX* b = sx_kid(s, 1);
    if (b.is_int) {
        t.kind = X_TY_PRIM;
        t.prim = b.ival as i32;
    } else if (sx_eq(b, "auto", 4)) {
        t.kind = X_TY_AUTO;
    } else {
        t.kind = X_TY_PATH;
    }
    t.stars = sx_kid(s, 2).ival as i32;
    if (sx_kid(s, 3).ival != 0) {
        t.is_ref = true;
    }
    if (sx_kid(s, 4).ival != 0) {
        t.is_const = true;
    }
    if (t.kind == X_TY_PATH) {
        SX* pb = sx_kid(b, 1);
        mut u64 i = 0;
        while (i < vlen(pb.kids)) {
            t.path = vpush(t.path, sx_nul(a, sx_kid(pb, i)) as u8*);
            i = i + 1;
        }
        SX* gb = sx_kid(b, 2);
        i = 0;
        while (i < vlen(gb.kids)) {
            t.gargs = vpush(t.gargs, cv_type(a, sx_kid(gb, i)) as u8*);
            i = i + 1;
        }
    }
    return t;
}

fn cv_pat(Arena* a, SX* s) -> Pat* {
    mut u8* m = zac(a, 96);
    if (m == null) {
        return null;
    }
    Pat* p = m as Pat*;
    p.kind = sx_kid(s, 0).ival as i32;
    if (p.kind == X_PAT_REF) {
        p.name = sx_nul(a, sx_kid(s, 1));
    } else if (p.kind == X_PAT_LIT) {
        p.tkind = sx_kid(s, 1).ival as i32;
        SX* q = sx_kid(s, 2);
        p.tstart = q.sdata;
        p.tlen = q.slen;
    } else if (p.kind == X_PAT_BIND) {
        if (sx_kid(s, 1).ival != 0) {
            p.is_mut = true;
        }
        p.name = sx_nul(a, sx_kid(s, 2));
    } else if (p.kind == X_PAT_PATH) {
        SX* segs = sx_kid(s, 1);
        mut u64 i = 0;
        while (i < vlen(segs.kids)) {
            p.path = vpush(p.path, sx_nul(a, sx_kid(segs, i)) as u8*);
            i = i + 1;
        }
        SX* ag = sx_kid(s, 2);
        i = 0;
        while (i < vlen(ag.kids)) {
            p.args = vpush(p.args, cv_pat(a, sx_kid(ag, i)) as u8*);
            i = i + 1;
        }
        SX* fg = sx_kid(s, 3);
        i = 0;
        while (i < vlen(fg.kids)) {
            SX* fe = sx_kid(fg, i);
            u8* fm = zac(a, 16);
            FP* fp = fm as FP*;
            fp.field = sx_nul(a, sx_kid(fe, 0));
            fp.pat = cv_pat(a, sx_kid(fe, 1));
            p.fields = vpush(p.fields, fp as u8*);
            i = i + 1;
        }
        if (sx_kid(s, 4).ival != 0) {
            p.has_dotdot = true;
        }
        SX* og = sx_kid(s, 5);
        i = 0;
        while (i < vlen(og.kids)) {
            p.or_next = vpush(p.or_next, cv_pat(a, sx_kid(og, i)) as u8*);
            i = i + 1;
        }
    }
    return p;
}

fn cv_opt_expr(Arena* a, SX* s) -> Expr* {
    if (s.is_int) {
        return null;
    }
    return cv_expr(a, s);
}

fn cv_expr(Arena* a, SX* s) -> Expr* {
    if (s.is_int) {
        return null;
    }
    mut u8* m = zac(a, 208);
    if (m == null) {
        return null;
    }
    Expr* e = m as Expr*;
    e.kind = sx_kid(s, 0).ival as i32;
    if (e.kind == X_EX_INT || e.kind == X_EX_FLOAT || e.kind == X_EX_STRING || e.kind == X_EX_CHAR || e.kind == X_EX_BOOL) {
        SX* q = sx_kid(s, 1);
        e.tstart = q.sdata;
        e.tlen = q.slen;
    } else if (e.kind == X_EX_VAR) {
        SX* segs = sx_kid(s, 1);
        mut u64 i = 0;
        while (i < vlen(segs.kids)) {
            e.path = vpush(e.path, sx_nul(a, sx_kid(segs, i)) as u8*);
            i = i + 1;
        }
    } else if (e.kind == X_EX_PAREN) {
        e.lhs = cv_expr(a, sx_kid(s, 1));
    } else if (e.kind == X_EX_STRUCT_LIT) {
        SX* segs = sx_kid(s, 1);
        mut u64 i = 0;
        while (i < vlen(segs.kids)) {
            e.path = vpush(e.path, sx_nul(a, sx_kid(segs, i)) as u8*);
            i = i + 1;
        }
        SX* fg = sx_kid(s, 2);
        i = 0;
        while (i < vlen(fg.kids)) {
            SX* fe = sx_kid(fg, i);
            u8* sm = zac(a, 16);
            SF* sf = sm as SF*;
            sf.field = sx_nul(a, sx_kid(fe, 0));
            sf.e = cv_expr(a, sx_kid(fe, 1));
            e.sfields = vpush(e.sfields, sf as u8*);
            i = i + 1;
        }
    } else if (e.kind == X_EX_ARRAY_LIST) {
        mut u64 i = 1;
        while (i < vlen(s.kids)) {
            e.elems = vpush(e.elems, cv_expr(a, sx_kid(s, i)) as u8*);
            i = i + 1;
        }
    } else if (e.kind == X_EX_MATCH) {
        e.scrut = cv_expr(a, sx_kid(s, 1));
        SX* ag = sx_kid(s, 2);
        mut u64 i = 0;
        while (i < vlen(ag.kids)) {
            SX* an = sx_kid(ag, i);
            u8* am = zac(a, 24);
            ArmE* arm = am as ArmE*;
            arm.pat = cv_pat(a, sx_kid(an, 0));
            arm.guard = cv_opt_expr(a, sx_kid(an, 1));
            arm.body = cv_expr(a, sx_kid(an, 2));
            e.arms = vpush(e.arms, arm as u8*);
            i = i + 1;
        }
    } else if (e.kind == X_EX_UNARY) {
        e.op = sx_kid(s, 1).ival as i32;
        e.lhs = cv_expr(a, sx_kid(s, 2));
    } else if (e.kind == X_EX_BINARY) {
        e.op = sx_kid(s, 1).ival as i32;
        e.lhs = cv_expr(a, sx_kid(s, 2));
        e.rhs = cv_expr(a, sx_kid(s, 3));
    } else if (e.kind == X_EX_CAST) {
        e.lhs = cv_expr(a, sx_kid(s, 1));
        e.cast_to = cv_type(a, sx_kid(s, 2));
    } else if (e.kind == X_EX_TERNARY) {
        e.cond = cv_expr(a, sx_kid(s, 1));
        e.then_e = cv_expr(a, sx_kid(s, 2));
        e.else_e = cv_expr(a, sx_kid(s, 3));
    } else if (e.kind == X_EX_BLOCK) {
        SX* sg = sx_kid(s, 1);
        mut u64 i = 0;
        while (i < vlen(sg.kids)) {
            e.stmts = vpush(e.stmts, cv_stmt(a, sx_kid(sg, i)) as u8*);
            i = i + 1;
        }
        e.trailing = cv_expr(a, sx_kid(s, 2));
    } else if (e.kind == X_EX_CALL) {
        e.callee = cv_expr(a, sx_kid(s, 1));
        SX* ag = sx_kid(s, 2);
        mut u64 i = 0;
        while (i < vlen(ag.kids)) {
            e.args = vpush(e.args, cv_expr(a, sx_kid(ag, i)) as u8*);
            i = i + 1;
        }
    } else if (e.kind == X_EX_INDEX) {
        e.callee = cv_expr(a, sx_kid(s, 1));
        e.index = cv_expr(a, sx_kid(s, 2));
    } else if (e.kind == X_EX_FIELD) {
        e.callee = cv_expr(a, sx_kid(s, 1));
        e.field = sx_nul(a, sx_kid(s, 2));
    } else if (e.kind == X_EX_POST_INC || e.kind == X_EX_POST_DEC) {
        e.lhs = cv_expr(a, sx_kid(s, 1));
    }
    return e;
}

fn cv_stmt(Arena* a, SX* s) -> Stmt* {
    mut u8* m = zac(a, 296);
    if (m == null) {
        return null;
    }
    Stmt* st = m as Stmt*;
    st.kind = sx_kid(s, 0).ival as i32;
    if (st.kind == X_ST_DECL) {
        if (sx_kid(s, 1).ival != 0) {
            st.is_mut = true;
        }
        st.ty = cv_type(a, sx_kid(s, 2));
        SX* pr = sx_kid(s, 4);
        st.names = vpush(st.names, sx_nul(a, sx_kid(pr, 0)) as u8*);
        st.inits = vpush(st.inits, cv_expr(a, sx_kid(pr, 1)) as u8*);
    } else if (st.kind == X_ST_SIMPLE) {
        st.e1 = cv_expr(a, sx_kid(s, 1));
        SX* ao = sx_kid(s, 2);
        if (!ao.is_int) {
            st.op = ao.ival as i32;
            st.has_assign = true;
        } else if (ao.ival != 0) {
            st.op = ao.ival as i32;
            st.has_assign = true;
        }
        st.e2 = cv_opt_expr(a, sx_kid(s, 3));
    } else if (st.kind == X_ST_BLOCK) {
        if (sx_kid(s, 1).ival != 0) {
            st.has_trailing = true;
        }
        SX* sg = sx_kid(s, 2);
        mut u64 i = 0;
        while (i < vlen(sg.kids)) {
            st.stmts = vpush(st.stmts, cv_stmt(a, sx_kid(sg, i)) as u8*);
            i = i + 1;
        }
        st.trailing = cv_opt_expr(a, sx_kid(s, 3));
    } else if (st.kind == X_ST_MATCH_STMT) {
        st.m_scrut = cv_expr(a, sx_kid(s, 1));
        SX* ag = sx_kid(s, 2);
        mut u64 i = 0;
        while (i < vlen(ag.kids)) {
            SX* an = sx_kid(ag, i);
            u8* am = zac(a, 24);
            ArmS* arm = am as ArmS*;
            arm.pat = cv_pat(a, sx_kid(an, 0));
            arm.guard = cv_opt_expr(a, sx_kid(an, 1));
            SX* bg = sx_kid(an, 2);
            mut u64 j = 0;
            while (j < vlen(bg.kids)) {
                arm.bs = vpush(arm.bs, cv_stmt(a, sx_kid(bg, j)) as u8*);
                j = j + 1;
            }
            st.m_arms = vpush(st.m_arms, arm as u8*);
            i = i + 1;
        }
    } else if (st.kind == X_ST_IF) {
        st.cond = cv_expr(a, sx_kid(s, 1));
        st.cond_ex = cv_expr(a, sx_kid(s, 2));
        SX* tg = sx_kid(s, 3);
        mut u64 i = 0;
        while (i < vlen(tg.kids)) {
            st.then_s = vpush(st.then_s, cv_stmt(a, sx_kid(tg, i)) as u8*);
            i = i + 1;
        }
        st.then_t = cv_opt_expr(a, sx_kid(s, 4));
        SX* eg = sx_kid(s, 5);
        i = 0;
        while (i < vlen(eg.kids)) {
            SX* en = sx_kid(eg, i);
            u8* em = zac(a, 32);
            EIF* ei = em as EIF*;
            ei.c = cv_expr(a, sx_kid(en, 0));
            ei.e = cv_expr(a, sx_kid(en, 1));
            SX* sg = sx_kid(en, 2);
            mut u64 j = 0;
            while (j < vlen(sg.kids)) {
                ei.s = vpush(ei.s, cv_stmt(a, sx_kid(sg, j)) as u8*);
                j = j + 1;
            }
            ei.t = cv_opt_expr(a, sx_kid(en, 3));
            st.eifs = vpush(st.eifs, ei as u8*);
            i = i + 1;
        }
        SX* el = sx_kid(s, 6);
        if (!el.is_int) {
            st.has_els = true;
            SX* sg = sx_kid(el, 1);
            mut u64 j = 0;
            while (j < vlen(sg.kids)) {
                st.els = vpush(st.els, cv_stmt(a, sx_kid(sg, j)) as u8*);
                j = j + 1;
            }
            st.els_t = cv_opt_expr(a, sx_kid(el, 2));
        }
    } else if (st.kind == X_ST_WHILE) {
        st.cond = cv_expr(a, sx_kid(s, 1));
        st.cond_ex = cv_expr(a, sx_kid(s, 2));
        SX* tg = sx_kid(s, 3);
        mut u64 i = 0;
        while (i < vlen(tg.kids)) {
            st.then_s = vpush(st.then_s, cv_stmt(a, sx_kid(tg, i)) as u8*);
            i = i + 1;
        }
        st.then_t = cv_opt_expr(a, sx_kid(s, 4));
    } else if (st.kind == X_ST_FOR_C) {
        SX* init = sx_kid(s, 1);
        if (!init.is_int) {
            SX* k0 = sx_kid(init, 0);
            if (sx_eq(k0, "d", 1)) {
                st.for_init_decl = cv_stmt(a, sx_kid(init, 1));
                st.for_init_is_decl = true;
            } else {
                st.for_init_simple = cv_stmt(a, sx_kid(init, 1));
            }
        }
        st.for_cond = cv_opt_expr(a, sx_kid(s, 2));
        if (st.for_cond != null) {
            st.has_for_cond = true;
        }
        SX* inc = sx_kid(s, 3);
        if (!inc.is_int) {
            st.for_incr = cv_stmt(a, inc);
            st.has_incr = true;
        }
        SX* tg = sx_kid(s, 4);
        mut u64 i = 0;
        while (i < vlen(tg.kids)) {
            st.then_s = vpush(st.then_s, cv_stmt(a, sx_kid(tg, i)) as u8*);
            i = i + 1;
        }
        st.then_t = cv_opt_expr(a, sx_kid(s, 5));
    } else if (st.kind == X_ST_RETURN) {
        st.ret_e = cv_opt_expr(a, sx_kid(s, 1));
        if (sx_kid(s, 2).ival != 0) {
            st.has_ret = true;
        }
    } else if (st.kind == X_ST_DEFER) {
        if (sx_kid(s, 1).ival != 0) {
            st.defer_is_block = true;
        }
        SX* dg = sx_kid(s, 2);
        mut u64 i = 0;
        while (i < vlen(dg.kids)) {
            st.defer_blk = vpush(st.defer_blk, cv_stmt(a, sx_kid(dg, i)) as u8*);
            i = i + 1;
        }
        SX* ds = sx_kid(s, 3);
        if (!ds.is_int) {
            st.defer_simple = cv_stmt(a, ds);
        }
    } else if (st.kind == X_ST_BREAK || st.kind == X_ST_CONTINUE) {
        SX* lb = sx_kid(s, 1);
        if (!lb.is_int) {
            st.label = sx_nul(a, lb);
        }
    }
    return st;
}

fn cv_item(Arena* a, SX* s) -> Item* {
    mut u8* m = zac(a, 112);
    if (m == null) {
        return null;
    }
    Item* it = m as Item*;
    it.kind = sx_kid(s, 0).ival as i32;
    if (it.kind == X_IT_FN) {
        it.fn_name = sx_nul(a, sx_kid(s, 1));
        SX* pg = sx_kid(s, 2);
        mut u64 i = 0;
        while (i < vlen(pg.kids)) {
            SX* pr = sx_kid(pg, i);
            u8* pm = zac(a, 24);
            Param* pp = pm as Param*;
            if (sx_kid(pr, 0).ival != 0) {
                pp.is_mut = true;
            }
            pp.ty = cv_type(a, sx_kid(pr, 1));
            pp.nm = sx_nul(a, sx_kid(pr, 2));
            it.params = vpush(it.params, pp as u8*);
            i = i + 1;
        }
        it.ret = cv_opt_type(a, sx_kid(s, 3));
        if (sx_kid(s, 4).ival != 0) {
            it.is_proto = true;
        }
        SX* bg = sx_kid(s, 5);
        i = 0;
        while (i < vlen(bg.kids)) {
            it.body = vpush(it.body, cv_stmt(a, sx_kid(bg, i)) as u8*);
            i = i + 1;
        }
        it.trail = cv_opt_expr(a, sx_kid(s, 6));
    } else if (it.kind == X_IT_EXTERN) {
        it.fn_name = sx_nul(a, sx_kid(s, 2));
        SX* pg = sx_kid(s, 3);
        mut u64 i = 0;
        while (i < vlen(pg.kids)) {
            SX* pr = sx_kid(pg, i);
            u8* pm = zac(a, 24);
            Param* pp = pm as Param*;
            if (sx_kid(pr, 0).ival != 0) {
                pp.is_mut = true;
            }
            pp.ty = cv_type(a, sx_kid(pr, 1));
            pp.nm = sx_nul(a, sx_kid(pr, 2));
            it.params = vpush(it.params, pp as u8*);
            i = i + 1;
        }
        it.ret = cv_opt_type(a, sx_kid(s, 4));
    } else if (it.kind == X_IT_STRUCT) {
        it.sname = sx_nul(a, sx_kid(s, 1));
        SX* fg = sx_kid(s, 2);
        mut u64 i = 0;
        while (i < vlen(fg.kids)) {
            SX* fe = sx_kid(fg, i);
            u8* fm = zac(a, 16);
            SFld* ff = fm as SFld*;
            ff.ty = cv_type(a, sx_kid(fe, 3));
            ff.nm = sx_nul(a, sx_kid(fe, 4));
            it.fields = vpush(it.fields, ff as u8*);
            i = i + 1;
        }
    } else if (it.kind == X_IT_ENUM) {
        it.ename = sx_nul(a, sx_kid(s, 1));
        SX* vg = sx_kid(s, 2);
        mut u64 i = 0;
        while (i < vlen(vg.kids)) {
            SX* vn = sx_kid(vg, i);
            u8* vm = zac(a, 64);
            mut Variant* vv = vm as Variant*;
            vv.vn = sx_nul(a, sx_kid(vn, 0));
            if (sx_kid(vn, 1).ival != 0) {
                vv.has_tuple = true;
            }
            if (sx_kid(vn, 2).ival != 0) {
                vv.has_struct = true;
            }
            if (sx_kid(vn, 3).ival != 0) {
                vv.has_disc = true;
            }
            SX* tg = sx_kid(vn, 4);
            mut u64 j = 0;
            while (j < vlen(tg.kids)) {
                vv.ts = vpush(vv.ts, cv_type(a, sx_kid(tg, j)) as u8*);
                j = j + 1;
            }
            SX* sg = sx_kid(vn, 5);
            j = 0;
            while (j < vlen(sg.kids)) {
                SX* fe = sx_kid(sg, j);
                u8* fm = zac(a, 16);
                SFld* vf = fm as SFld*;
                vf.ty = cv_type(a, sx_kid(fe, 0));
                vf.nm = sx_nul(a, sx_kid(fe, 1));
                vv.fs = vpush(vv.fs, vf as u8*);
                j = j + 1;
            }
            vv.disc = cv_opt_expr(a, sx_kid(vn, 6));
            it.vars = vpush(it.vars, vv as u8*);
            i = i + 1;
        }
    } else if (it.kind == X_IT_GLOBAL) {
        mut Stmt* d = null;
        mut u8* dm = zac(a, 296);
        d = dm as Stmt*;
        d.kind = X_ST_DECL;
        if (sx_kid(s, 1).ival != 0) {
            d.is_mut = true;
        }
        d.ty = cv_type(a, sx_kid(s, 2));
        d.names = vpush(d.names, sx_nul(a, sx_kid(s, 3)) as u8*);
        d.inits = vpush(d.inits, cv_expr(a, sx_kid(s, 4)) as u8*);
        it.gdecl = d;
    }
    return it;
}

fn cv_opt_type(Arena* a, SX* s) -> Type* {
    if (s.is_int) {
        return null;
    }
    return cv_type(a, s);
}

fn cv_program(Arena* a, SX* root) -> Vec* {
    mut Vec* items = vec_new();
    mut u64 i = 1;
    while (i < vlen(root.kids)) {
        items = vpush(items, cv_item(a, sx_kid(root, i)) as u8*);
        i = i + 1;
    }
    return items;
}

i32 Q_I8 = 0;
i32 Q_I16 = 1;
i32 Q_I32 = 2;
i32 Q_I64 = 3;
i32 Q_U8 = 4;
i32 Q_U16 = 5;
i32 Q_U32 = 6;
i32 Q_U64 = 7;
i32 Q_BOOL = 8;
i32 Q_CHAR = 9;
i32 Q_F32 = 10;
i32 Q_F64 = 11;
i32 Q_PTR = 12;
i32 Q_STRUCT = 13;
i32 Q_VOID = 14;

mut Buf* g_o = null;
mut Arena* g_ar = null;
mut i32 g_lbl = 0;
mut u64 g_failed = 0;
mut u64 g_lkmode = 0;

fn xerr(char* msg) {
    tk_eprint("x64 error: " as u8*, 11);
    tk_eprint(msg as u8*, tk_strlen(msg));
    tk_eprint("\n" as u8*, 1);
    g_failed = 1;
    return;
}

fn new_lbl() -> i32 {
    i32 l = g_lbl;
    g_lbl = g_lbl + 1;
    return l;
}

fn align_up(i32 v, i32 a) -> i32 {
    return (v + a - 1) & (0 - a);
}


struct XSRow { char* nm, Type* ty, i32 off, }
struct XS { char* name, Vec* fields, i32 size, i32 align, }
struct XEV { char* vn, i32 kind, Vec* ts, Vec* fs, i32 disc, }
struct XEF { char* nm, Type* ty, }
struct XE { char* name, bool payload, Vec* vars, }
struct XF { char* name, Type* ret, Vec* pt, Vec* pnm, bool is_ext, }

mut Vec* g_xss = null;
mut Vec* g_xes = null;
mut Vec* g_xfs = null;

fn xfind_s(char* nm) -> XS* {
    mut u64 i = 0;
    while (i < vlen(g_xss)) {
        XS* s = vec_get(g_xss, i) as XS*;
        if (tk_streq(s.name, nm)) {
            return s;
        }
        i = i + 1;
    }
    return null;
}

fn xfind_e(char* nm) -> XE* {
    mut u64 i = 0;
    while (i < vlen(g_xes)) {
        XE* e = vec_get(g_xes, i) as XE*;
        if (tk_streq(e.name, nm)) {
            return e;
        }
        i = i + 1;
    }
    return null;
}

fn xfind_f(char* nm) -> XF* {
    mut u64 i = 0;
    while (i < vlen(g_xfs)) {
        XF* f = vec_get(g_xfs, i) as XF*;
        if (tk_streq(f.name, nm)) {
            return f;
        }
        i = i + 1;
    }
    return null;
}

fn xfind_v(XE* e, char* vn) -> i32 {
    mut u64 i = 0;
    while (i < vlen(e.vars)) {
        XEV* v = vec_get(e.vars, i) as XEV*;
        if (tk_streq(v.vn, vn)) {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

fn slots_for_size(i32 b) -> i32 {
    return (b + 7) / 8;
}

fn ty_align(Type* t) -> i32 {
    if (t == null) {
        return 8;
    }
    if (t.stars > 0 || t.is_ref) {
        return 8;
    }
    if (t.kind == X_TY_PRIM) {
        if (t.prim == K_I8 || t.prim == K_U8 || t.prim == K_BOOL || t.prim == K_CHAR_TY) {
            return 1;
        }
        if (t.prim == K_I16 || t.prim == K_U16) {
            return 2;
        }
        if (t.prim == K_I32 || t.prim == K_U32 || t.prim == K_F32) {
            return 4;
        }
        return 8;
    }
    if (t.kind == X_TY_PATH) {
        if (vlen(t.path) == 1) {
            char* s0 = vec_get(t.path, 0) as char*;
            if (tk_streq(s0, "List") && vlen(t.gargs) == 1) {
                return 8;
            }
            XS* s = xfind_s(s0);
            if (s != null) {
                return s.align;
            }
            XE* e = xfind_e(s0);
            if (e != null && !e.payload) {
                return 4;
            }
        }
        return 8;
    }
    if (t.kind == X_TY_ARRAY) {
        return ty_align(t.elem);
    }
    if (t.kind == X_TY_TUPLE) {
        mut i32 al = 1;
        mut u64 i = 0;
        while (i < vlen(t.elems)) {
            i32 a = ty_align(vec_get(t.elems, i) as Type*);
            if (a > al) {
                al = a;
            }
            i = i + 1;
        }
        return al;
    }
    return 8;
}

fn ty_size(Type* t) -> i32 {
    if (t == null) {
        return 8;
    }
    if (t.stars > 0 || t.is_ref) {
        return 8;
    }
    if (t.kind == X_TY_PRIM) {
        if (t.prim == K_I8 || t.prim == K_U8 || t.prim == K_BOOL || t.prim == K_CHAR_TY) {
            return 1;
        }
        if (t.prim == K_I16 || t.prim == K_U16) {
            return 2;
        }
        if (t.prim == K_I32 || t.prim == K_U32 || t.prim == K_F32) {
            return 4;
        }
        if (t.prim == K_SVIEW) {
            return 16;
        }
        return 8;
    }
    if (t.kind == X_TY_AUTO) {
        return 8;
    }
    if (t.kind == X_TY_PATH) {
        if (vlen(t.path) == 1) {
            char* s0 = vec_get(t.path, 0) as char*;
            if (tk_streq(s0, "List") && vlen(t.gargs) == 1) {
                return 24;
            }
            XS* s = xfind_s(s0);
            if (s != null) {
                return s.size;
            }
            XE* e = xfind_e(s0);
            if (e != null) {
                if (!e.payload) {
                    return 4;
                }
                return enum_value_bytes(e);
            }
        }
        return 8;
    }
    if (t.kind == X_TY_TUPLE) {
        mut i32 off = 0;
        mut i32 al = 1;
        mut u64 i = 0;
        while (i < vlen(t.elems)) {
            Type* et = vec_get(t.elems, i) as Type*;
            i32 a = ty_align(et);
            if (a > al) {
                al = a;
            }
            off = align_up(off, a) + ty_size(et);
            i = i + 1;
        }
        return align_up(off, al);
    }
    if (t.kind == X_TY_ARRAY) {
        return 4 * ty_size(t.elem);
    }
    return 8;
}


fn variant_member_bytes(XE* en, i32 vi) -> i32 {
    mut XEV* vv = vec_get(en.vars, vi as u64) as XEV*;
    mut i32 off = 0;
    mut i32 al = 1;
    if (vv.kind == 1) {
        mut u64 k = 0;
        while (k < vlen(vv.ts)) {
            mut Type* ft = vec_get(vv.ts, k) as Type*;
            i32 a = ty_align(ft);
            if (a > al) {
                al = a;
            }
            off = align_up(off, a) + ty_size(ft);
            k = k + 1;
        }
    } else if (vv.kind == 2) {
        mut u64 k = 0;
        while (k < vlen(vv.fs)) {
            XEF* vf = vec_get(vv.fs, k) as XEF*;
            i32 a = ty_align(vf.ty);
            if (a > al) {
                al = a;
            }
            off = align_up(off, a) + ty_size(vf.ty);
            k = k + 1;
        }
    }
    return align_up(off, al);
}

fn enum_value_bytes(XE* en) -> i32 {
    mut i32 mx = 0;
    mut u64 k = 0;
    while (k < vlen(en.vars)) {
        i32 s2 = variant_member_bytes(en, k as i32);
        if (s2 > mx) {
            mx = s2;
        }
        k = k + 1;
    }
    return align_up(8 + mx, 8);
}

fn enum_slots(XE* en) -> i32 {
    return slots_for_size(enum_value_bytes(en));
}

fn tuple_field_off(XE* en, i32 vi, i32 i) -> i32 {
    mut XEV* vv = vec_get(en.vars, vi as u64) as XEV*;
    mut i32 off = 0;
    mut i32 k = 0;
    while (k <= i) {
        mut Type* ft = vec_get(vv.ts, k as u64) as Type*;
        off = align_up(off, ty_align(ft));
        if (k == i) {
            return 8 + off;
        }
        off = off + ty_size(ft);
        k = k + 1;
    }
    return 8;
}

fn struct_field_off(XE* en, i32 vi, char* nm) -> i32 {
    mut XEV* vv = vec_get(en.vars, vi as u64) as XEV*;
    mut i32 off = 0;
    mut u64 k = 0;
    while (k < vlen(vv.fs)) {
        XEF* vf = vec_get(vv.fs, k) as XEF*;
        off = align_up(off, ty_align(vf.ty));
        if (tk_streq(vf.nm, nm)) {
            return 8 + off;
        }
        off = off + ty_size(vf.ty);
        k = k + 1;
    }
    xerr("unknown variant field");
    return 8;
}

fn ty_width(Type* t) -> i32 {
    if (t == null) {
        return Q_VOID;
    }
    if (t.stars > 0 || t.is_ref) {
        return Q_PTR;
    }
    if (t.kind == X_TY_PRIM) {
        if (t.prim == K_I8) { return Q_I8; }
        if (t.prim == K_I16) { return Q_I16; }
        if (t.prim == K_I32) { return Q_I32; }
        if (t.prim == K_I64) { return Q_I64; }
        if (t.prim == K_U8) { return Q_U8; }
        if (t.prim == K_U16) { return Q_U16; }
        if (t.prim == K_U32) { return Q_U32; }
        if (t.prim == K_U64) { return Q_U64; }
        if (t.prim == K_BOOL) { return Q_BOOL; }
        if (t.prim == K_CHAR_TY) { return Q_CHAR; }
        if (t.prim == K_F32) { return Q_F32; }
        if (t.prim == K_F64) { return Q_F64; }
        if (t.prim == K_SVIEW) { return Q_STRUCT; }
        return Q_I64;
    }
    if (t.kind == X_TY_PATH && vlen(t.path) == 1) {
        char* s0 = vec_get(t.path, 0) as char*;
        if (tk_streq(s0, "List") && vlen(t.gargs) == 1) {
            return Q_STRUCT;
        }
        XS* s = xfind_s(s0);
        if (s != null) {
            return Q_STRUCT;
        }
        XE* e = xfind_e(s0);
        if (e != null) {
            if (e.payload) {
                return Q_STRUCT;
            }
            return Q_I32;
        }
    }
    if (t.kind == X_TY_ARRAY || t.kind == X_TY_TUPLE) {
        return Q_STRUCT;
    }
    return Q_I64;
}

struct XV { char* name, Type* ty, i32 slot, i32 depth, }
mut Vec* g_xvs = null;
mut i32 g_xvn = 0;
mut i32 g_xvdepth = 0;
mut i32 g_xvbase = 0;
mut i32 g_frameslots = 0;

fn xv_add(char* name, Type* ty, mut i32 slots) {
    if (slots < 1) {
        slots = 1;
    }
    mut XV* v = null as XV*;
    if (g_xvn < vlen(g_xvs) as i32) {
        v = vec_get(g_xvs, g_xvn as u64) as XV*;
    } else {
        u8* m = tk_malloc(24);
        v = m as XV*;
        g_xvs = vpush(g_xvs, v as u8*);
    }
    v.name = name;
    v.ty = ty;
    v.slot = g_frameslots + slots - 1;
    v.depth = g_xvdepth;
    g_xvn = g_xvn + 1;
    g_frameslots = g_frameslots + slots;
    return;
}

fn xv_find(char* nm) -> XV* {
    mut i32 i = g_xvn - 1;
    while (i >= 0) {
        XV* v = vec_get(g_xvs, i as u64) as XV*;
        if (tk_streq(v.name, nm)) {
            return v;
        }
        i = i - 1;
    }
    return null;
}

fn xv_push() {
    g_xvdepth = g_xvdepth + 1;
    return;
}

fn xv_pop() {
    g_xvdepth = g_xvdepth - 1;
    while (g_xvn > g_xvbase) {
        XV* v = vec_get(g_xvs, (g_xvn - 1) as u64) as XV*;
        if (v.depth > g_xvdepth) {
            g_xvn = g_xvn - 1;
        } else {
            break;
        }
    }
    return;
}

fn tmp_slot(i32 slots) -> i32 {
    i32 s = g_frameslots;
    g_frameslots = g_frameslots + slots;
    return s;
}

struct XT { u64 node, i32 slot, }
mut Vec* g_xts = null;

fn tmp_for(u64 node, mut i32 slots) -> i32 {
    mut u64 i = 0;
    while (i < vlen(g_xts)) {
        XT* x = vec_get(g_xts, i) as XT*;
        if (x.node == node) {
            return x.slot;
        }
        i = i + 1;
    }
    if (slots < 1) {
        slots = 1;
    }
    i32 s = g_frameslots + slots - 1;
    g_frameslots = g_frameslots + slots;
    mut u8* m = tk_malloc(16);
    XT* x = m as XT*;
    x.node = node;
    x.slot = s;
    g_xts = vpush(g_xts, x as u8*);
    return s;
}

fn tmp_find(u64 node) -> i32 {
    mut u64 i = 0;
    while (i < vlen(g_xts)) {
        XT* x = vec_get(g_xts, i) as XT*;
        if (x.node == node) {
            return x.slot;
        }
        i = i + 1;
    }
    return -1;
}

fn abi_map(char* nm) -> char* {
    if (tk_streq(nm, "tk_malloc")) { return "malloc"; }
    if (tk_streq(nm, "tk_free")) { return "free"; }
    if (tk_streq(nm, "tk_fopen")) { return "fopen"; }
    if (tk_streq(nm, "tk_fclose")) { return "fclose"; }
    if (tk_streq(nm, "tk_fseek")) { return "fseek"; }
    if (tk_streq(nm, "tk_ftell")) { return "ftell"; }
    if (tk_streq(nm, "tk_fread")) { return "fread"; }
    if (tk_streq(nm, "tk_fwrite")) { return "fwrite"; }
    if (tk_streq(nm, "tk_strlen")) { return "strlen"; }
    if (tk_streq(nm, "tk_streq")) { return "strcmp"; }
    if (tk_streq(nm, "tk_system")) { return "system"; }
    if (tk_streq(nm, "tk_eprint")) { return "tk_eprint_rt"; }
    return nm;
}

fn is_print_like(char* nm) -> bool {
    if (tk_streq(nm, "tk_print_i32")) { return true; }
    if (tk_streq(nm, "tk_print_str")) { return true; }
    if (tk_streq(nm, "tk_effect_stub")) { return true; }
    return false;
}

mut Vec* g_rod = null;

fn rod_add(u8* s, u64 n) -> i32 {
    mut u64 i = 0;
    while (i < vlen(g_rod)) {
        char* e = vec_get(g_rod, i) as char*;
        if (tk_strlen(e) == n) {
            u8* eb = e as u8*;
            mut bool same = true;
            mut u64 j = 0;
            while (j < n) {
                if (eb[j] != s[j]) {
                    same = false;
                    break;
                }
                j = j + 1;
            }
            if (same) {
                return i as i32;
            }
        }
        i = i + 1;
    }
    mut u8* m = arena_alloc(g_ar, n + 1);
    mut u64 j = 0;
    while (j < n) {
        m[j] = s[j];
        j = j + 1;
    }
    m[n] = 0;
    g_rod = vpush(g_rod, m);
    return (vlen(g_rod) as i32) - 1;
}


fn emit_asciz(u8* s, u64 n) {
    buf_putc(g_o, 34);
    mut u64 i = 0;
    while (i < n) {
        u8 c = s[i];
        if (c == 92 && i + 1 < n) {
            i = i + 1;
            u8 e = s[i];
            if (e == 110) {
                buf_puts_c(g_o, "\\n");
            } else if (e == 116) {
                buf_puts_c(g_o, "\\t");
            } else if (e == 114) {
                buf_puts_c(g_o, "\\r");
            } else if (e == 48) {
                buf_puts_c(g_o, "\\0");
            } else if (e == 92) {
                buf_puts_c(g_o, "\\\\");
            } else if (e == 39) {
                buf_puts_c(g_o, "\\'");
            } else if (e == 34) {
                buf_puts_c(g_o, "\\\"");
            } else if (e == 120) {
                mut u64 v = 0;
                mut u64 k = 0;
                while (k < 2 && i + 1 < n) {
                    u8 h = s[i + 1];
                    mut i64 d = -1;
                    if (h >= 48 && h <= 57) {
                        d = (h - 48) as i64;
                    } else if (h >= 97 && h <= 102) {
                        d = (h - 87) as i64;
                    } else if (h >= 65 && h <= 70) {
                        d = (h - 55) as i64;
                    }
                    if (d < 0) {
                        break;
                    }
                    v = v * 16 + d as u64;
                    i = i + 1;
                    k = k + 1;
                }
                buf_puts_c(g_o, "\\x");
                buf_putx(g_o, v);
            } else {
                buf_putc(g_o, e);
            }
        } else if (c == 34) {
            buf_puts_c(g_o, "\\\"");
        } else if (c == 10) {
            buf_puts_c(g_o, "\\n");
        } else if (c >= 32 && c < 127) {
            buf_putc(g_o, c);
        } else {
            buf_putc(g_o, 92);
            buf_puto3(g_o, c as u64);
        }
        i = i + 1;
    }
    buf_putc(g_o, 34);
    return;
}

fn xnew_prim(i32 p) -> Type* {
    mut u8* m = zac(g_ar, 64);
    if (m == null) {
        return null;
    }
    Type* t = m as Type*;
    t.kind = X_TY_PRIM;
    t.prim = p;
    return t;
}

fn xnew_path1(char* seg) -> Type* {
    mut u8* m = zac(g_ar, 64);
    if (m == null) {
        return null;
    }
    Type* t = m as Type*;
    t.kind = X_TY_PATH;
    t.path = vpush(t.path, seg as u8*);
    return t;
}

fn to_width(i32 from, i32 to) {
    if (from == to) {
        return;
    }
    bool from_f = from == Q_F32 || from == Q_F64;
    bool to_f = to == Q_F32 || to == Q_F64;
    if (!from_f && !to_f) {
        if (to == Q_I8 || to == Q_CHAR) {
            buf_puts_c(g_o, "    movsbq %al, %rax\n");
        } else if (to == Q_U8 || to == Q_BOOL) {
            buf_puts_c(g_o, "    movzbq %al, %rax\n");
        } else if (to == Q_I16) {
            buf_puts_c(g_o, "    movswq %ax, %rax\n");
        } else if (to == Q_U16) {
            buf_puts_c(g_o, "    movzwq %ax, %rax\n");
        } else if (to == Q_I32) {
            buf_puts_c(g_o, "    movslq %eax, %rax\n");
        } else if (to == Q_U32) {
            buf_puts_c(g_o, "    movl %eax, %eax\n");
        }
        return;
    }
    if (!from_f && to_f) {
        if (from == Q_I8 || from == Q_CHAR) {
            buf_puts_c(g_o, "    movsbl %al, %eax\n");
        } else if (from == Q_U8 || from == Q_BOOL) {
            buf_puts_c(g_o, "    movzbl %al, %eax\n");
        } else if (from == Q_I16) {
            buf_puts_c(g_o, "    movswl %ax, %eax\n");
        } else if (from == Q_U16) {
            buf_puts_c(g_o, "    movzwl %ax, %eax\n");
        }
        bool w64 = from == Q_I64 || from == Q_U64 || from == Q_PTR;
        if (to == Q_F32) {
            if (w64) {
                buf_puts_c(g_o, "    cvtsi2ss %rax, %xmm0\n");
            } else {
                buf_puts_c(g_o, "    cvtsi2ss %eax, %xmm0\n");
            }
        } else {
            if (w64) {
                buf_puts_c(g_o, "    cvtsi2sd %rax, %xmm0\n");
            } else {
                buf_puts_c(g_o, "    cvtsi2sd %eax, %xmm0\n");
            }
        }
        return;
    }
    if (from_f && !to_f) {
        if (from == Q_F32) {
            buf_puts_c(g_o, "    cvttss2si %xmm0, %eax\n");
        } else {
            buf_puts_c(g_o, "    cvttsd2si %xmm0, %eax\n");
        }
        if (to == Q_I64 || to == Q_U64 || to == Q_PTR) {
            if (from == Q_F32) {
                buf_puts_c(g_o, "    cvttss2si %xmm0, %rax\n");
            } else {
                buf_puts_c(g_o, "    cvttsd2si %xmm0, %rax\n");
            }
        } else if (to != Q_I32 && to != Q_U32) {
            if (from == Q_F32) {
                buf_puts_c(g_o, "    cvttss2si %xmm0, %eax\n");
            } else {
                buf_puts_c(g_o, "    cvttsd2si %xmm0, %eax\n");
            }
        }
        return;
    }
    if (from == Q_F32 && to == Q_F64) {
        buf_puts_c(g_o, "    cvtss2sd %xmm0, %xmm0\n");
    } else if (from == Q_F64 && to == Q_F32) {
        buf_puts_c(g_o, "    cvtsd2ss %xmm0, %xmm0\n");
    }
    return;
}

fn load_mem(char* mem, i32 w) {
    if (w == Q_I8 || w == Q_CHAR) {
        buf_puts_c(g_o, "    movsbq ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %rax\n");
    } else if (w == Q_U8 || w == Q_BOOL) {
        buf_puts_c(g_o, "    movzbq ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %rax\n");
    } else if (w == Q_I16) {
        buf_puts_c(g_o, "    movswq ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %rax\n");
    } else if (w == Q_U16) {
        buf_puts_c(g_o, "    movzwq ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %rax\n");
    } else if (w == Q_I32) {
        buf_puts_c(g_o, "    movslq ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %rax\n");
    } else if (w == Q_U32) {
        buf_puts_c(g_o, "    movl ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %eax\n");
    } else if (w == Q_I64 || w == Q_U64 || w == Q_PTR) {
        buf_puts_c(g_o, "    movq ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %rax\n");
    } else if (w == Q_F32) {
        buf_puts_c(g_o, "    movss ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %xmm0\n");
    } else if (w == Q_F64) {
        buf_puts_c(g_o, "    movsd ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %xmm0\n");
    } else {
        buf_puts_c(g_o, "    movq ");
        buf_puts_c(g_o, mem);
        buf_puts_c(g_o, ", %rax\n");
    }
    return;
}

fn store_mem(char* mem, i32 w) {
    if (w == Q_I8 || w == Q_U8 || w == Q_BOOL || w == Q_CHAR) {
        buf_puts_c(g_o, "    movb %al, ");
        buf_puts_c(g_o, mem);
        buf_putc(g_o, 10);
    } else if (w == Q_I16 || w == Q_U16) {
        buf_puts_c(g_o, "    movw %ax, ");
        buf_puts_c(g_o, mem);
        buf_putc(g_o, 10);
    } else if (w == Q_I32 || w == Q_U32) {
        buf_puts_c(g_o, "    movl %eax, ");
        buf_puts_c(g_o, mem);
        buf_putc(g_o, 10);
    } else if (w == Q_I64 || w == Q_U64 || w == Q_PTR) {
        buf_puts_c(g_o, "    movq %rax, ");
        buf_puts_c(g_o, mem);
        buf_putc(g_o, 10);
    } else if (w == Q_F32) {
        buf_puts_c(g_o, "    movss %xmm0, ");
        buf_puts_c(g_o, mem);
        buf_putc(g_o, 10);
    } else if (w == Q_F64) {
        buf_puts_c(g_o, "    movsd %xmm0, ");
        buf_puts_c(g_o, mem);
        buf_putc(g_o, 10);
    } else {
        buf_puts_c(g_o, "    movq %rax, ");
        buf_puts_c(g_o, mem);
        buf_putc(g_o, 10);
    }
    return;
}

fn slot_str(i32 slot, char* nm) -> char* {
    if (slot < 0) {
        u64 nl = tk_strlen(nm);
        mut u8* m = arena_alloc(g_ar, nl + 7);
        mut u64 i = 0;
        while (i < nl) {
            m[i] = nm[i];
            i = i + 1;
        }
        m[nl] = 40;
        m[nl + 1] = 37;
        m[nl + 2] = 114;
        m[nl + 3] = 105;
        m[nl + 4] = 112;
        m[nl + 5] = 41;
        m[nl + 6] = 0;
        return m as char*;
    }
    i32 v = 0 - 8 * (slot + 1);
    sview s = i32_to_str(v, g_ar);
    mut u8* m = arena_alloc(g_ar, s.len as u64 + 7);
    mut u64 i = 0;
    while (i < s.len as u64) {
        m[i] = s.ptr[i];
        i = i + 1;
    }
    m[s.len as u64] = 40;
    m[s.len as u64 + 1] = 37;
    m[s.len as u64 + 2] = 114;
    m[s.len as u64 + 3] = 98;
    m[s.len as u64 + 4] = 112;
    m[s.len as u64 + 5] = 41;
    m[s.len as u64 + 6] = 0;
    return m as char*;
}

fn emit_memcpy(i32 b) {
    buf_puts_c(g_o, "    movl $");
    buf_puti(g_o, b);
    buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
    return;
}

fn prim_rank(i32 k) -> i32 {
    if (k == K_F64) { return 60; }
    if (k == K_F32) { return 50; }
    if (k == K_U64) { return 44; }
    if (k == K_I64) { return 43; }
    if (k == K_U32) { return 42; }
    if (k == K_I32) { return 41; }
    if (k == K_U16) { return 32; }
    if (k == K_I16) { return 31; }
    if (k == K_U8) { return 22; }
    if (k == K_I8) { return 21; }
    if (k == K_BOOL) { return 10; }
    if (k == K_CHAR_TY) { return 11; }
    return 0;
}


fn emit_var_addr(XV* v) {
    if (v.slot < 0) {
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, v.name);
        buf_puts_c(g_o, "(%rip), %rax\n");
        return;
    }
    buf_puts_c(g_o, "    leaq ");
    buf_puts_c(g_o, slot_str(v.slot, v.name));
    buf_puts_c(g_o, ", %rax\n");
    return;
}

fn emit_var_load(XV* v, i32 w) {
    if (v.slot < 0) {
        mut char* m = slot_str(-1, v.name);
        load_mem(m, w);
        return;
    }
    load_mem(slot_str(v.slot, v.name), w);
    return;
}

fn xv_add_global(char* name, Type* ty) {
    mut u8* m = tk_malloc(24);
    XV* v = m as XV*;
    v.name = name;
    v.ty = ty;
    v.slot = -1;
    v.depth = 0;
    g_xvs = vpush(g_xvs, v as u8*);
    g_xvn = g_xvn + 1;
    return;
}

fn field_offset(Type* bt, char* field) -> i32 {
    if (bt == null) {
        xerr("field of unknown type");
        return 0;
    }
    if (bt.kind == X_TY_PRIM && bt.prim == K_SVIEW) {
        if (tk_streq(field, "ptr")) {
            return 0;
        }
        if (tk_streq(field, "len")) {
            return 8;
        }
        xerr("unknown sview field");
        return 0;
    }
    if (bt.kind == X_TY_PATH && vlen(bt.path) == 1) {
        char* s0 = vec_get(bt.path, 0) as char*;
        if (tk_streq(s0, "List") && vlen(bt.gargs) == 1) {
            if (tk_streq(field, "data")) {
                return 0;
            }
            if (tk_streq(field, "len")) {
                return 8;
            }
            if (tk_streq(field, "cap")) {
                return 16;
            }
            xerr("unknown List field");
            return 0;
        }
        XS* st = xfind_s(s0);
        if (st != null) {
            mut i32 off = 0;
            mut u64 i = 0;
            while (i < vlen(st.fields)) {
                XSRow* fr = vec_get(st.fields, i) as XSRow*;
                i32 a = ty_align(fr.ty);
                off = align_up(off, a);
                if (tk_streq(fr.nm, field)) {
                    return off;
                }
                off = off + ty_size(fr.ty);
                i = i + 1;
            }
        }
    }
    xerr("unknown struct field");
    return 0;
}

fn const_int_ok(Expr* e) -> bool {
    if (e == null) {
        return false;
    }
    if (e.kind == X_EX_INT) {
        return true;
    }
    if (e.kind == X_EX_PAREN) {
        return const_int_ok(e.lhs);
    }
    if (e.kind == X_EX_UNARY && (e.op == K_MINUS || e.op == K_PLUS)) {
        return const_int_ok(e.lhs);
    }
    if (e.kind == X_EX_BINARY) {
        if (!const_int_ok(e.lhs) || !const_int_ok(e.rhs)) {
            return false;
        }
        if (e.op == K_PLUS || e.op == K_MINUS || e.op == K_STAR) {
            return true;
        }
        return false;
    }
    return false;
}

fn const_int_val(Expr* e) -> i32 {
    if (e.kind == X_EX_INT) {
        return lit_int_bits(e.tstart, e.tlen) as i32;
    }
    if (e.kind == X_EX_PAREN) {
        return const_int_val(e.lhs);
    }
    if (e.kind == X_EX_UNARY) {
        i32 v = const_int_val(e.lhs);
        if (e.op == K_MINUS) {
            return 0 - v;
        }
        return v;
    }
    i32 l = const_int_val(e.lhs);
    i32 r = const_int_val(e.rhs);
    if (e.op == K_PLUS) {
        return l + r;
    }
    if (e.op == K_MINUS) {
        return l - r;
    }
    return l * r;
}

struct WT { char* name, Type* ty, i32 depth, }
mut Vec* g_wts = null;
mut i32 g_wtdepth = 0;

fn wt_add(char* name, Type* ty) {
    mut u8* m = tk_malloc(24);
    mut WT* w = m as WT*;
    w.name = name;
    w.ty = ty;
    w.depth = g_wtdepth;
    g_wts = vpush(g_wts, w as u8*);
    return;
}

fn wt_find(char* name) -> Type* {
    mut i32 i = vlen(g_wts) as i32 - 1;
    while (i >= 0) {
        mut WT* w = vec_get(g_wts, i as u64) as WT*;
        if (tk_streq(w.name, name)) {
            return w.ty;
        }
        i = i - 1;
    }
    return null;
}

fn lookup_xv(char* nm) -> Type* {
    XV* v = xv_find(nm);
    if (v == null) {
        return null;
    }
    return v.ty;
}

fn xlookup(char* nm) -> Type* {
    if (g_lkmode == 0) {
        return wt_find(nm);
    }
    return lookup_xv(nm);
}

fn xtype_eq(Type* a, Type* b) -> bool {
    if (a == b) {
        return true;
    }
    if (a == null || b == null) {
        return false;
    }
    if (a.kind != b.kind) {
        return false;
    }
    if (a.stars != b.stars) {
        return false;
    }
    if (a.is_ref != b.is_ref) {
        return false;
    }
    if (a.kind == X_TY_PRIM) {
        return a.prim == b.prim;
    }
    if (a.kind == X_TY_PATH) {
        if (vlen(a.path) != vlen(b.path)) {
            return false;
        }
        if (vlen(a.gargs) != vlen(b.gargs)) {
            return false;
        }
        mut u64 i = 0;
        while (i < vlen(a.path)) {
            char* x = vec_get(a.path, i) as char*;
            char* y = vec_get(b.path, i) as char*;
            if (!tk_streq(x, y)) {
                return false;
            }
            i = i + 1;
        }
        i = 0;
        while (i < vlen(a.gargs)) {
            if (!xtype_eq(vec_get(a.gargs, i) as Type*, vec_get(b.gargs, i) as Type*)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    return false;
}

mut Vec* g_xlist = null;

fn xcollect_ty(Type* t) {
    if (t == null) {
        return;
    }
    if (t.kind == X_TY_PATH && vlen(t.path) == 1) {
        char* s0 = vec_get(t.path, 0) as char*;
        if (tk_streq(s0, "List") && vlen(t.gargs) == 1) {
            Type* el = vec_get(t.gargs, 0) as Type*;
            mut u64 i = 0;
            while (i < vlen(g_xlist)) {
                if (xtype_eq(vec_get(g_xlist, i) as Type*, el)) {
                    xcollect_ty(el);
                    return;
                }
                i = i + 1;
            }
            g_xlist = vpush(g_xlist, el as u8*);
            xcollect_ty(el);
            return;
        }
    }
    if (t.kind == X_TY_PATH) {
        mut u64 i = 0;
        while (i < vlen(t.gargs)) {
            xcollect_ty(vec_get(t.gargs, i) as Type*);
            i = i + 1;
        }
        return;
    }
    if (t.kind == X_TY_TUPLE) {
        mut u64 i = 0;
        while (i < vlen(t.elems)) {
            xcollect_ty(vec_get(t.elems, i) as Type*);
            i = i + 1;
        }
        return;
    }
    if (t.kind == X_TY_ARRAY) {
        xcollect_ty(t.elem);
        return;
    }
    return;
}


fn tcopy(Type* t) -> Type* {
    mut u8* m = zac(g_ar, 64);
    if (m == null) {
        return null;
    }
    mut Type* n = m as Type*;
    n.kind = t.kind;
    n.is_const = t.is_const;
    n.stars = t.stars;
    n.is_ref = t.is_ref;
    n.prim = t.prim;
    n.path = t.path;
    n.gargs = t.gargs;
    n.elems = t.elems;
    n.elem = t.elem;
    return n;
}

fn tcopy_star(Type* t) -> Type* {
    if (t == null) {
        return null;
    }
    Type* n = tcopy(t);
    if (n == null) {
        return null;
    }
    n.stars = n.stars + 1;
    return n;
}

fn xinfer(Expr* e) -> Type* {
    if (e == null) {
        return null;
    }
    if (e.kind == X_EX_INT) {
        return xnew_prim(K_I32);
    }
    if (e.kind == X_EX_FLOAT) {
        return xnew_prim(K_F64);
    }
    if (e.kind == X_EX_STRING) {
        Type* t = xnew_prim(K_CHAR_TY);
        if (t != null) {
            t.stars = 1;
        }
        return t;
    }
    if (e.kind == X_EX_CHAR) {
        return xnew_prim(K_CHAR_TY);
    }
    if (e.kind == X_EX_BOOL) {
        return xnew_prim(K_BOOL);
    }
    if (e.kind == X_EX_NULL) {
        Type* t = xnew_prim(K_U8);
        if (t != null) {
            t.stars = 1;
        }
        return t;
    }
    if (e.kind == X_EX_VAR) {
        if (vlen(e.path) == 1) {
            return xlookup(vec_get(e.path, 0) as char*);
        }
        if (vlen(e.path) == 2) {
            char* s0 = vec_get(e.path, 0) as char*;
            if (xfind_e(s0) != null) {
                return xnew_path1(s0);
            }
        }
        return null;
    }
    if (e.kind == X_EX_PAREN) {
        return xinfer(e.lhs);
    }
    if (e.kind == X_EX_CAST) {
        return e.cast_to;
    }
    if (e.kind == X_EX_STRUCT_LIT) {
        if (vlen(e.path) == 1) {
            return xnew_path1(vec_get(e.path, 0) as char*);
        }
        if (vlen(e.path) == 2) {
            char* s0 = vec_get(e.path, 0) as char*;
            if (xfind_e(s0) != null) {
                return xnew_path1(s0);
            }
        }
        return null;
    }
    if (e.kind == X_EX_CALL) {
        if (e.callee != null && e.callee.kind == X_EX_VAR && vlen(e.callee.path) == 2) {
            char* s0 = vec_get(e.callee.path, 0) as char*;
            if (xfind_e(s0) != null) {
                return xnew_path1(s0);
            }
        }
        if (e.callee != null && e.callee.kind == X_EX_VAR && vlen(e.callee.path) == 1) {
            char* cn = vec_get(e.callee.path, 0) as char*;
            if (tk_streq(cn, "tk_sview") || tk_streq(cn, "tk_sview_u8")) {
                return xnew_prim(K_SVIEW);
            }
            XF* f = xfind_f(cn);
            if (f != null) {
                return f.ret;
            }
        }
        if (e.callee != null && e.callee.kind == X_EX_FIELD && tk_streq(e.callee.field, "push")) {
            return null;
        }
        return null;
    }
    if (e.kind == X_EX_FIELD) {
        Type* bt = xinfer(e.callee);
        if (bt == null) {
            return null;
        }
        if (bt.kind == X_TY_PRIM && bt.prim == K_SVIEW) {
            if (tk_streq(e.field, "ptr")) {
                Type* t = xnew_prim(K_CHAR_TY);
                if (t != null) {
                    t.stars = 1;
                }
                return t;
            }
            if (tk_streq(e.field, "len")) {
                return xnew_prim(K_I64);
            }
            return null;
        }
        if (bt.kind == X_TY_PATH && vlen(bt.path) == 1) {
            char* s0 = vec_get(bt.path, 0) as char*;
            if (tk_streq(s0, "List") && vlen(bt.gargs) == 1) {
                if (tk_streq(e.field, "data")) {
                    Type* b = tcopy(vec_get(bt.gargs, 0) as Type*);
                    if (b == null) {
                        return null;
                    }
                    b.stars = b.stars + 1;
                    return b;
                }
                if (tk_streq(e.field, "len") || tk_streq(e.field, "cap")) {
                    return xnew_prim(K_U64);
                }
                return null;
            }
            XS* st = xfind_s(s0);
            if (st == null) {
                return null;
            }
            mut u64 i = 0;
            while (i < vlen(st.fields)) {
                XSRow* fr = vec_get(st.fields, i) as XSRow*;
                if (tk_streq(fr.nm, e.field)) {
                    return fr.ty;
                }
                i = i + 1;
            }
            return null;
        }
        return null;
    }
    if (e.kind == X_EX_INDEX) {
        Type* bt = xinfer(e.callee);
        if (bt == null) {
            return null;
        }
        if (bt.kind == X_TY_PATH && vlen(bt.path) == 1) {
            char* s0 = vec_get(bt.path, 0) as char*;
            if (tk_streq(s0, "List") && vlen(bt.gargs) == 1 && bt.stars == 0 && !bt.is_ref) {
                return vec_get(bt.gargs, 0) as Type*;
            }
        }
        if (bt.kind == X_TY_ARRAY) {
            return bt.elem;
        }
        if (bt.stars > 0) {
            Type* t = tcopy(bt);
            if (t == null) {
                return null;
            }
            t.stars = t.stars - 1;
            return t;
        }
        return null;
    }
    if (e.kind == X_EX_UNARY) {
        if (e.op == K_AMP) {
            Type* t = xinfer(e.lhs);
            if (t == null) {
                return null;
            }
            mut Type* n = tcopy(t);
            if (n == null) {
                return null;
            }
            n.stars = n.stars + 1;
            return n;
        }
        if (e.op == K_STAR) {
            Type* t = xinfer(e.lhs);
            if (t != null && t.stars > 0) {
                mut Type* n = tcopy(t);
                if (n == null) {
                    return null;
                }
                n.stars = n.stars - 1;
                return n;
            }
            return null;
        }
        if (e.op == K_BANG) {
            return xnew_prim(K_BOOL);
        }
        return xinfer(e.lhs);
    }
    if (e.kind == X_EX_POST_INC || e.kind == X_EX_POST_DEC) {
        return xinfer(e.lhs);
    }
    if (e.kind == X_EX_BINARY) {
        if (e.op == K_EQEQ || e.op == K_BANGEQ || e.op == K_LT || e.op == K_GT || e.op == K_LTEQ || e.op == K_GTEQ || e.op == K_AMP2 || e.op == K_PIPE2) {
            return xnew_prim(K_BOOL);
        }
        Type* l = xinfer(e.lhs);
        Type* r = xinfer(e.rhs);
        if (l == null || r == null) {
            return null;
        }
        mut bool lp = l.stars > 0 || l.is_ref;
        mut bool rp = r.stars > 0 || r.is_ref;
        if (lp && !rp) {
            return l;
        }
        if (rp && !lp) {
            return r;
        }
        if (l.kind == X_TY_PRIM && r.kind == X_TY_PRIM) {
            mut i32 lw = ty_width(l);
            mut i32 rw = ty_width(r);
            if (lw == Q_F64 || rw == Q_F64) {
                return xnew_prim(K_F64);
            }
            if (lw == Q_F32 || rw == Q_F32) {
                return xnew_prim(K_F32);
            }
            if (r.prim == K_U64 || l.prim == K_U64) {
                return xnew_prim(K_U64);
            }
            return xnew_prim(K_I64);
        }
        return null;
    }
    if (e.kind == X_EX_TERNARY) {
        return xinfer(e.then_e);
    }
    return null;
}

fn xqw(Expr* e) -> i32 {
    Type* t = xinfer(e);
    if (t == null) {
        return Q_I64;
    }
    return ty_width(t);
}


fn emit_addr(Expr* e) {
    if (e == null) {
        xerr("null expr");
        return;
    }
    if (e.kind == X_EX_VAR) {
        if (vlen(e.path) == 1) {
            char* nm = vec_get(e.path, 0) as char*;
            XV* v = xv_find(nm);
            if (v == null) {
                xerr("undefined variable");
                return;
            }
            emit_var_addr(v);
            return;
        }
        xerr("address of non-place");
        return;
    }
    if (e.kind == X_EX_PAREN) {
        emit_addr(e.lhs);
        return;
    }
    if (e.kind == X_EX_UNARY) {
        if (e.op == K_STAR) {
            emit_val(e.lhs);
            return;
        }
        xerr("address of non-place");
        return;
    }
    if (e.kind == X_EX_FIELD) {
        Type* bt = xinfer(e.callee);
        if (bt != null && (bt.stars > 0 || bt.is_ref)) {
            emit_val(e.callee);
        } else {
            emit_addr(e.callee);
        }
        mut i32 off = field_offset(bt, e.field);
        if (off != 0) {
            buf_puts_c(g_o, "    addq $");
            buf_puti(g_o, off);
            buf_puts_c(g_o, ", %rax\n");
        }
        return;
    }
    if (e.kind == X_EX_INDEX) {
        Type* bt = xinfer(e.callee);
        mut bool ok = false;
        if (bt != null) {
            if (bt.stars > 0) {
                ok = true;
            } else if (bt.kind == X_TY_PATH && vlen(bt.path) == 1) {
                char* s0 = vec_get(bt.path, 0) as char*;
                if (tk_streq(s0, "List") && vlen(bt.gargs) == 1) {
                    ok = true;
                }
            } else if (bt.kind == X_TY_ARRAY) {
                ok = true;
            }
        }
        if (!ok) {
            xerr("indexing non-indexable value");
            return;
        }
        Type* et = xinfer(e);
        mut i32 esz = 8;
        if (et != null) {
            esz = ty_size(et);
        }
        if (esz <= 0) {
            esz = 8;
        }
        if (bt != null && (bt.stars > 0 || bt.is_ref)) {
            emit_val(e.callee);
        } else {
            emit_addr(e.callee);
        }
        if (bt != null && bt.kind == X_TY_PATH && vlen(bt.path) == 1) {
            char* s0 = vec_get(bt.path, 0) as char*;
            if (tk_streq(s0, "List") && vlen(bt.gargs) == 1 && bt.stars == 0 && !bt.is_ref) {
                buf_puts_c(g_o, "    movq (%rax), %rax\n");
            }
        }
        buf_puts_c(g_o, "    pushq %rax\n");
        emit_val(e.index);
        i32 iw = xqw(e.index);
        if (iw == Q_F32 || iw == Q_F64) {
            xerr("float index");
            return;
        }
        if (!(iw == Q_U32 || iw == Q_U64 || iw == Q_PTR || iw == Q_BOOL)) {
            buf_puts_c(g_o, "    movslq %eax, %rax\n");
        }
        if (esz != 1) {
            buf_puts_c(g_o, "    imulq $");
            buf_puti(g_o, esz);
            buf_puts_c(g_o, ", %rax\n");
        }
        buf_puts_c(g_o, "    popq %rcx\n");
        buf_puts_c(g_o, "    addq %rcx, %rax\n");
        return;
    }
    if (e.kind == X_EX_STRUCT_LIT || e.kind == X_EX_CALL) {
        emit_val(e);
        return;
    }
    xerr("not addressable");
    return;
}


fn emit_val_base(Expr* e) {
    if (e == null) {
        xerr("null expr");
        return;
    }
    if (e.kind == X_EX_INT) {
        u64 v = lit_int_bits(e.tstart, e.tlen);
        if (v <= 4294967295) {
            buf_puts_c(g_o, "    movl $");
            buf_putu(g_o, v);
            buf_puts_c(g_o, ", %eax\n");
        } else {
            buf_puts_c(g_o, "    movabsq $");
            buf_putu(g_o, v);
            buf_puts_c(g_o, ", %rax\n");
        }
        return;
    }
    if (e.kind == X_EX_FLOAT) {
        mut u8* m = arena_alloc(g_ar, e.tlen + 1);
        mut u64 i = 0;
        while (i < e.tlen) {
            u8 c = e.tstart[i];
            if (c == 95) {
            } else if (c == 102 && i > 0) {
                break;
            } else {
                m[i] = c;
            }
            i = i + 1;
        }
        m[e.tlen] = 0;
        u64 bits = tk_strtod_bits(m as char*);
        buf_puts_c(g_o, "    movabsq $");
        buf_putu(g_o, bits);
        buf_puts_c(g_o, ", %rax\n");
        buf_puts_c(g_o, "    movq %rax, %xmm0\n");
        return;
    }
    if (e.kind == X_EX_STRING) {
        u8* inner = e.tstart + 1;
        mut u64 ilen = 0;
        if (e.tlen >= 2) {
            ilen = e.tlen - 2;
        }
        i32 id = rod_add(inner, ilen);
        buf_puts_c(g_o, "    leaq .Lstr_");
        buf_puti(g_o, id);
        buf_puts_c(g_o, "(%rip), %rax\n");
        return;
    }
    if (e.kind == X_EX_CHAR) {
        i64 v = lit_char_val(e.tstart, e.tlen);
        if (v < 0) {
            xerr("bad char literal");
            return;
        }
        buf_puts_c(g_o, "    movl $");
        buf_puti(g_o, v as i32);
        buf_putc(g_o, 44);
        buf_puts_c(g_o, " %eax\n");
        return;
    }
    if (e.kind == X_EX_BOOL) {
        if (e.tlen == 4) {
            buf_puts_c(g_o, "    movl $1, %eax\n");
        } else {
            buf_puts_c(g_o, "    movl $0, %eax\n");
        }
        return;
    }
    if (e.kind == X_EX_NULL) {
        buf_puts_c(g_o, "    xorl %eax, %eax\n");
        return;
    }
    if (e.kind == X_EX_VAR) {
        if (vlen(e.path) == 1) {
            char* nm = vec_get(e.path, 0) as char*;
            XV* v = xv_find(nm);
            if (v == null) {
                xerr("undefined variable");
                return;
            }
            if (ty_width(v.ty) == Q_STRUCT) {
                emit_var_addr(v);
            } else {
                emit_var_load(v, ty_width(v.ty));
            }
            return;
        }
        if (vlen(e.path) == 2) {
            char* s0 = vec_get(e.path, 0) as char*;
            char* s1 = vec_get(e.path, 1) as char*;
            XE* en = xfind_e(s0);
            if (en != null && !en.payload) {
                i32 vi = xfind_v(en, s1);
                if (vi >= 0) {
                    XEV* vv = vec_get(en.vars, vi as u64) as XEV*;
                    buf_puts_c(g_o, "    movl $");
                    buf_puti(g_o, vv.disc);
                    buf_puts_c(g_o, ", %eax\n");
                    return;
                }
            }
            if (en != null && en.payload) {
                i32 slot = tmp_find(e as u64);
                if (slot < 0) {
                    xerr("temp missing (walk/emit skew)");
                    return;
                }
                char* m = slot_str(slot, null as char*);
                i32 vi = xfind_v(en, s1);
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, vi);
                buf_puts_c(g_o, ", ");
                buf_puts_c(g_o, m);
                buf_putc(g_o, 10);
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, m);
                buf_puts_c(g_o, ", %rax\n");
                return;
            }
            xerr("unknown enum in value");
            return;
        }
        xerr("bad variable path");
        return;
    }
    if (e.kind == X_EX_PAREN) {
        emit_val(e.lhs);
        return;
    }
    if (e.kind == X_EX_CAST) {
        Type* st = xinfer(e.lhs);
        mut i32 from = Q_I64;
        if (st != null) {
            from = ty_width(st);
        }
        emit_val(e.lhs);
        Type* cto = e.cast_to;
        mut i32 to = Q_I64;
        if (cto != null) {
            to = ty_width(cto);
        }
        to_width(from, to);
        return;
    }
    if (e.kind == X_EX_STRUCT_LIT) {
        mut i32 slot = tmp_find(e as u64);
        if (slot < 0) {
            xerr("temp missing (walk/emit skew)");
            return;
        }
        mut char* base = slot_str(slot, null as char*);
        mut i32 tsz = 8;
        if (vlen(e.path) == 1) {
            XS* st = xfind_s(vec_get(e.path, 0) as char*);
            if (st != null) {
                tsz = st.size;
            }
        } else if (vlen(e.path) == 2) {
            char* s0 = vec_get(e.path, 0) as char*;
            XE* en = xfind_e(s0);
            if (en != null) {
                tsz = enum_value_bytes(en);
            }
        }
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, base);
        buf_puts_c(g_o, ", %rdi\n");
        buf_puts_c(g_o, "    movl $");
        buf_puti(g_o, tsz);
        buf_puts_c(g_o, ", %ecx\n");
        buf_puts_c(g_o, "    xorl %eax, %eax\n");
        buf_puts_c(g_o, "    rep stosb\n");
        if (vlen(e.path) == 1) {
            char* s0 = vec_get(e.path, 0) as char*;
            XS* st = xfind_s(s0);
            if (st == null) {
                xerr("unknown struct in literal");
                return;
            }
            mut u64 i = 0;
            while (i < vlen(e.sfields)) {
                SF* sf = vec_get(e.sfields, i) as SF*;
                mut i32 fi = -1;
                mut u64 j = 0;
                while (j < vlen(st.fields)) {
                    XSRow* fr = vec_get(st.fields, j) as XSRow*;
                    if (tk_streq(fr.nm, sf.field)) {
                        fi = j as i32;
                        break;
                    }
                    j = j + 1;
                }
                if (fi < 0) {
                    xerr("unknown struct field");
                    return;
                }
                emit_val(sf.e);
                XSRow* fr = vec_get(st.fields, fi as u64) as XSRow*;
                mut i32 fw = ty_width(fr.ty);
                mut i32 off = fr.off;
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, base);
                buf_puts_c(g_o, ", %rcx\n");
                if (off != 0) {
                    buf_puts_c(g_o, "    addq $");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, ", %rcx\n");
                }
                if (fw == Q_F32) {
                    buf_puts_c(g_o, "    movss %xmm0, (%rcx)\n");
                } else if (fw == Q_F64) {
                    buf_puts_c(g_o, "    movsd %xmm0, (%rcx)\n");
                } else if (fw == Q_STRUCT) {
                    mut i32 esz = ty_size(fr.ty);
                    buf_puts_c(g_o, "    movq %rax, %rsi\n");
                    buf_puts_c(g_o, "    movq %rcx, %rdi\n");
                    buf_puts_c(g_o, "    movl $");
                    buf_puti(g_o, esz);
                    buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
                } else {
                    store_mem("(%rcx)", fw);
                }
                i = i + 1;
            }
        } else if (vlen(e.path) == 2) {
            char* s0 = vec_get(e.path, 0) as char*;
            char* s1 = vec_get(e.path, 1) as char*;
            XE* en = xfind_e(s0);
            if (en == null) {
                xerr("struct literal on non-struct variant");
                return;
            }
            mut i32 vi = xfind_v(en, s1);
            mut XEV* vv = null;
            if (vi >= 0) {
                vv = vec_get(en.vars, vi as u64) as XEV*;
            }
            if (vi < 0 || vv == null || vv.kind != 2) {
                xerr("struct literal on non-struct variant");
                return;
            }
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, vi);
            buf_puts_c(g_o, ", ");
            buf_puts_c(g_o, base);
            buf_putc(g_o, 10);
            mut u64 i = 0;
            while (i < vlen(e.sfields)) {
                SF* sf = vec_get(e.sfields, i) as SF*;
                mut i32 fj = -1;
                mut u64 k = 0;
                while (k < vlen(vv.fs)) {
                    XEF* vf = vec_get(vv.fs, k) as XEF*;
                    if (tk_streq(vf.nm, sf.field)) {
                        fj = k as i32;
                        break;
                    }
                    k = k + 1;
                }
                if (fj < 0) {
                    xerr("unknown variant field");
                    return;
                }
                emit_val(sf.e);
                XEF* vf = vec_get(vv.fs, fj as u64) as XEF*;
                mut i32 fw = ty_width(vf.ty);
                mut i32 off = struct_field_off(en, vi, sf.field);
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, base);
                buf_puts_c(g_o, ", %rcx\n");
                buf_puts_c(g_o, "    addq $");
                buf_puti(g_o, off);
                buf_puts_c(g_o, ", %rcx\n");
                if (fw == Q_F32 || fw == Q_F64) {
                    if (fw == Q_F32) {
                        buf_puts_c(g_o, "    movss %xmm0, (%rcx)\n");
                    } else {
                        buf_puts_c(g_o, "    movsd %xmm0, (%rcx)\n");
                    }
                } else if (fw == Q_STRUCT) {
                    mut i32 esz = ty_size(vf.ty);
                    buf_puts_c(g_o, "    movq %rax, %rsi\n");
                    buf_puts_c(g_o, "    movq %rcx, %rdi\n");
                    buf_puts_c(g_o, "    movl $");
                    buf_puti(g_o, esz);
                    buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
                } else {
                    store_mem("(%rcx)", fw);
                }
                i = i + 1;
            }
        } else {
            xerr("bad struct literal path");
            return;
        }
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, base);
        buf_puts_c(g_o, ", %rax\n");
        return;
    }
    xerr("emit_val TODO for this expression");
    return;
}


fn emit_val_index(Expr* e) {
    Type* et = xinfer(e);
    mut i32 w = Q_I64;
    if (et != null) {
        w = ty_width(et);
    }
    if (w == Q_VOID) {
        xerr("void index value");
        return;
    }
    if (w == Q_STRUCT && et != null) {
        mut i32 slot = tmp_find(e as u64);
        if (slot < 0) {
            xerr("temp missing (walk/emit skew)");
            return;
        }
        mut char* tm = slot_str(slot, null as char*);
        mut i32 sz = ty_size(et);
        emit_addr(e);
        buf_puts_c(g_o, "    movq %rax, %rsi\n");
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, tm);
        buf_puts_c(g_o, ", %rdi\n");
        buf_puts_c(g_o, "    movl $");
        buf_puti(g_o, sz);
        buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, tm);
        buf_puts_c(g_o, ", %rax\n");
        return;
    }
    emit_addr(e);
    load_mem("(%rax)", w);
    return;
}

fn emit_val_field(Expr* e) {
    Type* et = xinfer(e);
    mut i32 w = Q_I64;
    if (et != null) {
        w = ty_width(et);
    }
    if (w == Q_VOID) {
        xerr("void field value");
        return;
    }
    if (w == Q_STRUCT && et != null) {
        mut i32 slot = tmp_find(e as u64);
        if (slot < 0) {
            xerr("temp missing (walk/emit skew)");
            return;
        }
        mut char* tm = slot_str(slot, null as char*);
        mut i32 sz = ty_size(et);
        emit_addr(e);
        buf_puts_c(g_o, "    movq %rax, %rsi\n");
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, tm);
        buf_puts_c(g_o, ", %rdi\n");
        buf_puts_c(g_o, "    movl $");
        buf_puti(g_o, sz);
        buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, tm);
        buf_puts_c(g_o, ", %rax\n");
        return;
    }
    emit_addr(e);
    load_mem("(%rax)", w);
    return;
}

fn emit_val_unary(Expr* e) {
    if (e.op == K_AMP) {
        emit_addr(e.lhs);
        return;
    }
    if (e.op == K_STAR) {
        Type* et = xinfer(e);
        mut i32 w = Q_I64;
        if (et != null) {
            w = ty_width(et);
        }
        if (w == Q_VOID) {
            xerr("void deref");
            return;
        }
        if (w == Q_STRUCT && et != null) {
            mut i32 slot = tmp_find(e as u64);
            if (slot < 0) {
                xerr("temp missing (walk/emit skew)");
                return;
            }
            mut char* tm = slot_str(slot, null as char*);
            mut i32 sz = ty_size(et);
            emit_val(e.lhs);
            buf_puts_c(g_o, "    movq %rax, %rsi\n");
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, tm);
            buf_puts_c(g_o, ", %rdi\n");
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, sz);
            buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, tm);
            buf_puts_c(g_o, ", %rax\n");
            return;
        }
        emit_val(e.lhs);
        load_mem("(%rax)", w);
        return;
    }
    if (e.op == K_PLUSPLUS || e.op == K_MINUSMINUS) {
        Type* et = xinfer(e.lhs);
        mut i32 w = Q_I64;
        if (et != null) {
            w = ty_width(et);
        }
        if (w == Q_F32 || w == Q_F64 || w == Q_STRUCT || w == Q_VOID) {
            xerr("++/-- on non-integer");
            return;
        }
        emit_addr(e.lhs);
        buf_puts_c(g_o, "    pushq %rax\n");
        load_mem("(%rax)", w);
        mut bool is64 = w == Q_I64 || w == Q_U64 || w == Q_PTR;
        if (e.op == K_PLUSPLUS) {
            if (is64) {
                buf_puts_c(g_o, "    addq $1, %rax\n");
            } else {
                buf_puts_c(g_o, "    addl $1, %eax\n");
            }
        } else {
            if (is64) {
                buf_puts_c(g_o, "    subq $1, %rax\n");
            } else {
                buf_puts_c(g_o, "    subl $1, %eax\n");
            }
        }
        buf_puts_c(g_o, "    popq %rcx\n");
        store_mem("(%rcx)", w);
        load_mem("(%rcx)", w);
        return;
    }
    emit_val(e.lhs);
    if (e.op == K_PLUS) {
        return;
    }
    if (e.op == K_MINUS) {
        buf_puts_c(g_o, "    negq %rax\n");
        return;
    }
    if (e.op == K_TILDE) {
        buf_puts_c(g_o, "    notq %rax\n");
        return;
    }
    if (e.op == K_BANG) {
        buf_puts_c(g_o, "    testq %rax, %rax\n    setz %al\n    movzbq %al, %rax\n");
        return;
    }
    xerr("bad unary op");
    return;
}

fn emit_val_post(Expr* e) {
    Type* et = xinfer(e.lhs);
    mut i32 w = Q_I64;
    if (et != null) {
        w = ty_width(et);
    }
    if (w == Q_F32 || w == Q_F64 || w == Q_STRUCT || w == Q_VOID) {
        xerr("++/-- on non-integer");
        return;
    }
    emit_addr(e.lhs);
    buf_puts_c(g_o, "    pushq %rax\n");
    load_mem("(%rax)", w);
    buf_puts_c(g_o, "    popq %rcx\n");
    buf_puts_c(g_o, "    pushq %rax\n");
    mut bool is64 = w == Q_I64 || w == Q_U64 || w == Q_PTR;
    if (e.kind == X_EX_POST_INC) {
        if (is64) {
            buf_puts_c(g_o, "    addq $1, %rax\n");
        } else {
            buf_puts_c(g_o, "    addl $1, %eax\n");
        }
    } else {
        if (is64) {
            buf_puts_c(g_o, "    subq $1, %rax\n");
        } else {
            buf_puts_c(g_o, "    subl $1, %eax\n");
        }
    }
    store_mem("(%rcx)", w);
    buf_puts_c(g_o, "    popq %rax\n");
    return;
}


fn emit_val_binary(Expr* e) {
    if (e.op == K_AMP2 || e.op == K_PIPE2) {
        mut i32 lf = new_lbl();
        mut i32 le = new_lbl();
        emit_val(e.lhs);
        buf_puts_c(g_o, "    testq %rax, %rax\n");
        if (e.op == K_AMP2) {
            buf_puts_c(g_o, "    jz .L");
            buf_puti(g_o, lf);
            buf_putc(g_o, 10);
            emit_val(e.rhs);
            buf_puts_c(g_o, "    testq %rax, %rax\n    jz .L");
            buf_puti(g_o, lf);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, "    movl $1, %eax\n    jmp .L");
            buf_puti(g_o, le);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, ".L");
            buf_puti(g_o, lf);
            buf_puts_c(g_o, ":\n    xorl %eax, %eax\n");
        } else {
            mut i32 lt = new_lbl();
            buf_puts_c(g_o, "    jnz .L");
            buf_puti(g_o, lt);
            buf_putc(g_o, 10);
            emit_val(e.rhs);
            buf_puts_c(g_o, "    testq %rax, %rax\n    jnz .L");
            buf_puti(g_o, lt);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, "    xorl %eax, %eax\n    jmp .L");
            buf_puti(g_o, le);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, ".L");
            buf_puti(g_o, lt);
            buf_puts_c(g_o, ":\n    movl $1, %eax\n");
        }
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, le);
        buf_puts_c(g_o, ":\n");
        return;
    }
    mut Type* lt = xinfer(e.lhs);
    Type* rt = xinfer(e.rhs);
    mut i32 lw = Q_I64;
    if (lt != null) {
        lw = ty_width(lt);
    }
    mut i32 rw = Q_I64;
    if (rt != null) {
        rw = ty_width(rt);
    }
    mut bool lf = lw == Q_F32 || lw == Q_F64;
    bool rf = rw == Q_F32 || rw == Q_F64;
    if (lf || rf) {
        mut i32 w = Q_F32;
        if (lw == Q_F64 || rw == Q_F64) {
            w = Q_F64;
        }
        if (w == Q_F64) {
            if (e.op != K_PLUS && e.op != K_MINUS && e.op != K_STAR && e.op != K_SLASH) {
                xerr("bad float binary op");
                return;
            }
        } else {
            if (e.op != K_PLUS && e.op != K_MINUS && e.op != K_STAR && e.op != K_SLASH) {
                xerr("bad float binary op");
                return;
            }
        }
        emit_val(e.lhs);
        to_width(lw, w);
        buf_puts_c(g_o, "    subq $8, %rsp\n    movq %xmm0, (%rsp)\n");
        emit_val(e.rhs);
        to_width(rw, w);
        if (w == Q_F64) {
            buf_puts_c(g_o, "    movsd (%rsp), %xmm1\n");
        } else {
            buf_puts_c(g_o, "    movss (%rsp), %xmm1\n");
        }
        buf_puts_c(g_o, "    addq $8, %rsp\n");
        if (w == Q_F64) {
            if (e.op == K_PLUS) {
                buf_puts_c(g_o, "    addsd %xmm1, %xmm0\n");
            } else if (e.op == K_MINUS) {
                buf_puts_c(g_o, "    subsd %xmm1, %xmm0\n");
            } else if (e.op == K_STAR) {
                buf_puts_c(g_o, "    mulsd %xmm1, %xmm0\n");
            } else {
                buf_puts_c(g_o, "    divsd %xmm1, %xmm0\n");
            }
        } else {
            if (e.op == K_PLUS) {
                buf_puts_c(g_o, "    addss %xmm1, %xmm0\n");
            } else if (e.op == K_MINUS) {
                buf_puts_c(g_o, "    subss %xmm1, %xmm0\n");
            } else if (e.op == K_STAR) {
                buf_puts_c(g_o, "    mulss %xmm1, %xmm0\n");
            } else {
                buf_puts_c(g_o, "    divss %xmm1, %xmm0\n");
            }
        }
        return;
    }
    mut bool lp = lw == Q_PTR || lw == Q_U64 || lw == Q_I64;
    mut bool rp = rw == Q_PTR || rw == Q_U64 || rw == Q_I64;
    mut i32 w = Q_I32;
    mut i32 lr = 41;
    if (lt != null && lt.kind == X_TY_PRIM) {
        lr = prim_rank(lt.prim);
    }
    mut i32 rr = 41;
    if (rt != null && rt.kind == X_TY_PRIM) {
        rr = prim_rank(rt.prim);
    }
    if (lp || rp) {
        w = Q_I64;
    } else if (lr >= 44 || rr >= 44) {
        w = Q_U64;
    } else if (lr == 43 || rr == 43) {
        w = Q_I64;
    } else if (lr == 42 || rr == 42) {
        w = Q_U32;
    }
    mut bool isq = w == Q_I64 || w == Q_U64 || w == Q_PTR;
    if (!lp && !rp && lr < 41 && rr < 41) {
        isq = false;
        w = Q_I32;
    }
    emit_val(e.lhs);
    buf_puts_c(g_o, "    pushq %rax\n");
    emit_val(e.rhs);
    buf_puts_c(g_o, "    movq %rax, %rcx\n");
    buf_puts_c(g_o, "    popq %rax\n");
    if (e.op == K_PLUS) {
        if (isq) {
            buf_puts_c(g_o, "    addq %rcx, %rax\n");
        } else {
            buf_puts_c(g_o, "    addl %ecx, %eax\n");
        }
    } else if (e.op == K_MINUS) {
        if (isq) {
            buf_puts_c(g_o, "    subq %rcx, %rax\n");
        } else {
            buf_puts_c(g_o, "    subl %ecx, %eax\n");
        }
    } else if (e.op == K_STAR) {
        if (isq) {
            buf_puts_c(g_o, "    imulq %rcx, %rax\n");
        } else {
            buf_puts_c(g_o, "    imull %ecx, %eax\n");
        }
    } else if (e.op == K_SLASH || e.op == K_PERCENT) {
        mut bool isdiv = e.op == K_SLASH;
        mut bool uns = lw == Q_U64 || lw == Q_U32 || lw == Q_U16 || lw == Q_U8 || rw == Q_U64 || rw == Q_U32 || rw == Q_U16 || rw == Q_U8 || lw == Q_PTR || rw == Q_PTR;
        if (isq) {
            if (uns) {
                buf_puts_c(g_o, "    xorl %edx, %edx\n    divq %rcx\n");
            } else {
                buf_puts_c(g_o, "    cqo\n    idivq %rcx\n");
            }
            if (!isdiv) {
                buf_puts_c(g_o, "    movq %rdx, %rax\n");
            }
        } else {
            if (uns) {
                buf_puts_c(g_o, "    xorl %edx, %edx\n    divl %ecx\n");
            } else {
                buf_puts_c(g_o, "    cltd\n    idivl %ecx\n");
            }
            if (!isdiv) {
                buf_puts_c(g_o, "    movl %edx, %eax\n");
            }
        }
    } else if (e.op == K_SHL) {
        if (isq) {
            buf_puts_c(g_o, "    shlq %cl, %rax\n");
        } else {
            buf_puts_c(g_o, "    shll %cl, %eax\n");
        }
    } else if (e.op == K_SHR) {
        mut bool uns = lw == Q_U64 || lw == Q_U32 || lw == Q_U16 || lw == Q_U8;
        if (isq) {
            if (uns) {
                buf_puts_c(g_o, "    shrq %cl, %rax\n");
            } else {
                buf_puts_c(g_o, "    sarq %cl, %rax\n");
            }
        } else {
            if (uns) {
                buf_puts_c(g_o, "    shrl %cl, %eax\n");
            } else {
                buf_puts_c(g_o, "    sarl %cl, %eax\n");
            }
        }
    } else if (e.op == K_AMP) {
        if (isq) {
            buf_puts_c(g_o, "    andq %rcx, %rax\n");
        } else {
            buf_puts_c(g_o, "    andl %ecx, %eax\n");
        }
    } else if (e.op == K_CARET) {
        if (isq) {
            buf_puts_c(g_o, "    xorq %rcx, %rax\n");
        } else {
            buf_puts_c(g_o, "    xorl %ecx, %eax\n");
        }
    } else if (e.op == K_PIPE) {
        if (isq) {
            buf_puts_c(g_o, "    orq %rcx, %rax\n");
        } else {
            buf_puts_c(g_o, "    orl %ecx, %eax\n");
        }
    } else if (e.op == K_EQEQ || e.op == K_BANGEQ || e.op == K_LT || e.op == K_GT || e.op == K_LTEQ || e.op == K_GTEQ) {
        mut bool uns = lw == Q_U64 || lw == Q_U32 || lw == Q_U16 || lw == Q_U8 || rw == Q_U64 || rw == Q_U32 || rw == Q_U16 || rw == Q_U8 || lw == Q_PTR || rw == Q_PTR;
        if (isq) {
            buf_puts_c(g_o, "    cmpq %rcx, %rax\n");
            if (e.op == K_EQEQ) {
                buf_puts_c(g_o, "    sete %al\n    movzbq %al, %rax\n");
            } else if (e.op == K_BANGEQ) {
                buf_puts_c(g_o, "    setne %al\n    movzbq %al, %rax\n");
            } else if (e.op == K_LT) {
                if (uns) {
                    buf_puts_c(g_o, "    setb %al\n    movzbq %al, %rax\n");
                } else {
                    buf_puts_c(g_o, "    setl %al\n    movzbq %al, %rax\n");
                }
            } else if (e.op == K_GT) {
                if (uns) {
                    buf_puts_c(g_o, "    seta %al\n    movzbq %al, %rax\n");
                } else {
                    buf_puts_c(g_o, "    setg %al\n    movzbq %al, %rax\n");
                }
            } else if (e.op == K_LTEQ) {
                if (uns) {
                    buf_puts_c(g_o, "    setbe %al\n    movzbq %al, %rax\n");
                } else {
                    buf_puts_c(g_o, "    setle %al\n    movzbq %al, %rax\n");
                }
            } else {
                if (uns) {
                    buf_puts_c(g_o, "    setae %al\n    movzbq %al, %rax\n");
                } else {
                    buf_puts_c(g_o, "    setge %al\n    movzbq %al, %rax\n");
                }
            }
        } else {
            buf_puts_c(g_o, "    cmpl %ecx, %eax\n");
            if (e.op == K_EQEQ) {
                buf_puts_c(g_o, "    sete %al\n    movzbq %al, %rax\n");
            } else if (e.op == K_BANGEQ) {
                buf_puts_c(g_o, "    setne %al\n    movzbq %al, %rax\n");
            } else if (e.op == K_LT) {
                if (uns) {
                    buf_puts_c(g_o, "    setb %al\n    movzbq %al, %rax\n");
                } else {
                    buf_puts_c(g_o, "    setl %al\n    movzbq %al, %rax\n");
                }
            } else if (e.op == K_GT) {
                if (uns) {
                    buf_puts_c(g_o, "    seta %al\n    movzbq %al, %rax\n");
                } else {
                    buf_puts_c(g_o, "    setg %al\n    movzbq %al, %rax\n");
                }
            } else if (e.op == K_LTEQ) {
                if (uns) {
                    buf_puts_c(g_o, "    setbe %al\n    movzbq %al, %rax\n");
                } else {
                    buf_puts_c(g_o, "    setle %al\n    movzbq %al, %rax\n");
                }
            } else {
                if (uns) {
                    buf_puts_c(g_o, "    setae %al\n    movzbq %al, %rax\n");
                } else {
                    buf_puts_c(g_o, "    setge %al\n    movzbq %al, %rax\n");
                }
            }
        }
    } else {
        xerr("bad binary op");
        return;
    }
    if (!isq && e.op != K_EQEQ && e.op != K_BANGEQ && e.op != K_LT && e.op != K_GT && e.op != K_LTEQ && e.op != K_GTEQ) {
        if (w == Q_I8 || w == Q_CHAR) {
            buf_puts_c(g_o, "    movsbq %al, %rax\n");
        } else if (w == Q_U8 || w == Q_BOOL) {
            buf_puts_c(g_o, "    movzbq %al, %rax\n");
        } else if (w == Q_I16) {
            buf_puts_c(g_o, "    movswq %ax, %rax\n");
        } else if (w == Q_U16) {
            buf_puts_c(g_o, "    movzwq %ax, %rax\n");
        } else if (w == Q_I32) {
            buf_puts_c(g_o, "    movslq %eax, %rax\n");
        } else {
            buf_puts_c(g_o, "    movl %eax, %eax\n");
        }
    }
    return;
}


fn emit_val_ternary(Expr* e) {
    Type* tt = xinfer(e.then_e);
    mut i32 w = Q_I64;
    if (tt != null) {
        w = ty_width(tt);
    }
    mut i32 lelse = new_lbl();
    mut i32 lend = new_lbl();
    emit_val(e.cond);
    buf_puts_c(g_o, "    testq %rax, %rax\n    jz .L");
    buf_puti(g_o, lelse);
    buf_putc(g_o, 10);
    if (w == Q_STRUCT) {
        xerr("struct ternary needs place context");
    } else {
        emit_val(e.then_e);
        to_width(xqw(e.then_e), w);
        if (w == Q_F32 || w == Q_F64) {
            buf_puts_c(g_o, "    subq $8, %rsp\n    movq %xmm0, (%rsp)\n");
        } else {
            buf_puts_c(g_o, "    pushq %rax\n");
        }
    }
    buf_puts_c(g_o, "    jmp .L");
    buf_puti(g_o, lend);
    buf_putc(g_o, 10);
    buf_puts_c(g_o, ".L");
    buf_puti(g_o, lelse);
    buf_puts_c(g_o, ":\n");
    if (w == Q_STRUCT) {
        xerr("struct ternary needs place context");
    } else {
        emit_val(e.else_e);
        to_width(xqw(e.else_e), w);
    }
    if (w == Q_F32 || w == Q_F64) {
        buf_puts_c(g_o, "    addq $8, %rsp\n");
    } else {
        buf_puts_c(g_o, "    popq %rcx\n");
    }
    buf_puts_c(g_o, ".L");
    buf_puti(g_o, lend);
    buf_puts_c(g_o, ":\n");
    return;
}

fn emit_val_block(Expr* e) {
    xv_push();
    emit_stmts(e.stmts);
    if (e.trailing != null) {
        emit_val(e.trailing);
    } else {
        xerr("block value needs trailing expression");
    }
    xv_pop();
    return;
}

fn emit_val(Expr* e) {
    if (e == null) {
        xerr("null expr");
        return;
    }
    if (e.kind == X_EX_INDEX) {
        emit_val_index(e);
        return;
    }
    if (e.kind == X_EX_FIELD) {
        emit_val_field(e);
        return;
    }
    if (e.kind == X_EX_UNARY) {
        emit_val_unary(e);
        return;
    }
    if (e.kind == X_EX_POST_INC || e.kind == X_EX_POST_DEC) {
        emit_val_post(e);
        return;
    }
    if (e.kind == X_EX_BINARY) {
        emit_val_binary(e);
        return;
    }
    if (e.kind == X_EX_TERNARY) {
        emit_val_ternary(e);
        return;
    }
    if (e.kind == X_EX_BLOCK) {
        emit_val_block(e);
        return;
    }
    if (e.kind == X_EX_SIZEOF) {
        buf_puts_c(g_o, "    movq $8, %rax\n");
        return;
    }
    if (e.kind == X_EX_OFFSETOF) {
        buf_puts_c(g_o, "    movq $0, %rax\n");
        return;
    }
    if (e.kind == X_EX_TRANSACT) {
        buf_puts_c(g_o, "    movl $1, %eax\n");
        return;
    }
    if (e.kind == X_EX_SPAWN) {
        if (e.callee != null) {
            emit_val(e.callee);
        }
        buf_puts_c(g_o, "    xorl %eax, %eax\n");
        return;
    }
    if (e.kind == X_EX_HANDLE) {
        emit_val(null as Expr*);
        return;
    }
    if (e.kind == X_EX_PERFORM) {
        i32 id = rod_add("<effect-stub>\\n" as u8*, 15);
        buf_puts_c(g_o, "    leaq .Lstr_");
        buf_puti(g_o, id);
        buf_puts_c(g_o, "(%rip), %rdi\n");
        buf_puts_c(g_o, "    xorl %eax, %eax\n");
        buf_puts_c(g_o, "    call printf@PLT\n");
        buf_puts_c(g_o, "    xorl %eax, %eax\n");
        return;
    }
    if (e.kind == X_EX_RESUME) {
        buf_puts_c(g_o, "    xorl %eax, %eax\n");
        return;
    }
    if (e.kind == X_EX_MATCH) {
        xerr("match expressions only in decl-init/return positions in core");
        buf_puts_c(g_o, "    xorl %eax, %eax\n");
        return;
    }
    if (e.kind == X_EX_ARRAY_LIST) {
        xerr("array literal needs List<T> or [T; N] context in core");
        return;
    }
    if (e.kind == X_EX_BRACE || e.kind == X_EX_LAMBDA || e.kind == X_EX_IF) {
        xerr("block/lambda/if values TODO in core backend");
        return;
    }
    if (e.kind == X_EX_CALL) {
        emit_call(e);
        return;
    }
    emit_val_base(e);
    return;
}


fn ir_reg(i32 i) -> char* {
    if (i == 0) { return "%rdi"; }
    if (i == 1) { return "%rsi"; }
    if (i == 2) { return "%rdx"; }
    if (i == 3) { return "%rcx"; }
    if (i == 4) { return "%r8"; }
    return "%r9";
}

fn ir32_reg(i32 i) -> char* {
    if (i == 0) { return "%edi"; }
    if (i == 1) { return "%esi"; }
    if (i == 2) { return "%edx"; }
    if (i == 3) { return "%ecx"; }
    if (i == 4) { return "%r8d"; }
    return "%r9d";
}

fn mangle_rec(Type* t) {
    if (t == null) {
        buf_puts_c(g_o, "void");
        return;
    }
    if (t.kind == X_TY_PRIM) {
        if (t.prim == K_I8) { buf_puts_c(g_o, "i8"); }
        else if (t.prim == K_I16) { buf_puts_c(g_o, "i16"); }
        else if (t.prim == K_I32) { buf_puts_c(g_o, "i32"); }
        else if (t.prim == K_I64) { buf_puts_c(g_o, "i64"); }
        else if (t.prim == K_U8) { buf_puts_c(g_o, "u8"); }
        else if (t.prim == K_U16) { buf_puts_c(g_o, "u16"); }
        else if (t.prim == K_U32) { buf_puts_c(g_o, "u32"); }
        else if (t.prim == K_U64) { buf_puts_c(g_o, "u64"); }
        else if (t.prim == K_F32) { buf_puts_c(g_o, "f32"); }
        else if (t.prim == K_F64) { buf_puts_c(g_o, "f64"); }
        else if (t.prim == K_CHAR_TY) { buf_puts_c(g_o, "char"); }
        else if (t.prim == K_BOOL) { buf_puts_c(g_o, "bool"); }
        else if (t.prim == K_SVIEW) { buf_puts_c(g_o, "sview"); }
        else if (t.prim == K_NEVER) { buf_puts_c(g_o, "never"); }
        else { buf_puts_c(g_o, "unk"); }
    } else if (t.kind == X_TY_PATH) {
        if (vlen(t.path) == 1) {
            char* s0 = vec_get(t.path, 0) as char*;
            if (tk_streq(s0, "List") && vlen(t.gargs) == 1) {
                buf_puts_c(g_o, "List_");
                mangle_rec(vec_get(t.gargs, 0) as Type*);
            } else {
                mut u64 i = 0;
                while (i < vlen(t.path)) {
                    if (i != 0) {
                        buf_putc(g_o, 95);
                    }
                    char* s = vec_get(t.path, i) as char*;
                    buf_puts_c(g_o, s);
                    i = i + 1;
                }
            }
        }
    } else {
        buf_putc(g_o, 84);
    }
    mut i32 k = 0;
    while (k < t.stars) {
        buf_putc(g_o, 80);
        k = k + 1;
    }
    if (t.is_ref) {
        buf_putc(g_o, 82);
    }
    return;
}

fn arg_home_area(i32 i) -> char* {
    return slot_str(g_ab + i * 8 + 7, null as char*);
}

mut i32 g_ab = 0;
mut i32 g_ob = 0;
mut i32 g_ipos = 0;
mut i32 g_fpos = 0;
mut i32 g_spos = 0;

fn arg_home(i32 i, Type* formal, bool sret) {
    mut char* area = arg_home_area(i);
    mut i32 aw = Q_I64;
    if (formal != null) {
        aw = ty_width(formal);
    }
    if (aw == Q_F32 || aw == Q_F64) {
        if (g_fpos < 8) {
            if (aw == Q_F32) {
                buf_puts_c(g_o, "    movss ");
                buf_puts_c(g_o, area);
                buf_puts_c(g_o, ", %xmm");
                buf_puti(g_o, g_fpos);
                buf_putc(g_o, 10);
            } else {
                buf_puts_c(g_o, "    movsd ");
                buf_puts_c(g_o, area);
                buf_puts_c(g_o, ", %xmm");
                buf_puti(g_o, g_fpos);
                buf_putc(g_o, 10);
            }
            g_fpos = g_fpos + 1;
        } else {
            mut char* dst = slot_str(g_ob + g_spos, null as char*);
            buf_puts_c(g_o, "    movq ");
            buf_puts_c(g_o, area);
            buf_puts_c(g_o, ", %rax\n");
            buf_puts_c(g_o, "    movq %rax, ");
            buf_puts_c(g_o, dst);
            buf_putc(g_o, 10);
            g_spos = g_spos + 1;
        }
        return;
    }
    mut i32 pos = g_ipos;
    if (sret) {
        pos = pos + 1;
    }
    if (aw == Q_STRUCT) {
        if (pos < 6) {
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, area);
            buf_puts_c(g_o, ", ");
            buf_puts_c(g_o, ir_reg(pos));
            buf_putc(g_o, 10);
        } else {
            mut char* dst = slot_str(g_ob + g_spos, null as char*);
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, area);
            buf_puts_c(g_o, ", %rax\n");
            buf_puts_c(g_o, "    movq %rax, ");
            buf_puts_c(g_o, dst);
            buf_putc(g_o, 10);
            g_spos = g_spos + 1;
        }
        g_ipos = g_ipos + 1;
        return;
    }
    if (pos < 6) {
        if (aw == Q_I32 || aw == Q_U32 || aw == Q_BOOL || aw == Q_CHAR) {
            buf_puts_c(g_o, "    movl ");
            buf_puts_c(g_o, area);
            buf_puts_c(g_o, ", ");
            buf_puts_c(g_o, ir32_reg(pos));
            buf_putc(g_o, 10);
        } else {
            buf_puts_c(g_o, "    movq ");
            buf_puts_c(g_o, area);
            buf_puts_c(g_o, ", ");
            buf_puts_c(g_o, ir_reg(pos));
            buf_putc(g_o, 10);
        }
        g_ipos = g_ipos + 1;
    } else {
        mut char* dst = slot_str(g_ob + g_spos, null as char*);
        buf_puts_c(g_o, "    movq ");
        buf_puts_c(g_o, area);
        buf_puts_c(g_o, ", %rax\n");
        buf_puts_c(g_o, "    movq %rax, ");
        buf_puts_c(g_o, dst);
        buf_putc(g_o, 10);
        g_spos = g_spos + 1;
        g_ipos = g_ipos + 1;
    }
    return;
}


fn stmt_may_call(Stmt* s) -> bool {
    if (s == null) {
        return false;
    }
    if (s.kind == X_ST_DECL) {
        mut u64 i = 0;
        while (i < vlen(s.inits)) {
            if (expr_may_call(vec_get(s.inits, i) as Expr*)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if (s.kind == X_ST_SIMPLE) {
        if (expr_may_call(s.e1)) {
            return true;
        }
        return s.has_assign && expr_may_call(s.e2);
    }
    if (s.kind == X_ST_BLOCK) {
        mut u64 i = 0;
        while (i < vlen(s.stmts)) {
            if (stmt_may_call(vec_get(s.stmts, i) as Stmt*)) {
                return true;
            }
            i = i + 1;
        }
        return expr_may_call(s.trailing);
    }
    if (s.kind == X_ST_IF) {
        if (s.cond_ex != null) {
            if (expr_may_call(s.cond_ex)) {
                return true;
            }
        } else {
            if (expr_may_call(s.cond)) {
                return true;
            }
        }
        mut u64 i = 0;
        while (i < vlen(s.then_s)) {
            if (stmt_may_call(vec_get(s.then_s, i) as Stmt*)) {
                return true;
            }
            i = i + 1;
        }
        i = 0;
        while (i < vlen(s.eifs)) {
            EIF* ei = vec_get(s.eifs, i) as EIF*;
            if (ei.e != null) {
                if (expr_may_call(ei.e)) {
                    return true;
                }
            } else {
                if (expr_may_call(ei.c)) {
                    return true;
                }
            }
            mut u64 j = 0;
            while (j < vlen(ei.s)) {
                if (stmt_may_call(vec_get(ei.s, j) as Stmt*)) {
                    return true;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        if (s.has_els) {
            mut u64 k = 0;
            while (k < vlen(s.els)) {
                if (stmt_may_call(vec_get(s.els, k) as Stmt*)) {
                    return true;
                }
                k = k + 1;
            }
        }
        return false;
    }
    if (s.kind == X_ST_WHILE) {
        if (s.cond_ex != null) {
            if (expr_may_call(s.cond_ex)) {
                return true;
            }
        } else {
            if (expr_may_call(s.cond)) {
                return true;
            }
        }
        mut u64 i = 0;
        while (i < vlen(s.then_s)) {
            if (stmt_may_call(vec_get(s.then_s, i) as Stmt*)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if (s.kind == X_ST_FOR_C) {
        if (!s.for_init_empty) {
            if (s.for_init_is_decl) {
                Stmt* d = s.for_init_decl;
                mut u64 i = 0;
                while (i < vlen(d.inits)) {
                    if (expr_may_call(vec_get(d.inits, i) as Expr*)) {
                        return true;
                    }
                    i = i + 1;
                }
            } else if (stmt_may_call(s.for_init_simple)) {
                return true;
            }
        }
        if (s.has_for_cond && expr_may_call(s.for_cond)) {
            return true;
        }
        if (s.has_incr && stmt_may_call(s.for_incr)) {
            return true;
        }
        mut u64 i = 0;
        while (i < vlen(s.then_s)) {
            if (stmt_may_call(vec_get(s.then_s, i) as Stmt*)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if (s.kind == X_ST_MATCH_STMT) {
        if (expr_may_call(s.m_scrut)) {
            return true;
        }
        mut u64 i = 0;
        while (i < vlen(s.m_arms)) {
            ArmS* am = vec_get(s.m_arms, i) as ArmS*;
            if (am.guard != null && expr_may_call(am.guard)) {
                return true;
            }
            mut u64 j = 0;
            while (j < vlen(am.bs)) {
                if (stmt_may_call(vec_get(am.bs, j) as Stmt*)) {
                    return true;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return false;
    }
    if (s.kind == X_ST_RETURN) {
        return s.has_ret && expr_may_call(s.ret_e);
    }
    return false;
}

fn expr_may_call(Expr* e) -> bool {
    if (e == null) {
        return false;
    }
    if (e.kind == X_EX_INT || e.kind == X_EX_FLOAT || e.kind == X_EX_STRING || e.kind == X_EX_CHAR || e.kind == X_EX_BOOL || e.kind == X_EX_NULL || e.kind == X_EX_UNDEF || e.kind == X_EX_VAR) {
        return false;
    }
    if (e.kind == X_EX_CALL) {
        return true;
    }
    if (e.kind == X_EX_PAREN || e.kind == X_EX_CAST) {
        return expr_may_call(e.lhs);
    }
    if (e.kind == X_EX_UNARY || e.kind == X_EX_POST_INC || e.kind == X_EX_POST_DEC) {
        return expr_may_call(e.lhs);
    }
    if (e.kind == X_EX_BINARY) {
        return expr_may_call(e.lhs) || expr_may_call(e.rhs);
    }
    if (e.kind == X_EX_TERNARY) {
        return expr_may_call(e.cond) || expr_may_call(e.then_e) || expr_may_call(e.else_e);
    }
    if (e.kind == X_EX_BLOCK) {
        mut u64 i = 0;
        while (i < vlen(e.stmts)) {
            if (stmt_may_call(vec_get(e.stmts, i) as Stmt*)) {
                return true;
            }
            i = i + 1;
        }
        return expr_may_call(e.trailing);
    }
    if (e.kind == X_EX_INDEX) {
        return expr_may_call(e.callee) || expr_may_call(e.index);
    }
    if (e.kind == X_EX_FIELD) {
        return expr_may_call(e.callee);
    }
    if (e.kind == X_EX_STRUCT_LIT) {
        mut u64 i = 0;
        while (i < vlen(e.sfields)) {
            SF* sf = vec_get(e.sfields, i) as SF*;
            if (expr_may_call(sf.e)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    if (e.kind == X_EX_ARRAY_LIST) {
        mut u64 i = 0;
        while (i < vlen(e.elems)) {
            if (expr_may_call(vec_get(e.elems, i) as Expr*)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
    return true;
}

fn emit_call(Expr* e) {
    if (e.callee != null && e.callee.kind == X_EX_FIELD && tk_streq(e.callee.field, "push") && e.callee.callee != null) {
        Type* bt = xinfer(e.callee.callee);
        if (bt != null && bt.kind == X_TY_PATH && vlen(bt.path) == 1) {
            char* s0 = vec_get(bt.path, 0) as char*;
            if (tk_streq(s0, "List") && vlen(bt.gargs) == 1 && bt.stars == 0 && !bt.is_ref) {
                if (vlen(e.args) != 1) {
                    xerr("push takes exactly one arg");
                    return;
                }
                Type* et = vec_get(bt.gargs, 0) as Type*;
                i32 ew = ty_width(et);
                mut bool protect = expr_may_call(e.callee.callee) || expr_may_call(vec_get(e.args, 0) as Expr*);
                mut i32 ts0 = -1;
                mut i32 ts1 = -1;
                if (protect) {
                    ts0 = tmp_slot(1);
                    emit_addr(e.callee.callee);
                    buf_puts_c(g_o, "    movq %rax, ");
                    buf_puts_c(g_o, slot_str(ts0, null as char*));
                    buf_putc(g_o, 10);
                    ts1 = tmp_slot(1);
                    emit_val(vec_get(e.args, 0) as Expr*);
                    if (ew == Q_F32) {
                        buf_puts_c(g_o, "    movss %xmm0, ");
                    } else if (ew == Q_F64) {
                        buf_puts_c(g_o, "    movsd %xmm0, ");
                    } else {
                        buf_puts_c(g_o, "    movq %rax, ");
                    }
                    buf_puts_c(g_o, slot_str(ts1, null as char*));
                    buf_putc(g_o, 10);
                    buf_puts_c(g_o, "    movq ");
                    buf_puts_c(g_o, slot_str(ts0, null as char*));
                    buf_puts_c(g_o, ", %rax\n");
                } else {
                    emit_addr(e.callee.callee);
                }
                mut char* a0 = slot_str(g_ab, null as char*);
                buf_puts_c(g_o, "    movq %rax, ");
                buf_puts_c(g_o, a0);
                buf_putc(g_o, 10);
                if (protect) {
                    if (ew == Q_F32) {
                        buf_puts_c(g_o, "    movss ");
                        buf_puts_c(g_o, slot_str(ts1, null as char*));
                        buf_puts_c(g_o, ", %xmm0\n");
                    } else if (ew == Q_F64) {
                        buf_puts_c(g_o, "    movsd ");
                        buf_puts_c(g_o, slot_str(ts1, null as char*));
                        buf_puts_c(g_o, ", %xmm0\n");
                    } else {
                        buf_puts_c(g_o, "    movq ");
                        buf_puts_c(g_o, slot_str(ts1, null as char*));
                        buf_puts_c(g_o, ", %rax\n");
                    }
                } else {
                    emit_val(vec_get(e.args, 0) as Expr*);
                }
                mut char* a1 = slot_str(g_ab + 15, null as char*);
                if (ew == Q_STRUCT) {
                    mut i32 esz = ty_size(et);
                    buf_puts_c(g_o, "    movq %rax, %rsi\n");
                    buf_puts_c(g_o, "    leaq ");
                    buf_puts_c(g_o, a1);
                    buf_puts_c(g_o, ", %rdi\n");
                    buf_puts_c(g_o, "    movl $");
                    buf_puti(g_o, esz);
                    buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
                    buf_puts_c(g_o, "    leaq ");
                    buf_puts_c(g_o, a1);
                    buf_puts_c(g_o, ", %rsi\n");
                } else if (ew == Q_F32) {
                    buf_puts_c(g_o, "    movss %xmm0, ");
                    buf_puts_c(g_o, a1);
                    buf_putc(g_o, 10);
                    buf_puts_c(g_o, "    movq ");
                    buf_puts_c(g_o, a1);
                    buf_puts_c(g_o, ", %rsi\n");
                } else if (ew == Q_F64) {
                    buf_puts_c(g_o, "    movsd %xmm0, ");
                    buf_puts_c(g_o, a1);
                    buf_putc(g_o, 10);
                    buf_puts_c(g_o, "    movq ");
                    buf_puts_c(g_o, a1);
                    buf_puts_c(g_o, ", %rsi\n");
                } else {
                    store_mem(a1, ew);
                    buf_puts_c(g_o, "    movq ");
                    buf_puts_c(g_o, a1);
                    buf_puts_c(g_o, ", %rsi\n");
                }
                buf_puts_c(g_o, "    movq ");
                buf_puts_c(g_o, a0);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    call List_");
                mangle_rec(et);
                buf_puts_c(g_o, "_push\n");
                return;
            }
        }
    }
    if (e.callee != null && e.callee.kind == X_EX_VAR && vlen(e.callee.path) == 1) {
        char* nm = vec_get(e.callee.path, 0) as char*;
        if (is_print_like(nm)) {
            if (tk_streq(nm, "tk_effect_stub")) {
                i32 id = rod_add("<effect-stub>\\n" as u8*, 15);
                buf_puts_c(g_o, "    leaq .Lstr_");
                buf_puti(g_o, id);
                buf_puts_c(g_o, "(%rip), %rdi\n");
                buf_puts_c(g_o, "    xorl %eax, %eax\n    call printf@PLT\n");
                buf_puts_c(g_o, "    xorl %eax, %eax\n");
                return;
            }
            if (vlen(e.args) != 1) {
                xerr("print takes exactly one arg");
                return;
            }
            mut char* fmt = "%s\\n";
            if (tk_streq(nm, "tk_print_i32")) {
                fmt = "%d\\n";
            }
            i32 id = rod_add(fmt as u8*, 4);
            emit_val(vec_get(e.args, 0) as Expr*);
            buf_puts_c(g_o, "    pushq %rax\n");
            buf_puts_c(g_o, "    leaq .Lstr_");
            buf_puti(g_o, id);
            buf_puts_c(g_o, "(%rip), %rdi\n");
            buf_puts_c(g_o, "    popq %rsi\n");
            buf_puts_c(g_o, "    xorl %eax, %eax\n    call printf@PLT\n");
            return;
        }
        if (tk_streq(nm, "tk_sview") || tk_streq(nm, "tk_sview_u8")) {
            if (vlen(e.args) != 2) {
                xerr("sview ctor takes (ptr, len)");
                return;
            }
            mut i32 slot = tmp_find(e as u64);
            if (slot < 0) {
                xerr("temp missing (walk/emit skew)");
                return;
            }
            mut char* base = slot_str(slot, null as char*);
            mut char* m1 = slot_str(slot - 1, null as char*);
            emit_val(vec_get(e.args, 0) as Expr*);
            buf_puts_c(g_o, "    movq %rax, ");
            buf_puts_c(g_o, base);
            buf_putc(g_o, 10);
            emit_val(vec_get(e.args, 1) as Expr*);
            to_width(xqw(vec_get(e.args, 1) as Expr*), Q_I64);
            buf_puts_c(g_o, "    movq %rax, ");
            buf_puts_c(g_o, m1);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, base);
            buf_puts_c(g_o, ", %rax\n");
            return;
        }
    }
    if (e.callee != null && e.callee.kind == X_EX_VAR && vlen(e.callee.path) == 2) {
        char* s0 = vec_get(e.callee.path, 0) as char*;
        char* s1 = vec_get(e.callee.path, 1) as char*;
        XE* en = xfind_e(s0);
        if (en != null && en.payload) {
            mut i32 vi = xfind_v(en, s1);
            mut XEV* vv = null;
            if (vi >= 0) {
                vv = vec_get(en.vars, vi as u64) as XEV*;
            }
            if (vi < 0 || vv == null || vv.kind != 1) {
                xerr("call on non-tuple variant");
                return;
            }
            if (vlen(e.args) != vlen(vv.ts)) {
                xerr("wrong tuple arity");
                return;
            }
            mut i32 slot = tmp_find(e as u64);
            if (slot < 0) {
                xerr("temp missing (walk/emit skew)");
                return;
            }
            mut char* base = slot_str(slot, null as char*);
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, vi);
            buf_puts_c(g_o, ", ");
            buf_puts_c(g_o, base);
            buf_putc(g_o, 10);
            mut u64 i = 0;
            while (i < vlen(e.args)) {
                emit_val(vec_get(e.args, i) as Expr*);
                Type* fty = vec_get(vv.ts, i) as Type*;
                mut i32 fw = ty_width(fty);
                mut i32 off = tuple_field_off(en, vi, i as i32);
                if (fw == Q_STRUCT) {
                    i32 esz = ty_size(fty);
                    buf_puts_c(g_o, "    movq %rax, %rsi\n");
                    buf_puts_c(g_o, "    leaq ");
                    buf_puts_c(g_o, base);
                    buf_puts_c(g_o, ", %rdi\n");
                    buf_puts_c(g_o, "    addq $");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, ", %rdi\n");
                    buf_puts_c(g_o, "    movl $");
                    buf_puti(g_o, esz);
                    buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
                } else if (fw == Q_F32 || fw == Q_F64) {
                    buf_puts_c(g_o, "    leaq ");
                    buf_puts_c(g_o, base);
                    buf_putc(g_o, 10);
                    buf_puts_c(g_o, "    addq $");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, ", %rcx\n");
                    if (fw == Q_F32) {
                        buf_puts_c(g_o, "    movss %xmm0, (%rcx)\n");
                    } else {
                        buf_puts_c(g_o, "    movsd %xmm0, (%rcx)\n");
                    }
                } else {
                    buf_puts_c(g_o, "    leaq ");
                    buf_puts_c(g_o, base);
                    buf_puts_c(g_o, ", %rcx\n");
                    buf_puts_c(g_o, "    addq $");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, ", %rcx\n");
                    store_mem("(%rcx)", fw);
                }
                i = i + 1;
            }
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, base);
            buf_puts_c(g_o, ", %rax\n");
            return;
        }
    }
    mut XF* fni = null;
    if (e.callee != null && e.callee.kind == X_EX_VAR && vlen(e.callee.path) == 1) {
        fni = xfind_f(vec_get(e.callee.path, 0) as char*);
    }
    if (fni == null) {
        xerr("unknown callee (methods/dyn TODO in core)");
        return;
    }
    if (vlen(e.args) != vlen(fni.pt)) {
        xerr("wrong arity");
        return;
    }
    emit_call_general(e, fni);
    return;
}


fn emit_call_general(Expr* e, XF* fni) {
    Type* rt = fni.ret;
    mut i32 rw = Q_VOID;
    if (rt != null) {
        rw = ty_width(rt);
    }
    mut bool sret = !fni.is_ext && rw == Q_STRUCT;
    mut bool protect = false;
    mut u64 pi = 0;
    while (pi < vlen(e.args)) {
        if (expr_may_call(vec_get(e.args, pi) as Expr*)) {
            protect = true;
            break;
        }
        pi = pi + 1;
    }
    mut i32 tbase = 0;
    if (protect && vlen(e.args) > 0) {
        tbase = tmp_slot(vlen(e.args) as i32);
    }
    if (protect) {
        pi = 0;
        while (pi < vlen(e.args)) {
            Type* formal = vec_get(fni.pt, pi) as Type*;
            mut i32 aw = Q_I64;
            if (formal != null) {
                aw = ty_width(formal);
            }
            mut char* tm = slot_str(tbase + (pi as i32), null as char*);
            emit_val(vec_get(e.args, pi) as Expr*);
            if (aw == Q_F32) {
                buf_puts_c(g_o, "    movss %xmm0, ");
            } else if (aw == Q_F64) {
                buf_puts_c(g_o, "    movsd %xmm0, ");
            } else {
                buf_puts_c(g_o, "    movq %rax, ");
            }
            buf_puts_c(g_o, tm);
            buf_putc(g_o, 10);
            pi = pi + 1;
        }
        pi = 0;
        while (pi < vlen(e.args)) {
            Type* formal = vec_get(fni.pt, pi) as Type*;
            mut i32 aw = Q_I64;
            if (formal != null) {
                aw = ty_width(formal);
            }
            mut char* area = arg_home_area(pi as i32);
            mut char* tm = slot_str(tbase + (pi as i32), null as char*);
            if (aw == Q_STRUCT && formal != null) {
                mut i32 esz = ty_size(formal);
                buf_puts_c(g_o, "    movq ");
                buf_puts_c(g_o, tm);
                buf_puts_c(g_o, ", %rsi\n");
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, area);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, esz);
                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            } else if (aw == Q_F32) {
                buf_puts_c(g_o, "    movss ");
                buf_puts_c(g_o, tm);
                buf_puts_c(g_o, ", %xmm0\n");
                buf_puts_c(g_o, "    movss %xmm0, ");
                buf_puts_c(g_o, area);
                buf_putc(g_o, 10);
            } else if (aw == Q_F64) {
                buf_puts_c(g_o, "    movsd ");
                buf_puts_c(g_o, tm);
                buf_puts_c(g_o, ", %xmm0\n");
                buf_puts_c(g_o, "    movsd %xmm0, ");
                buf_puts_c(g_o, area);
                buf_putc(g_o, 10);
            } else {
                buf_puts_c(g_o, "    movq ");
                buf_puts_c(g_o, tm);
                buf_puts_c(g_o, ", %rax\n");
                store_mem(area, aw);
            }
            pi = pi + 1;
        }
    } else {
        pi = 0;
        while (pi < vlen(e.args)) {
            Type* formal = vec_get(fni.pt, pi) as Type*;
            mut i32 fw = Q_I64;
            if (formal != null) {
                fw = ty_width(formal);
            }
            mut char* area = arg_home_area(pi as i32);
            emit_val(vec_get(e.args, pi) as Expr*);
            if (fw == Q_STRUCT && formal != null) {
                mut i32 esz = ty_size(formal);
                buf_puts_c(g_o, "    movq %rax, %rsi\n");
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, area);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, esz);
                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            } else if (fw == Q_F32) {
                buf_puts_c(g_o, "    movss %xmm0, ");
                buf_puts_c(g_o, area);
                buf_putc(g_o, 10);
            } else if (fw == Q_F64) {
                buf_puts_c(g_o, "    movsd %xmm0, ");
                buf_puts_c(g_o, area);
                buf_putc(g_o, 10);
            } else {
                store_mem(area, fw);
            }
            pi = pi + 1;
        }
    }
    mut i32 sret_slot = -1;
    if (sret) {
        mut i32 slot = tmp_find(e as u64);
        if (slot < 0) {
            xerr("temp missing (walk/emit skew)");
            return;
        }
        mut char* m = slot_str(slot, null as char*);
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, m);
        buf_puts_c(g_o, ", %rdi\n");
        sret_slot = slot;
    }
    g_ipos = 0;
    g_fpos = 0;
    g_spos = 0;
    pi = 0;
    while (pi < vlen(e.args)) {
        arg_home(pi as i32, vec_get(fni.pt, pi) as Type*, sret);
        pi = pi + 1;
    }
    mut i32 stk_total = 0;
    if (g_spos > 0) {
        stk_total = g_spos * 8;
        if (g_spos % 2 == 1) {
            buf_puts_c(g_o, "    subq $8, %rsp\n");
            stk_total = stk_total + 8;
        }
        mut i32 j = g_spos - 1;
        while (j >= 0) {
            mut char* dst = slot_str(g_ob + j, null as char*);
            buf_puts_c(g_o, "    pushq ");
            buf_puts_c(g_o, dst);
            buf_putc(g_o, 10);
            j = j - 1;
        }
    }
    if (fni.is_ext) {
        buf_puts_c(g_o, "    call ");
        buf_puts_c(g_o, abi_map(fni.name));
        buf_puts_c(g_o, "@PLT\n");
    } else {
        buf_puts_c(g_o, "    call ");
        buf_puts_c(g_o, fni.name);
        buf_putc(g_o, 10);
    }
    if (stk_total > 0) {
        buf_puts_c(g_o, "    addq $");
        buf_puti(g_o, stk_total);
        buf_puts_c(g_o, ", %rsp\n");
    }
    if (sret) {
        mut char* m = slot_str(sret_slot, null as char*);
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, m);
        buf_puts_c(g_o, ", %rax\n");
    } else if (rw == Q_BOOL && fni.is_ext) {
        if (tk_streq(fni.name, "tk_streq")) {
            buf_puts_c(g_o, "    testl %eax, %eax\n    sete %al\n    movzbq %al, %rax\n");
        } else {
            buf_puts_c(g_o, "    testl %eax, %eax\n    setne %al\n    movzbq %al, %rax\n");
        }
    } else if (fni.is_ext && (rw == Q_I8 || rw == Q_I16 || rw == Q_I32 || rw == Q_CHAR)) {
        buf_puts_c(g_o, "    movslq %eax, %rax\n");
    } else if (fni.is_ext && (rw == Q_U8 || rw == Q_U16 || rw == Q_U32)) {
        buf_puts_c(g_o, "    movl %eax, %eax\n");
    }
    return;
}


fn xbind_add(Pat* p, Type* st) {
    if (p == null) {
        return;
    }
    if (p.kind == X_PAT_BIND || p.kind == X_PAT_REF) {
        mut i32 slots = 1;
        mut Type* vt = st;
        if (p.kind == X_PAT_REF) {
            vt = tcopy_star(st);
        } else if (st != null && ty_width(st) == Q_STRUCT) {
            slots = slots_for_size(ty_size(st));
        }
        xv_add(p.name, vt, slots);
        return;
    }
    if (p.kind != X_PAT_PATH || vlen(p.path) != 2) {
        return;
    }
    char* s0 = vec_get(p.path, 0) as char*;
    char* s1 = vec_get(p.path, 1) as char*;
    XE* en = xfind_e(s0);
    if (en == null || !en.payload) {
        return;
    }
    mut i32 vi = xfind_v(en, s1);
    if (vi < 0) {
        return;
    }
    mut XEV* vv = vec_get(en.vars, vi as u64) as XEV*;
    if (vv.kind == 1) {
        mut u64 i = 0;
        while (i < vlen(p.args)) {
            Pat* a = vec_get(p.args, i) as Pat*;
            if (a.kind != X_PAT_BIND && a.kind != X_PAT_REF) {
                i = i + 1;
                continue;
            }
            mut Type* ft = vec_get(vv.ts, i) as Type*;
            if (a.kind == X_PAT_REF) {
                ft = tcopy_star(ft);
                xv_add(a.name, ft, 1);
            } else {
                xv_add(a.name, ft, slots_for_size(ty_size(ft)));
            }
            i = i + 1;
        }
    } else if (vv.kind == 2) {
        mut u64 i = 0;
        while (i < vlen(p.fields)) {
            FP* fp = vec_get(p.fields, i) as FP*;
            Pat* sp = fp.pat;
            if (sp == null || (sp.kind != X_PAT_BIND && sp.kind != X_PAT_REF)) {
                i = i + 1;
                continue;
            }
            mut Type* ft = null;
            mut u64 j = 0;
            while (j < vlen(vv.fs)) {
                XEF* vf = vec_get(vv.fs, j) as XEF*;
                if (tk_streq(vf.nm, fp.field)) {
                    ft = vf.ty;
                }
                j = j + 1;
            }
            if (ft == null) {
                i = i + 1;
                continue;
            }
            if (sp.kind == X_PAT_REF) {
                xv_add(sp.name, tcopy_star(ft), 1);
            } else {
                xv_add(sp.name, ft, slots_for_size(ty_size(ft)));
            }
            i = i + 1;
        }
    }
    return;
}

fn xbind_copy(Pat* p, i32 mslot, Type* st) {
    mut char* mm = slot_str(mslot, null as char*);
    if (p.kind == X_PAT_REF) {
        XV* v = xv_find(p.name);
        if (v == null) {
            xerr("binding missing");
            return;
        }
        mut char* dst = slot_str(v.slot, v.name);
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, mm);
        buf_puts_c(g_o, ", %rax\n");
        buf_puts_c(g_o, "    movq %rax, ");
        buf_puts_c(g_o, dst);
        buf_putc(g_o, 10);
        return;
    }
    if (p.kind == X_PAT_BIND) {
        XV* v = xv_find(p.name);
        if (v == null) {
            xerr("binding missing");
            return;
        }
        mut char* dst = slot_str(v.slot, v.name);
        if (st != null && ty_width(st) == Q_STRUCT) {
            mut i32 sz = ty_size(st);
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, mm);
            buf_puts_c(g_o, ", %rsi\n");
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, dst);
            buf_puts_c(g_o, ", %rdi\n");
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, sz);
            buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
        } else if (st != null && (ty_width(st) == Q_F32 || ty_width(st) == Q_F64)) {
            if (ty_width(st) == Q_F32) {
                buf_puts_c(g_o, "    movss ");
            } else {
                buf_puts_c(g_o, "    movsd ");
            }
            buf_puts_c(g_o, mm);
            buf_puts_c(g_o, ", %xmm0\n");
            if (ty_width(st) == Q_F32) {
                buf_puts_c(g_o, "    movss %xmm0, ");
            } else {
                buf_puts_c(g_o, "    movsd %xmm0, ");
            }
            buf_puts_c(g_o, dst);
            buf_putc(g_o, 10);
        } else {
            mut i32 sw = Q_I64;
            if (st != null) {
                sw = ty_width(st);
            }
            if (sw == Q_STRUCT) {
                sw = Q_I64;
            }
            buf_puts_c(g_o, "    movq ");
            buf_puts_c(g_o, mm);
            buf_puts_c(g_o, ", %rax\n");
            if (sw != Q_I64 && sw != Q_U64 && sw != Q_PTR) {
                if (sw == Q_I8 || sw == Q_I16 || sw == Q_I32 || sw == Q_CHAR) {
                    buf_puts_c(g_o, "    movslq %eax, %rax\n");
                } else {
                    buf_puts_c(g_o, "    movl %eax, %eax\n");
                }
            }
            store_mem(dst, sw);
        }
        return;
    }
    if (p.kind != X_PAT_PATH || vlen(p.path) != 2) {
        return;
    }
    char* s0 = vec_get(p.path, 0) as char*;
    char* s1 = vec_get(p.path, 1) as char*;
    XE* en = xfind_e(s0);
    if (en == null || !en.payload) {
        return;
    }
    mut i32 vi = xfind_v(en, s1);
    if (vi < 0) {
        return;
    }
    mut XEV* vv = vec_get(en.vars, vi as u64) as XEV*;
    if (vv.kind == 1) {
        mut u64 i = 0;
        while (i < vlen(p.args)) {
            Pat* a = vec_get(p.args, i) as Pat*;
            if (a.kind != X_PAT_BIND && a.kind != X_PAT_REF) {
                i = i + 1;
                continue;
            }
            XV* v = xv_find(a.name);
            if (v == null) {
                xerr("binding missing");
                i = i + 1;
                continue;
            }
            mut Type* ft = vec_get(vv.ts, i) as Type*;
            mut i32 fw = ty_width(ft);
            mut i32 off = tuple_field_off(en, vi, i as i32);
            mut char* dst = slot_str(v.slot, v.name);
            if (a.kind == X_PAT_REF) {
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, mm);
                buf_puts_c(g_o, ", %rax\n");
                if (off != 0) {
                    buf_puts_c(g_o, "    addq $");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, ", %rax\n");
                }
                buf_puts_c(g_o, "    movq %rax, ");
                buf_puts_c(g_o, dst);
                buf_putc(g_o, 10);
                i = i + 1;
                continue;
            }
            if (fw == Q_STRUCT) {
                mut i32 esz = ty_size(ft);
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, mm);
                buf_puts_c(g_o, ", %rsi\n");
                buf_puts_c(g_o, "    addq $");
                buf_puti(g_o, off);
                buf_puts_c(g_o, ", %rsi\n");
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, dst);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, esz);
                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            } else if (fw == Q_F32 || fw == Q_F64) {
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, mm);
                buf_putc(g_o, 10);
                if (fw == Q_F32) {
                    buf_puts_c(g_o, "    movss ");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, "(%rcx), %xmm0\n");
                } else {
                    buf_puts_c(g_o, "    movsd ");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, "(%rcx), %xmm0\n");
                }
                if (fw == Q_F32) {
                    buf_puts_c(g_o, "    movss %xmm0, ");
                } else {
                    buf_puts_c(g_o, "    movsd %xmm0, ");
                }
                buf_puts_c(g_o, dst);
                buf_putc(g_o, 10);
            } else {
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, mm);
                buf_puts_c(g_o, ", %rcx\n");
                u8* sb = arena_alloc(g_ar, 32);
                mut u64 o = 0;
                sview osv = i32_to_str(off, g_ar);
                mut u64 q = 0;
                while (q < osv.len as u64) {
                    sb[o] = osv.ptr[q];
                    o = o + 1;
                    q = q + 1;
                }
                sb[o] = 40;
                sb[o + 1] = 37;
                sb[o + 2] = 114;
                sb[o + 3] = 99;
                sb[o + 4] = 120;
                sb[o + 5] = 41;
                sb[o + 6] = 0;
                mut char* src = sb as char*;
                if (fw == Q_I8 || fw == Q_CHAR) {
                    buf_puts_c(g_o, "    movsbq ");
                } else if (fw == Q_U8 || fw == Q_BOOL) {
                    buf_puts_c(g_o, "    movzbq ");
                } else if (fw == Q_I16) {
                    buf_puts_c(g_o, "    movswq ");
                } else if (fw == Q_U16) {
                    buf_puts_c(g_o, "    movzwq ");
                } else if (fw == Q_I32) {
                    buf_puts_c(g_o, "    movslq ");
                } else if (fw == Q_U32) {
                    buf_puts_c(g_o, "    movl ");
                } else {
                    buf_puts_c(g_o, "    movq ");
                }
                buf_puts_c(g_o, src);
                if (fw == Q_U32) {
                    buf_puts_c(g_o, ", %eax\n");
                } else {
                    buf_puts_c(g_o, ", %rax\n");
                }
                store_mem(dst, fw);
            }
            i = i + 1;
        }
    } else if (vv.kind == 2) {
        mut u64 i = 0;
        while (i < vlen(p.fields)) {
            FP* fp = vec_get(p.fields, i) as FP*;
            Pat* sp = fp.pat;
            if (sp == null || (sp.kind != X_PAT_BIND && sp.kind != X_PAT_REF)) {
                i = i + 1;
                continue;
            }
            mut Type* ft = null;
            mut u64 j = 0;
            while (j < vlen(vv.fs)) {
                XEF* vf = vec_get(vv.fs, j) as XEF*;
                if (tk_streq(vf.nm, fp.field)) {
                    ft = vf.ty;
                }
                j = j + 1;
            }
            if (ft == null) {
                i = i + 1;
                continue;
            }
            mut i32 fw = ty_width(ft);
            mut i32 off = struct_field_off(en, vi, fp.field);
            XV* v = xv_find(sp.name);
            if (v == null) {
                xerr("binding missing");
                i = i + 1;
                continue;
            }
            mut char* dst = slot_str(v.slot, v.name);
            if (sp.kind == X_PAT_REF) {
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, mm);
                buf_puts_c(g_o, ", %rax\n");
                if (off != 0) {
                    buf_puts_c(g_o, "    addq $");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, ", %rax\n");
                }
                buf_puts_c(g_o, "    movq %rax, ");
                buf_puts_c(g_o, dst);
                buf_putc(g_o, 10);
                i = i + 1;
                continue;
            }
            if (fw == Q_STRUCT) {
                mut i32 esz = ty_size(ft);
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, mm);
                buf_puts_c(g_o, ", %rsi\n");
                buf_puts_c(g_o, "    addq $");
                buf_puti(g_o, off);
                buf_puts_c(g_o, ", %rsi\n");
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, dst);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, esz);
                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            } else if (fw == Q_F32 || fw == Q_F64) {
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, mm);
                buf_putc(g_o, 10);
                if (fw == Q_F32) {
                    buf_puts_c(g_o, "    movss ");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, "(%rcx), %xmm0\n");
                } else {
                    buf_puts_c(g_o, "    movsd ");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, "(%rcx), %xmm0\n");
                }
                if (fw == Q_F32) {
                    buf_puts_c(g_o, "    movss %xmm0, ");
                } else {
                    buf_puts_c(g_o, "    movsd %xmm0, ");
                }
                buf_puts_c(g_o, dst);
                buf_putc(g_o, 10);
            } else {
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, mm);
                buf_puts_c(g_o, ", %rcx\n");
                u8* sb = arena_alloc(g_ar, 32);
                mut u64 o = 0;
                sview osv = i32_to_str(off, g_ar);
                mut u64 q = 0;
                while (q < osv.len as u64) {
                    sb[o] = osv.ptr[q];
                    o = o + 1;
                    q = q + 1;
                }
                sb[o] = 40;
                sb[o + 1] = 37;
                sb[o + 2] = 114;
                sb[o + 3] = 99;
                sb[o + 4] = 120;
                sb[o + 5] = 41;
                sb[o + 6] = 0;
                mut char* src = sb as char*;
                if (fw == Q_I8 || fw == Q_CHAR) {
                    buf_puts_c(g_o, "    movsbq ");
                } else if (fw == Q_U8 || fw == Q_BOOL) {
                    buf_puts_c(g_o, "    movzbq ");
                } else if (fw == Q_I16) {
                    buf_puts_c(g_o, "    movswq ");
                } else if (fw == Q_U16) {
                    buf_puts_c(g_o, "    movzwq ");
                } else if (fw == Q_I32) {
                    buf_puts_c(g_o, "    movslq ");
                } else if (fw == Q_U32) {
                    buf_puts_c(g_o, "    movl ");
                } else {
                    buf_puts_c(g_o, "    movq ");
                }
                buf_puts_c(g_o, src);
                if (fw == Q_U32) {
                    buf_puts_c(g_o, ", %eax\n");
                } else {
                    buf_puts_c(g_o, ", %rax\n");
                }
                store_mem(dst, fw);
            }
            i = i + 1;
        }
    }
    return;
}


fn xalt_bool(Pat* p, i32 mslot, Type* st) {
    mut char* mm = slot_str(mslot, null as char*);
    if (p.kind == X_PAT_WILD || p.kind == X_PAT_BIND || p.kind == X_PAT_REF) {
        buf_puts_c(g_o, "    movb $1, %al\n");
        return;
    }
    if (p.kind == X_PAT_LIT) {
        if (p.tkind == K_TRUE) {
            mut i32 sw = Q_I64;
            if (st != null) {
                sw = ty_width(st);
            }
            if (sw == Q_STRUCT) {
                xerr("literal pattern on struct scrutinee");
                buf_puts_c(g_o, "    xorb %al, %al\n");
                return;
            }
            load_mem(mm, sw);
            buf_puts_c(g_o, "    testq %rax, %rax\n    setne %al\n");
            return;
        }
        if (p.tkind == K_FALSE) {
            mut i32 sw = Q_I64;
            if (st != null) {
                sw = ty_width(st);
            }
            if (sw == Q_STRUCT) {
                xerr("literal pattern on struct scrutinee");
                buf_puts_c(g_o, "    xorb %al, %al\n");
                return;
            }
            load_mem(mm, sw);
            buf_puts_c(g_o, "    testq %rax, %rax\n    setz %al\n");
            return;
        }
        if (p.tkind == K_STRING) {
            xerr("string patterns TODO in native backend");
            buf_puts_c(g_o, "    xorb %al, %al\n");
            return;
        }
        if (p.tkind == K_FLOAT) {
            xerr("float patterns TODO in native backend");
            buf_puts_c(g_o, "    xorb %al, %al\n");
            return;
        }
        mut i32 sw = Q_I64;
        if (st != null) {
            sw = ty_width(st);
        }
        if (sw == Q_STRUCT) {
            xerr("literal pattern on struct scrutinee");
            buf_puts_c(g_o, "    xorb %al, %al\n");
            return;
        }
        if (sw == Q_F32 || sw == Q_F64) {
            xerr("float patterns TODO in native backend");
            buf_puts_c(g_o, "    xorb %al, %al\n");
            return;
        }
        load_mem(mm, sw);
        if (sw != Q_I64 && sw != Q_U64 && sw != Q_PTR) {
            if (sw == Q_I8 || sw == Q_I16 || sw == Q_I32 || sw == Q_CHAR) {
                buf_puts_c(g_o, "    movslq %eax, %rax\n");
            } else {
                buf_puts_c(g_o, "    movl %eax, %eax\n");
            }
        }
        mut u64 lit = 0;
        if (p.tkind == K_CHAR) {
            i64 cv = lit_char_val(p.tstart, p.tlen);
            if (cv < 0) {
                xerr("bad char pattern");
                buf_puts_c(g_o, "    xorb %al, %al\n");
                return;
            }
            lit = cv as u64;
        } else {
            lit = lit_int_bits(p.tstart, p.tlen);
        }
        if (lit <= 2147483647) {
            buf_puts_c(g_o, "    cmpq $");
            buf_putu(g_o, lit);
            buf_puts_c(g_o, ", %rax\n");
        } else {
            buf_puts_c(g_o, "    movabsq $");
            buf_putu(g_o, lit);
            buf_puts_c(g_o, ", %rcx\n    cmpq %rcx, %rax\n");
        }
        buf_puts_c(g_o, "    sete %al\n");
        return;
    }
    if (p.kind == X_PAT_PATH) {
        if (vlen(p.path) != 2) {
            xerr("qualified Enum::Variant needed in patterns");
            buf_puts_c(g_o, "    xorb %al, %al\n");
            return;
        }
        char* s0 = vec_get(p.path, 0) as char*;
        char* s1 = vec_get(p.path, 1) as char*;
        XE* en = xfind_e(s0);
        if (en == null) {
            xerr("unknown enum in pattern");
            buf_puts_c(g_o, "    xorb %al, %al\n");
            return;
        }
        mut i32 vi = xfind_v(en, s1);
        if (vi < 0) {
            xerr("unknown variant in pattern");
            buf_puts_c(g_o, "    xorb %al, %al\n");
            return;
        }
        mut XEV* vv = vec_get(en.vars, vi as u64) as XEV*;
        if (!en.payload) {
            load_mem(mm, Q_I32);
            buf_puts_c(g_o, "    cmpl $");
            buf_puti(g_o, vv.disc);
            buf_puts_c(g_o, ", %eax\n    sete %al\n");
            return;
        }
        buf_puts_c(g_o, "    cmpl $");
        buf_puti(g_o, vi);
        buf_puts_c(g_o, ", ");
        buf_puts_c(g_o, mm);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, "    sete %al\n");
        if (vv.kind == 1) {
            mut u64 i = 0;
            while (i < vlen(p.args)) {
                Pat* a = vec_get(p.args, i) as Pat*;
                if (a.kind == X_PAT_LIT) {
                    mut i32 off = tuple_field_off(en, vi, i as i32);
                    mut u64 lit = 0;
                    if (a.tkind == K_CHAR) {
                        i64 cv = lit_char_val(a.tstart, a.tlen);
                        if (cv < 0) {
                            xerr("bad char pattern");
                            i = i + 1;
                            continue;
                        }
                        lit = cv as u64;
                    } else if (a.tkind != K_INT) {
                        xerr("int/char literal patterns only in core");
                        i = i + 1;
                        continue;
                    } else {
                        lit = lit_int_bits(a.tstart, a.tlen);
                    }
                    buf_puts_c(g_o, "    pushq %rax\n");
                    buf_puts_c(g_o, "    leaq ");
                    buf_puts_c(g_o, mm);
                    buf_puts_c(g_o, ", %rcx\n");
                    buf_puts_c(g_o, "    addq $");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, ", %rcx\n");
                    buf_puts_c(g_o, "    movq (%rcx), %rcx\n");
                    buf_puts_c(g_o, "    cmpq $");
                    buf_putu(g_o, lit);
                    buf_puts_c(g_o, ", %rcx\n");
                    buf_puts_c(g_o, "    sete %cl\n");
                    buf_puts_c(g_o, "    andb %cl, (%rsp)\n");
                    buf_puts_c(g_o, "    popq %rax\n");
                } else if (a.kind != X_PAT_BIND && a.kind != X_PAT_WILD && a.kind != X_PAT_REF) {
                    xerr("nested patterns TODO in native backend");
                }
                i = i + 1;
            }
        } else if (vv.kind == 2) {
            mut u64 i = 0;
            while (i < vlen(p.fields)) {
                FP* fp = vec_get(p.fields, i) as FP*;
                Pat* sp = fp.pat;
                if (sp != null && sp.kind == X_PAT_LIT) {
                    mut i32 off = struct_field_off(en, vi, fp.field);
                    mut u64 lit = lit_int_bits(sp.tstart, sp.tlen);
                    buf_puts_c(g_o, "    pushq %rax\n");
                    buf_puts_c(g_o, "    leaq ");
                    buf_puts_c(g_o, mm);
                    buf_puts_c(g_o, ", %rcx\n");
                    buf_puts_c(g_o, "    addq $");
                    buf_puti(g_o, off);
                    buf_puts_c(g_o, ", %rcx\n");
                    buf_puts_c(g_o, "    movq (%rcx), %rcx\n");
                    buf_puts_c(g_o, "    cmpq $");
                    buf_putu(g_o, lit);
                    buf_puts_c(g_o, ", %rcx\n");
                    buf_puts_c(g_o, "    sete %cl\n");
                    buf_puts_c(g_o, "    andb %cl, (%rsp)\n");
                    buf_puts_c(g_o, "    popq %rax\n");
                } else if (sp == null || (sp.kind != X_PAT_BIND && sp.kind != X_PAT_WILD && sp.kind != X_PAT_REF)) {
                    xerr("nested patterns TODO in native backend");
                }
                i = i + 1;
            }
        }
        return;
    }
    return;
}

fn emit_match_value(Expr* m, i32 tgt_slot, Type* tgt_ty) {
    mut i32 mslot = tmp_find(m as u64);
    mut i32 dslot = tmp_find((m as u64) + 1);
    if (mslot < 0 || dslot < 0) {
        xerr("temp missing (walk/emit skew)");
        return;
    }
    mut char* mm = slot_str(mslot, null as char*);
    mut char* dm = slot_str(dslot, null as char*);
    mut char* tm = slot_str(tgt_slot, null as char*);
    emit_val(m.scrut);
    Type* st = xinfer(m.scrut);
    if (st != null && ty_width(st) == Q_STRUCT) {
        mut i32 sz = ty_size(st);
        buf_puts_c(g_o, "    movq %rax, %rsi\n");
        buf_puts_c(g_o, "    leaq ");
        buf_puts_c(g_o, mm);
        buf_puts_c(g_o, ", %rdi\n");
        buf_puts_c(g_o, "    movl $");
        buf_puti(g_o, sz);
        buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
    } else if (st != null && (ty_width(st) == Q_F32 || ty_width(st) == Q_F64)) {
        if (ty_width(st) == Q_F32) {
            buf_puts_c(g_o, "    movss %xmm0, ");
        } else {
            buf_puts_c(g_o, "    movsd %xmm0, ");
        }
        buf_puts_c(g_o, mm);
        buf_putc(g_o, 10);
    } else {
        buf_puts_c(g_o, "    movq %rax, ");
        buf_puts_c(g_o, mm);
        buf_putc(g_o, 10);
    }
    buf_puts_c(g_o, "    movq $0, ");
    buf_puts_c(g_o, dm);
    buf_putc(g_o, 10);
    mut i32 tw = Q_I64;
    if (tgt_ty != null) {
        tw = ty_width(tgt_ty);
    }
    mut u64 i = 0;
    while (i < vlen(m.arms)) {
        ArmE* am = vec_get(m.arms, i) as ArmE*;
        mut i32 lbody = new_lbl();
        mut i32 lnext = new_lbl();
        buf_puts_c(g_o, "    cmpb $0, ");
        buf_puts_c(g_o, dm);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, "    jne .L");
        buf_puti(g_o, lnext);
        buf_putc(g_o, 10);
        xalt_bool(am.pat, mslot, st);
        buf_puts_c(g_o, "    testb %al, %al\n    jnz .L");
        buf_puti(g_o, lbody);
        buf_putc(g_o, 10);
        mut u64 k = 0;
        while (k < vlen(am.pat.or_next) && k < 8) {
            xalt_bool(vec_get(am.pat.or_next, k) as Pat*, mslot, st);
            buf_puts_c(g_o, "    testb %al, %al\n    jnz .L");
            buf_puti(g_o, lbody);
            buf_putc(g_o, 10);
            k = k + 1;
        }
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, lnext);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lbody);
        buf_puts_c(g_o, ":\n");
        xv_push();
        xbind_add(am.pat, st);
        xbind_copy(am.pat, mslot, st);
        if (am.guard != null) {
            emit_val(am.guard);
            buf_puts_c(g_o, "    testq %rax, %rax\n");
            mut i32 lskip = new_lbl();
            buf_puts_c(g_o, "    jz .L");
            buf_puti(g_o, lskip);
            buf_putc(g_o, 10);
            emit_val(am.body);
            if (tw == Q_STRUCT && tgt_ty != null) {
                mut i32 esz = ty_size(tgt_ty);
                buf_puts_c(g_o, "    movq %rax, %rsi\n");
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, tm);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, esz);
                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            } else if (tw == Q_F32 || tw == Q_F64) {
                if (tw == Q_F32) {
                    buf_puts_c(g_o, "    movss %xmm0, ");
                } else {
                    buf_puts_c(g_o, "    movsd %xmm0, ");
                }
                buf_puts_c(g_o, tm);
                buf_putc(g_o, 10);
            } else {
                Type* bt2 = xinfer(am.body);
                mut i32 bw = Q_I64;
                if (bt2 != null) {
                    bw = ty_width(bt2);
                }
                to_width(bw, tw);
                store_mem(tm, tw);
            }
            buf_puts_c(g_o, "    movq $1, ");
            buf_puts_c(g_o, dm);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, ".L");
            buf_puti(g_o, lskip);
            buf_puts_c(g_o, ":\n");
        } else {
            emit_val(am.body);
            if (tw == Q_STRUCT && tgt_ty != null) {
                mut i32 esz = ty_size(tgt_ty);
                buf_puts_c(g_o, "    movq %rax, %rsi\n");
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, tm);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, esz);
                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            } else if (tw == Q_F32 || tw == Q_F64) {
                if (tw == Q_F32) {
                    buf_puts_c(g_o, "    movss %xmm0, ");
                } else {
                    buf_puts_c(g_o, "    movsd %xmm0, ");
                }
                buf_puts_c(g_o, tm);
                buf_putc(g_o, 10);
            } else {
                Type* bt2 = xinfer(am.body);
                mut i32 bw = Q_I64;
                if (bt2 != null) {
                    bw = ty_width(bt2);
                }
                to_width(bw, tw);
                store_mem(tm, tw);
            }
            buf_puts_c(g_o, "    movq $1, ");
            buf_puts_c(g_o, dm);
            buf_putc(g_o, 10);
        }
        xv_pop();
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lnext);
        buf_puts_c(g_o, ":\n");
        i = i + 1;
    }
    return;
}


fn build_tables(Vec* items) {
    mut u64 i = 0;
    while (i < vlen(items)) {
        Item* it = vec_get(items, i) as Item*;
        if (it.kind == X_IT_STRUCT) {
            u8* sm = tk_malloc(32);
            XS* s = sm as XS*;
            s.name = it.sname;
            s.fields = vec_new();
            s.size = 0;
            s.align = 1;
            g_xss = vpush(g_xss, s as u8*);
            mut i32 off = 0;
            mut i32 al = 1;
            mut u64 j = 0;
            while (j < vlen(it.fields)) {
                SFld* ff = vec_get(it.fields, j) as SFld*;
                i32 a = ty_align(ff.ty);
                if (a > al) {
                    al = a;
                }
                off = align_up(off, a);
                u8* fm = tk_malloc(24);
                XSRow* fr = fm as XSRow*;
                fr.nm = ff.nm;
                fr.ty = ff.ty;
                fr.off = off;
                s.fields = vpush(s.fields, fr as u8*);
                off = off + ty_size(ff.ty);
                j = j + 1;
            }
            s.size = align_up(off, al);
            s.align = al;
            j = 0;
            while (j < vlen(it.fields)) {
                SFld* ff = vec_get(it.fields, j) as SFld*;
                xcollect_ty(ff.ty);
                j = j + 1;
            }
        } else if (it.kind == X_IT_ENUM) {
            u8* em = tk_malloc(24);
            XE* e = em as XE*;
            e.name = it.ename;
            e.payload = false;
            e.vars = vec_new();
            g_xes = vpush(g_xes, e as u8*);
            mut i32 disc_next = 0;
            mut u64 j = 0;
            while (j < vlen(it.vars)) {
                mut Variant* vv = vec_get(it.vars, j) as Variant*;
                u8* xm = tk_malloc(40);
                XEV* xv = xm as XEV*;
                xv.vn = vv.vn;
                xv.kind = 0;
                xv.ts = vec_new();
                xv.fs = vec_new();
                xv.disc = 0;
                e.vars = vpush(e.vars, xv as u8*);
                if (vv.has_tuple || vv.has_struct) {
                    e.payload = true;
                    if (vv.has_tuple) {
                        xv.kind = 1;
                        mut u64 k = 0;
                        while (k < vlen(vv.ts)) {
                            Type* t = vec_get(vv.ts, k) as Type*;
                            xv.ts = vpush(xv.ts, t as u8*);
                            xcollect_ty(t);
                            k = k + 1;
                        }
                    } else {
                        xv.kind = 2;
                        mut u64 k = 0;
                        while (k < vlen(vv.fs)) {
                            SFld* vf = vec_get(vv.fs, k) as SFld*;
                            u8* fm = tk_malloc(16);
                            XEF* nf = fm as XEF*;
                            nf.nm = vf.nm;
                            nf.ty = vf.ty;
                            xv.fs = vpush(xv.fs, nf as u8*);
                            xcollect_ty(vf.ty);
                            k = k + 1;
                        }
                    }
                } else {
                    xv.kind = 0;
                    if (vv.has_disc) {
                        if (const_int_ok(vv.disc)) {
                            xv.disc = const_int_val(vv.disc);
                        } else {
                            xerr("non-const enum discriminant");
                            xv.disc = disc_next;
                        }
                        disc_next = xv.disc + 1;
                    } else {
                        xv.disc = disc_next;
                        disc_next = disc_next + 1;
                    }
                }
                j = j + 1;
            }
        } else if (it.kind == X_IT_FN || it.kind == X_IT_EXTERN) {
            u8* fm = tk_malloc(32);
            XF* f = fm as XF*;
            f.name = it.fn_name;
            f.ret = it.ret;
            f.pt = vec_new();
            f.pnm = vec_new();
            if (it.kind == X_IT_EXTERN) {
                f.is_ext = true;
            }
            g_xfs = vpush(g_xfs, f as u8*);
            mut u64 j = 0;
            while (j < vlen(it.params)) {
                Param* pp = vec_get(it.params, j) as Param*;
                f.pt = vpush(f.pt, pp.ty as u8*);
                f.pnm = vpush(f.pnm, pp.nm as u8*);
                j = j + 1;
            }
            j = 0;
            while (j < vlen(it.params)) {
                Param* pp = vec_get(it.params, j) as Param*;
                xcollect_ty(pp.ty);
                j = j + 1;
            }
            xcollect_ty(it.ret);
        } else if (it.kind == X_IT_GLOBAL) {
            Stmt* d = it.gdecl;
            xcollect_ty(d.ty);
        }
        i = i + 1;
    }
    return;
}


mut i32 g_maxargs = 0;
mut Type* g_wcurret = null;



fn wt_pop() {
    g_wtdepth = g_wtdepth - 1;
    while (vlen(g_wts) > 0) {
        mut WT* w = vec_get(g_wts, vlen(g_wts) - 1) as WT*;
        if (w.depth > g_wtdepth) {
            g_wts.len = g_wts.len - 1;
        } else {
            break;
        }
    }
    return;
}

fn wt_truncate() {
    while (vlen(g_wts) > 0) {
        mut WT* w = vec_get(g_wts, vlen(g_wts) - 1) as WT*;
        if (w.depth > g_wtdepth) {
            g_wts.len = g_wts.len - 1;
        } else {
            break;
        }
    }
    return;
}

fn walk_pat_types(Pat* p) {
    if (p == null) {
        return;
    }
    if (p.kind == X_PAT_BIND) {
        wt_add(p.name, null as Type*);
        g_frameslots = g_frameslots + 1;
        return;
    }
    if (p.kind == X_PAT_REF) {
        wt_add(p.name, null as Type*);
        g_frameslots = g_frameslots + 1;
        return;
    }
    if (p.kind != X_PAT_PATH) {
        return;
    }
    if (vlen(p.path) == 2) {
        char* s0 = vec_get(p.path, 0) as char*;
        char* s1 = vec_get(p.path, 1) as char*;
        XE* en = xfind_e(s0);
        mut i32 vi = -1;
        if (en != null) {
            vi = xfind_v(en, s1);
        }
        if (en != null && vi >= 0 && en.payload) {
            mut XEV* vv = vec_get(en.vars, vi as u64) as XEV*;
            if (vv.kind == 1) {
                mut u64 i = 0;
                while (i < vlen(p.args)) {
                    Pat* a = vec_get(p.args, i) as Pat*;
                    if (a.kind == X_PAT_BIND) {
                        mut Type* ft = vec_get(vv.ts, i) as Type*;
                        wt_add(a.name, ft);
                        g_frameslots = g_frameslots + slots_for_size(ty_size(ft));
                        xcollect_ty(ft);
                    } else {
                        walk_pat_types(a);
                    }
                    i = i + 1;
                }
                return;
            } else if (vv.kind == 2) {
                mut u64 i = 0;
                while (i < vlen(p.fields)) {
                    FP* fp = vec_get(p.fields, i) as FP*;
                    Pat* sp = fp.pat;
                    mut Type* ft = null;
                    mut u64 j = 0;
                    while (j < vlen(vv.fs)) {
                        XEF* vf = vec_get(vv.fs, j) as XEF*;
                        if (tk_streq(vf.nm, fp.field)) {
                            ft = vf.ty;
                        }
                        j = j + 1;
                    }
                    if (sp != null && sp.kind == X_PAT_BIND) {
                        wt_add(sp.name, ft);
                        if (ft != null) {
                            g_frameslots = g_frameslots + slots_for_size(ty_size(ft));
                        } else {
                            g_frameslots = g_frameslots + 1;
                        }
                        if (ft != null) {
                            xcollect_ty(ft);
                        }
                    } else {
                        walk_pat_types(sp);
                    }
                    i = i + 1;
                }
                return;
            }
        }
    }
    mut u64 i = 0;
    while (i < vlen(p.args)) {
        walk_pat_types(vec_get(p.args, i) as Pat*);
        i = i + 1;
    }
    i = 0;
    while (i < vlen(p.fields)) {
        FP* fp = vec_get(p.fields, i) as FP*;
        walk_pat_types(fp.pat);
        i = i + 1;
    }
    i = 0;
    while (i < vlen(p.or_next)) {
        walk_pat_types(vec_get(p.or_next, i) as Pat*);
        i = i + 1;
    }
    return;
}

fn walk_match_tmps(Expr* m) {
    Type* st = xinfer(m.scrut);
    mut i32 sz = 8;
    if (st != null) {
        sz = ty_size(st);
    }
    if (sz <= 0) {
        sz = 8;
    }
    tmp_for(m as u64, slots_for_size(sz));
    tmp_for((m as u64) + 1, 1);
    return;
}

fn walk_expr(Expr* e) {
    if (e == null) {
        return;
    }
    if (e.kind == X_EX_STRUCT_LIT) {
        Type* t = xinfer(e);
        mut i32 sz = 8;
        if (t != null) {
            sz = ty_size(t);
        }
        if (sz <= 0) {
            sz = 8;
        }
        tmp_for(e as u64, slots_for_size(sz));
        mut u64 i = 0;
        while (i < vlen(e.sfields)) {
            SF* sf = vec_get(e.sfields, i) as SF*;
            walk_expr(sf.e);
            i = i + 1;
        }
        return;
    }
    if (e.kind == X_EX_VAR) {
        if (vlen(e.path) == 2) {
            char* s0 = vec_get(e.path, 0) as char*;
            char* s1 = vec_get(e.path, 1) as char*;
            XE* en = xfind_e(s0);
            if (en != null && en.payload) {
                mut i32 vi = xfind_v(en, s1);
                mut XEV* vv = null;
                if (vi >= 0) {
                    vv = vec_get(en.vars, vi as u64) as XEV*;
                }
                if (vi >= 0 && vv != null && vv.kind == 0) {
                    tmp_for(e as u64, enum_slots(en));
                }
            }
        }
        return;
    }
    if (e.kind == X_EX_CALL) {
        walk_expr(e.callee);
        mut u64 i = 0;
        while (i < vlen(e.args)) {
            walk_expr(vec_get(e.args, i) as Expr*);
            i = i + 1;
        }
        if (vlen(e.args) as i32 > g_maxargs) {
            g_maxargs = vlen(e.args) as i32;
        }
        if (e.callee != null && e.callee.kind == X_EX_FIELD && tk_streq(e.callee.field, "push") && e.callee.callee != null) {
            Type* bt = xinfer(e.callee.callee);
            if (bt != null && bt.kind == X_TY_PATH && vlen(bt.path) == 1) {
                char* s0 = vec_get(bt.path, 0) as char*;
                if (tk_streq(s0, "List") && vlen(bt.gargs) == 1 && bt.stars == 0 && !bt.is_ref) {
                    if ((vlen(e.args) as i32) + 1 > g_maxargs) {
                        g_maxargs = (vlen(e.args) as i32) + 1;
                    }
                }
            }
        }
        if (e.callee != null && e.callee.kind == X_EX_VAR && vlen(e.callee.path) == 1) {
            char* cn = vec_get(e.callee.path, 0) as char*;
            if (!is_print_like(cn)) {
                if (tk_streq(cn, "tk_sview") || tk_streq(cn, "tk_sview_u8")) {
                    tmp_for(e as u64, 2);
                    return;
                }
                XF* f = xfind_f(cn);
                if (f != null && !f.is_ext && f.ret != null && ty_width(f.ret) == Q_STRUCT) {
                    tmp_for(e as u64, slots_for_size(ty_size(f.ret)));
                }
                if (f != null && f.is_ext && f.ret != null && f.ret.kind == X_TY_PRIM && f.ret.prim == K_SVIEW) {
                    tmp_for(e as u64, 2);
                }
            }
        }
        if (e.callee != null && e.callee.kind == X_EX_VAR && vlen(e.callee.path) == 2) {
            char* s0 = vec_get(e.callee.path, 0) as char*;
            XE* en = xfind_e(s0);
            if (en != null && en.payload) {
                tmp_for(e as u64, enum_slots(en));
            }
        }
        return;
    }
    if (e.kind == X_EX_PAREN) {
        walk_expr(e.lhs);
        return;
    }
    if (e.kind == X_EX_UNARY) {
        walk_expr(e.lhs);
        if (e.op == K_STAR) {
            Type* et = xinfer(e);
            if (et != null && ty_width(et) == Q_STRUCT) {
                tmp_for(e as u64, slots_for_size(ty_size(et)));
            }
        }
        return;
    }
    if (e.kind == X_EX_BINARY) {
        walk_expr(e.lhs);
        walk_expr(e.rhs);
        return;
    }
    if (e.kind == X_EX_TERNARY) {
        walk_expr(e.cond);
        walk_expr(e.then_e);
        walk_expr(e.else_e);
        return;
    }
    if (e.kind == X_EX_BLOCK) {
        g_wtdepth = g_wtdepth + 1;
        walk_stmts(e.stmts, e.trailing);
        wt_pop();
        return;
    }
    if (e.kind == X_EX_CAST) {
        walk_expr(e.lhs);
        return;
    }
    if (e.kind == X_EX_INDEX) {
        walk_expr(e.callee);
        walk_expr(e.index);
        Type* et = xinfer(e);
        if (et != null && ty_width(et) == Q_STRUCT) {
            tmp_for(e as u64, slots_for_size(ty_size(et)));
        }
        return;
    }
    if (e.kind == X_EX_FIELD) {
        walk_expr(e.callee);
        Type* et = xinfer(e);
        if (et != null && ty_width(et) == Q_STRUCT) {
            tmp_for(e as u64, slots_for_size(ty_size(et)));
        }
        return;
    }
    if (e.kind == X_EX_ARRAY_LIST) {
        mut u64 i = 0;
        while (i < vlen(e.elems)) {
            walk_expr(vec_get(e.elems, i) as Expr*);
            i = i + 1;
        }
        return;
    }
    if (e.kind == X_EX_MATCH) {
        walk_match_tmps(e);
        mut u64 i = 0;
        while (i < vlen(e.arms)) {
            ArmE* am = vec_get(e.arms, i) as ArmE*;
            g_wtdepth = g_wtdepth + 1;
            walk_pat_types(am.pat);
            if (am.guard != null) {
                walk_expr(am.guard);
            }
            if (am.body != null) {
                walk_expr(am.body);
            }
            wt_truncate();
            g_wtdepth = g_wtdepth - 1;
            i = i + 1;
        }
        return;
    }
    return;
}


fn walk_stmts(Vec* ss, Expr* trail) {
    mut u64 i = 0;
    while (i < vlen(ss)) {
        Stmt* s = vec_get(ss, i) as Stmt*;
        if (s == null) {
            i = i + 1;
            continue;
        }
        if (s.kind == X_ST_DECL) {
            mut Type* dt = s.ty;
            if (dt != null && dt.kind == X_TY_AUTO) {
                Expr* i0 = vec_get(s.inits, 0) as Expr*;
                dt = xinfer(i0);
            }
            mut Expr* i0 = null;
            if (vlen(s.inits) > 0) {
                i0 = vec_get(s.inits, 0) as Expr*;
            }
            if (dt != null && i0 != null && i0.kind == X_EX_MATCH) {
                walk_match_tmps(i0);
                mut u64 k = 0;
                while (k < vlen(i0.arms)) {
                    ArmE* am = vec_get(i0.arms, k) as ArmE*;
                    walk_pat_types(am.pat);
                    if (am.guard != null) {
                        walk_expr(am.guard);
                    }
                    walk_expr(am.body);
                    k = k + 1;
                }
            } else if (i0 != null) {
                walk_expr(i0);
            }
            mut u64 k = 0;
            while (k < vlen(s.names)) {
                char* nm = vec_get(s.names, k) as char*;
                wt_add(nm, dt);
                if (dt != null) {
                    g_frameslots = g_frameslots + slots_for_size(ty_size(dt));
                } else {
                    g_frameslots = g_frameslots + 1;
                }
                if (dt != null) {
                    xcollect_ty(dt);
                }
                k = k + 1;
            }
        } else if (s.kind == X_ST_SIMPLE) {
            walk_expr(s.e1);
            if (s.has_assign) {
                walk_expr(s.e2);
            }
        } else if (s.kind == X_ST_BLOCK) {
            g_wtdepth = g_wtdepth + 1;
            walk_stmts(s.stmts, s.trailing);
            wt_pop();
        } else if (s.kind == X_ST_IF) {
            if (s.cond_ex != null) {
                walk_expr(s.cond_ex);
            } else {
                walk_expr(s.cond);
            }
            g_wtdepth = g_wtdepth + 1;
            walk_stmts(s.then_s, s.then_t);
            wt_pop();
            mut u64 k = 0;
            while (k < vlen(s.eifs)) {
                EIF* ei = vec_get(s.eifs, k) as EIF*;
                if (ei.e != null) {
                    walk_expr(ei.e);
                } else {
                    walk_expr(ei.c);
                }
                g_wtdepth = g_wtdepth + 1;
                walk_stmts(ei.s, ei.t);
                wt_pop();
                k = k + 1;
            }
            if (s.has_els) {
                g_wtdepth = g_wtdepth + 1;
                walk_stmts(s.els, s.els_t);
                wt_pop();
            }
        } else if (s.kind == X_ST_WHILE) {
            if (s.cond_ex != null) {
                walk_expr(s.cond_ex);
            } else {
                walk_expr(s.cond);
            }
            g_wtdepth = g_wtdepth + 1;
            walk_stmts(s.then_s, s.then_t);
            wt_pop();
        } else if (s.kind == X_ST_FOR_C) {
            g_wtdepth = g_wtdepth + 1;
            if (!s.for_init_empty) {
                if (s.for_init_is_decl) {
                    Stmt* d = s.for_init_decl;
                    mut Type* dt = d.ty;
                    if (dt != null && dt.kind == X_TY_AUTO) {
                        Expr* i0 = vec_get(d.inits, 0) as Expr*;
                        dt = xinfer(i0);
                    }
                    walk_expr(vec_get(d.inits, 0) as Expr*);
                    char* nm = vec_get(d.names, 0) as char*;
                    wt_add(nm, dt);
                    if (dt != null) {
                        g_frameslots = g_frameslots + slots_for_size(ty_size(dt));
                    } else {
                        g_frameslots = g_frameslots + 1;
                    }
                    if (dt != null) {
                        xcollect_ty(dt);
                    }
                } else {
                    walk_expr(s.for_init_simple.e1);
                    if (s.for_init_simple.has_assign) {
                        walk_expr(s.for_init_simple.e2);
                    }
                }
            }
            if (s.has_for_cond) {
                walk_expr(s.for_cond);
            }
            if (s.has_incr) {
                walk_expr(s.for_incr.e1);
                if (s.for_incr.has_assign) {
                    walk_expr(s.for_incr.e2);
                }
            }
            walk_stmts(s.then_s, s.then_t);
            wt_truncate();
            g_wtdepth = g_wtdepth - 1;
        } else if (s.kind == X_ST_MATCH_STMT) {
            walk_expr(s.m_scrut);
            Type* mst = xinfer(s.m_scrut);
            mut i32 msz = 8;
            if (mst != null) {
                msz = ty_size(mst);
            }
            if (msz <= 0) {
                msz = 8;
            }
            tmp_for(s as u64, slots_for_size(msz));
            tmp_for((s as u64) + 1, 1);
            mut u64 k = 0;
            while (k < vlen(s.m_arms)) {
                ArmS* am = vec_get(s.m_arms, k) as ArmS*;
                g_wtdepth = g_wtdepth + 1;
                walk_pat_types(am.pat);
                if (am.guard != null) {
                    walk_expr(am.guard);
                }
                walk_stmts(am.bs, null as Expr*);
                wt_truncate();
                g_wtdepth = g_wtdepth - 1;
                k = k + 1;
            }
        } else if (s.kind == X_ST_RETURN) {
            if (s.has_ret) {
                if (s.ret_e != null && s.ret_e.kind == X_EX_MATCH) {
                    if (g_wcurret != null) {
                        tmp_for(s as u64, slots_for_size(ty_size(g_wcurret)));
                    }
                    walk_match_tmps(s.ret_e);
                    mut u64 k = 0;
                    while (k < vlen(s.ret_e.arms)) {
                        ArmE* am = vec_get(s.ret_e.arms, k) as ArmE*;
                        g_wtdepth = g_wtdepth + 1;
                        walk_pat_types(am.pat);
                        if (am.guard != null) {
                            walk_expr(am.guard);
                        }
                        walk_expr(am.body);
                        wt_truncate();
                        g_wtdepth = g_wtdepth - 1;
                        k = k + 1;
                    }
                } else {
                    walk_expr(s.ret_e);
                }
            }
        } else if (s.kind == X_ST_DEFER) {
            if (s.defer_is_block) {
                g_wtdepth = g_wtdepth + 1;
                walk_stmts(s.defer_blk, null);
                wt_pop();
            } else if (s.defer_simple != null) {
                walk_expr(s.defer_simple.e1);
                if (s.defer_simple.has_assign) {
                    walk_expr(s.defer_simple.e2);
                }
            }
        }
        i = i + 1;
    }
    if (trail != null) {
        walk_expr(trail);
    }
    return;
}

fn walk_fn_body(Item* it) {
    g_wcurret = it.ret;
    g_maxargs = 0;
    g_lkmode = 0;
    g_wtdepth = 0;
    mut u64 j = 0;
    while (j < vlen(it.params)) {
        Param* pp = vec_get(it.params, j) as Param*;
        wt_add(pp.nm, pp.ty);
        g_frameslots = g_frameslots + slots_for_size(ty_size(pp.ty));
        j = j + 1;
    }
    walk_stmts(it.body, it.trail);
    if (g_wts != null) {
        g_wts.len = 0;
    }
    g_wtdepth = 0;
    return;
}

fn emit_assign_combine(i32 op, i32 lw) {
    if (lw == Q_F32 || lw == Q_F64) {
        bool isf = lw == Q_F32;
        if (op != K_PLUS_EQ && op != K_MINUS_EQ && op != K_STAR_EQ && op != K_SLASH_EQ) {
            xerr("bad float assign op");
            return;
        }
        buf_puts_c(g_o, "    popq %rcx\n");
        if (isf) {
            buf_puts_c(g_o, "    movss (%rcx), %xmm1\n");
        } else {
            buf_puts_c(g_o, "    movsd (%rcx), %xmm1\n");
        }
        if (op == K_PLUS_EQ) {
            if (isf) {
                buf_puts_c(g_o, "    addss %xmm0, %xmm1\n");
            } else {
                buf_puts_c(g_o, "    addsd %xmm0, %xmm1\n");
            }
        } else if (op == K_MINUS_EQ) {
            if (isf) {
                buf_puts_c(g_o, "    subss %xmm0, %xmm1\n");
            } else {
                buf_puts_c(g_o, "    subsd %xmm0, %xmm1\n");
            }
        } else if (op == K_STAR_EQ) {
            if (isf) {
                buf_puts_c(g_o, "    mulss %xmm0, %xmm1\n");
            } else {
                buf_puts_c(g_o, "    mulsd %xmm0, %xmm1\n");
            }
        } else {
            if (isf) {
                buf_puts_c(g_o, "    divss %xmm0, %xmm1\n");
            } else {
                buf_puts_c(g_o, "    divsd %xmm0, %xmm1\n");
            }
        }
        if (isf) {
            buf_puts_c(g_o, "    movss %xmm1, (%rcx)\n");
        } else {
            buf_puts_c(g_o, "    movsd %xmm1, (%rcx)\n");
        }
        return;
    }
    mut bool is64 = lw == Q_I64 || lw == Q_U64 || lw == Q_PTR;
    mut bool uns = lw == Q_U64 || lw == Q_U32 || lw == Q_U16 || lw == Q_U8;
    if (op == K_SHL_EQ || op == K_SHR_EQ) {
        buf_puts_c(g_o, "    movq %rax, %rdx\n");
        buf_puts_c(g_o, "    popq %rcx\n");
        if (lw == Q_I8 || lw == Q_CHAR) {
            buf_puts_c(g_o, "    movsbq (%rcx), %rax\n");
        } else if (lw == Q_U8 || lw == Q_BOOL) {
            buf_puts_c(g_o, "    movzbq (%rcx), %rax\n");
        } else if (lw == Q_I16) {
            buf_puts_c(g_o, "    movswq (%rcx), %rax\n");
        } else if (lw == Q_U16) {
            buf_puts_c(g_o, "    movzwq (%rcx), %rax\n");
        } else if (lw == Q_I32) {
            buf_puts_c(g_o, "    movslq (%rcx), %rax\n");
        } else if (lw == Q_U32) {
            buf_puts_c(g_o, "    movl (%rcx), %eax\n");
        } else {
            buf_puts_c(g_o, "    movq (%rcx), %rax\n");
        }
        buf_puts_c(g_o, "    pushq %rcx\n");
        buf_puts_c(g_o, "    movb %dl, %cl\n");
        if (op == K_SHL_EQ) {
            if (is64) {
                buf_puts_c(g_o, "    shlq %cl, %rax\n");
            } else {
                buf_puts_c(g_o, "    shll %cl, %eax\n");
            }
        } else {
            if (is64) {
                if (uns) {
                    buf_puts_c(g_o, "    shrq %cl, %rax\n");
                } else {
                    buf_puts_c(g_o, "    sarq %cl, %rax\n");
                }
            } else {
                if (uns) {
                    buf_puts_c(g_o, "    shrl %cl, %eax\n");
                } else {
                    buf_puts_c(g_o, "    sarl %cl, %eax\n");
                }
            }
        }
        buf_puts_c(g_o, "    popq %rcx\n");
        if (is64) {
            buf_puts_c(g_o, "    movq %rax, (%rcx)\n");
        } else {
            buf_puts_c(g_o, "    movl %eax, (%rcx)\n");
        }
        return;
    }
    if (op == K_SLASH_EQ || op == K_PERCENT_EQ) {
        mut bool isdiv = op == K_SLASH_EQ;
        buf_puts_c(g_o, "    movq %rax, %r8\n");
        buf_puts_c(g_o, "    popq %rcx\n");
        if (is64) {
            buf_puts_c(g_o, "    movq (%rcx), %rax\n");
            if (uns) {
                buf_puts_c(g_o, "    xorl %edx, %edx\n    divq %r8\n");
            } else {
                buf_puts_c(g_o, "    cqo\n    idivq %r8\n");
            }
            if (!isdiv) {
                buf_puts_c(g_o, "    movq %rdx, %rax\n");
            }
            buf_puts_c(g_o, "    movq %rax, (%rcx)\n");
        } else if (lw == Q_I32 || lw == Q_U32) {
            buf_puts_c(g_o, "    movl (%rcx), %eax\n");
            if (uns) {
                buf_puts_c(g_o, "    xorl %edx, %edx\n    divl %r8d\n");
            } else {
                buf_puts_c(g_o, "    cltd\n    idivl %r8d\n");
            }
            if (!isdiv) {
                buf_puts_c(g_o, "    movl %edx, %eax\n");
            }
            buf_puts_c(g_o, "    movl %eax, (%rcx)\n");
        } else {
            if (lw == Q_I8 || lw == Q_CHAR) {
                buf_puts_c(g_o, "    movsbq (%rcx), %rax\n");
            } else if (lw == Q_U8 || lw == Q_BOOL) {
                buf_puts_c(g_o, "    movzbq (%rcx), %rax\n");
            } else if (lw == Q_I16) {
                buf_puts_c(g_o, "    movswq (%rcx), %rax\n");
            } else {
                buf_puts_c(g_o, "    movzwq (%rcx), %rax\n");
            }
            if (uns) {
                buf_puts_c(g_o, "    xorl %edx, %edx\n    divq %r8\n");
            } else {
                buf_puts_c(g_o, "    cqo\n    idivq %r8\n");
            }
            if (!isdiv) {
                buf_puts_c(g_o, "    movq %rdx, %rax\n");
            }
            if (lw == Q_I8 || lw == Q_U8 || lw == Q_BOOL || lw == Q_CHAR) {
                buf_puts_c(g_o, "    movb %al, (%rcx)\n");
            } else {
                buf_puts_c(g_o, "    movw %ax, (%rcx)\n");
            }
        }
        return;
    }
    buf_puts_c(g_o, "    movq %rax, %rdx\n");
    buf_puts_c(g_o, "    popq %rcx\n");
    if (lw == Q_I8 || lw == Q_CHAR) {
        buf_puts_c(g_o, "    movsbq %dl, %rdx\n");
        buf_puts_c(g_o, "    movsbq (%rcx), %rax\n");
    } else if (lw == Q_U8 || lw == Q_BOOL) {
        buf_puts_c(g_o, "    movzbq %dl, %rdx\n");
        buf_puts_c(g_o, "    movzbq (%rcx), %rax\n");
    } else if (lw == Q_I16) {
        buf_puts_c(g_o, "    movswq %dx, %rdx\n");
        buf_puts_c(g_o, "    movswq (%rcx), %rax\n");
    } else if (lw == Q_U16) {
        buf_puts_c(g_o, "    movzwq %dx, %rdx\n");
        buf_puts_c(g_o, "    movzwq (%rcx), %rax\n");
    } else if (lw == Q_I32) {
        buf_puts_c(g_o, "    movslq %edx, %rdx\n");
        buf_puts_c(g_o, "    movslq (%rcx), %rax\n");
    } else if (lw == Q_U32) {
        buf_puts_c(g_o, "    movl %edx, %edx\n");
        buf_puts_c(g_o, "    movl (%rcx), %eax\n");
    }
    if (op == K_PLUS_EQ) {
        buf_puts_c(g_o, "    addq %rdx, %rax\n");
    } else if (op == K_MINUS_EQ) {
        buf_puts_c(g_o, "    subq %rdx, %rax\n");
    } else if (op == K_STAR_EQ) {
        buf_puts_c(g_o, "    imulq %rdx, %rax\n");
    } else if (op == K_AMP_EQ) {
        buf_puts_c(g_o, "    andq %rdx, %rax\n");
    } else if (op == K_CARET_EQ) {
        buf_puts_c(g_o, "    xorq %rdx, %rax\n");
    } else if (op == K_PIPE_EQ) {
        buf_puts_c(g_o, "    orq %rdx, %rax\n");
    } else {
        xerr("bad assign op");
        return;
    }
    if (lw == Q_I8 || lw == Q_U8 || lw == Q_BOOL || lw == Q_CHAR) {
        buf_puts_c(g_o, "    movb %al, (%rcx)\n");
    } else if (lw == Q_I16 || lw == Q_U16) {
        buf_puts_c(g_o, "    movw %ax, (%rcx)\n");
    } else if (lw == Q_I32 || lw == Q_U32) {
        buf_puts_c(g_o, "    movl %eax, (%rcx)\n");
    } else {
        buf_puts_c(g_o, "    movq %rax, (%rcx)\n");
    }
    return;
}

fn emit_assign_stmt(Expr* lhs, Expr* rhs, i32 op) {
    mut Type* lt = xinfer(lhs);
    mut i32 lw = Q_I64;
    if (lt != null) {
        lw = ty_width(lt);
    }
    if (lw == Q_STRUCT && lt != null) {
        if (op != K_EQ) {
            xerr("compound struct assign TODO");
            return;
        }
        emit_addr(lhs);
        buf_puts_c(g_o, "    pushq %rax\n");
        emit_val(rhs);
        mut i32 sz = ty_size(lt);
        buf_puts_c(g_o, "    movq %rax, %rsi\n");
        buf_puts_c(g_o, "    popq %rdi\n");
        buf_puts_c(g_o, "    movl $");
        buf_puti(g_o, sz);
        buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
        return;
    }
    emit_addr(lhs);
    buf_puts_c(g_o, "    pushq %rax\n");
    emit_val(rhs);
    Type* rt = xinfer(rhs);
    mut i32 rw = Q_I64;
    if (rt != null) {
        rw = ty_width(rt);
    }
    to_width(rw, lw);
    if (op == K_EQ) {
        buf_puts_c(g_o, "    popq %rcx\n");
        if (lw == Q_F32 || lw == Q_F64) {
            if (lw == Q_F32) {
                buf_puts_c(g_o, "    movss %xmm0, (%rcx)\n");
            } else {
                buf_puts_c(g_o, "    movsd %xmm0, (%rcx)\n");
            }
        } else {
            if (lw == Q_I64 || lw == Q_U64 || lw == Q_PTR) {
                buf_puts_c(g_o, "    movq %rax, (%rcx)\n");
            } else {
                store_mem("(%rcx)", lw);
            }
        }
        return;
    }
    emit_assign_combine(op, lw);
    return;
}


fn emit_stmts(Vec* ss) {
    mut u64 i = 0;
    while (i < vlen(ss)) {
        emit_stmt(vec_get(ss, i) as Stmt*);
        i = i + 1;
    }
    return;
}

mut Vec* g_loopbrk = null;
mut Vec* g_loopct = null;
mut i32 g_loopn = 0;
mut i32 g_fnexit = 0;
mut i32 g_srethome = -1;
mut i32 g_deferhead = -1;
mut Type* g_curret = null;

fn loop_push(i32 b, i32 c) {
    g_loopbrk = vpush(g_loopbrk, (b as u64) as u8*);
    g_loopct = vpush(g_loopct, (c as u64) as u8*);
    g_loopn = g_loopn + 1;
    return;
}

fn loop_pop() {
    g_loopn = g_loopn - 1;
    g_loopbrk.len = g_loopbrk.len - 1;
    g_loopct.len = g_loopct.len - 1;
    return;
}

fn loop_top_brk() -> i32 {
    return (vec_get(g_loopbrk, (g_loopn - 1) as u64) as u64) as i32;
}

fn loop_top_ct() -> i32 {
    return (vec_get(g_loopct, (g_loopn - 1) as u64) as u64) as i32;
}

fn emit_stmt(Stmt* s) {
    if (s == null) {
        return;
    }
    if (s.kind == X_ST_DECL) {
        mut u64 i = 0;
        while (i < vlen(s.names)) {
            mut Type* dt = s.ty;
            if (dt != null && dt.kind == X_TY_AUTO) {
                dt = xinfer(vec_get(s.inits, i) as Expr*);
                if (dt == null) {
                    xerr("auto needs explicit type here in core");
                    dt = xnew_prim(K_I32);
                }
            }
            char* nm = vec_get(s.names, i) as char*;
            if (dt != null) {
                xv_add(nm, dt, slots_for_size(ty_size(dt)));
            } else {
                xv_add(nm, dt, 1);
            }
            Expr* init = vec_get(s.inits, i) as Expr*;
            if (init != null && init.kind == X_EX_MATCH) {
                XV* v = xv_find(nm);
                if (v == null) {
                    xerr("decl missing");
                    break;
                }
                char* vm = slot_str(v.slot, v.name);
                mut i32 sz = 8;
                if (dt != null) {
                    sz = ty_size(dt);
                }
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, vm);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, sz);
                buf_puts_c(g_o, ", %ecx\n    xorl %eax, %eax\n    rep stosb\n");
                emit_match_value(init, v.slot, dt);
                break;
            }
            if (dt != null && dt.kind == X_TY_ARRAY && init != null && init.kind == X_EX_ARRAY_LIST) {
                XV* v = xv_find(nm);
                if (v == null) {
                    xerr("decl missing");
                    break;
                }
                Type* et0 = dt.elem;
                i32 ew = ty_width(et0);
                mut i32 esz = ty_size(et0);
                i32 estep = slots_for_size(esz);
                mut u64 k = 0;
                while (k < vlen(init.elems)) {
                    emit_val(vec_get(init.elems, k) as Expr*);
                    mut char* m = null as char*;
                    if (v.slot < 0) {
                        sview osv = i32_to_str((k as i32) * esz, g_ar);
                        u64 nl = tk_strlen(v.name);
                        u8* gb = arena_alloc(g_ar, nl + osv.len as u64 + 8);
                        mut u64 w = 0;
                        while (w < nl) {
                            gb[w] = v.name[w];
                            w = w + 1;
                        }
                        gb[nl] = 43;
                        w = 0;
                        while (w < osv.len as u64) {
                            gb[nl + 1 + w] = osv.ptr[w];
                            w = w + 1;
                        }
                        mut u64 o = nl + 1 + (osv.len as u64);
                        gb[o] = 40;
                        gb[o + 1] = 37;
                        gb[o + 2] = 114;
                        gb[o + 3] = 105;
                        gb[o + 4] = 112;
                        gb[o + 5] = 41;
                        gb[o + 6] = 0;
                        m = gb as char*;
                    } else {
                        m = slot_str(v.slot - (k as i32) * estep, v.name);
                    }
                    if (ew == Q_F32 || ew == Q_F64) {
                        to_width(xqw(vec_get(init.elems, k) as Expr*), ew);
                        if (ew == Q_F32) {
                            buf_puts_c(g_o, "    movss %xmm0, ");
                        } else {
                            buf_puts_c(g_o, "    movsd %xmm0, ");
                        }
                        buf_puts_c(g_o, m);
                        buf_putc(g_o, 10);
                    } else {
                        to_width(xqw(vec_get(init.elems, k) as Expr*), ew);
                        store_mem(m, ew);
                    }
                    k = k + 1;
                }
                break;
            }
            if (dt != null && dt.kind == X_TY_PATH && vlen(dt.path) == 1) {
                char* s0 = vec_get(dt.path, 0) as char*;
                if (tk_streq(s0, "List") && vlen(dt.gargs) == 1 && init != null && init.kind == X_EX_ARRAY_LIST) {
                    XV* v = xv_find(nm);
                    if (v == null) {
                        xerr("decl missing");
                        break;
                    }
                    char* vm = slot_str(v.slot, v.name);
                    char* lstr = slot_str(v.slot - 1, v.name);
                    char* cstr = slot_str(v.slot - 2, v.name);
                    buf_puts_c(g_o, "    movq $0, ");
                    buf_puts_c(g_o, vm);
                    buf_putc(g_o, 10);
                    buf_puts_c(g_o, "    movq $0, ");
                    buf_puts_c(g_o, lstr);
                    buf_putc(g_o, 10);
                    buf_puts_c(g_o, "    movq $0, ");
                    buf_puts_c(g_o, cstr);
                    buf_putc(g_o, 10);
                    if (vlen(init.elems) > 0) {
                        Type* et0 = vec_get(dt.gargs, 0) as Type*;
                        i32 ew = ty_width(et0);
                        mut i32 esz = ty_size(et0);
                        buf_puts_c(g_o, "    movq $");
                        buf_puti(g_o, (vlen(init.elems) as i32) * esz);
                        buf_puts_c(g_o, ", %rdi\n");
                        buf_puts_c(g_o, "    call malloc@PLT\n");
                        buf_puts_c(g_o, "    movq %rax, ");
                        buf_puts_c(g_o, vm);
                        buf_putc(g_o, 10);
                        mut i32 lok = new_lbl();
                        buf_puts_c(g_o, "    testq %rax, %rax\n    jnz .L");
                        buf_puti(g_o, lok);
                        buf_putc(g_o, 10);
                        buf_puts_c(g_o, "    movl $1, %edi\n    call exit@PLT\n");
                        buf_puts_c(g_o, ".L");
                        buf_puti(g_o, lok);
                        buf_puts_c(g_o, ":\n");
                        buf_puts_c(g_o, "    movq $");
                        buf_puti(g_o, vlen(init.elems) as i32);
                        buf_puts_c(g_o, ", ");
                        buf_puts_c(g_o, lstr);
                        buf_putc(g_o, 10);
                        buf_puts_c(g_o, "    movq $");
                        buf_puti(g_o, vlen(init.elems) as i32);
                        buf_puts_c(g_o, ", ");
                        buf_puts_c(g_o, cstr);
                        buf_putc(g_o, 10);
                        mut u64 k = 0;
                        while (k < vlen(init.elems)) {
                            emit_val(vec_get(init.elems, k) as Expr*);
                            if (ew == Q_STRUCT) {
                                buf_puts_c(g_o, "    movq %rax, %rsi\n");
                                buf_puts_c(g_o, "    movq ");
                                buf_puts_c(g_o, vm);
                                buf_puts_c(g_o, ", %rdi\n");
                                buf_puts_c(g_o, "    addq $");
                                buf_puti(g_o, (k as i32) * esz);
                                buf_puts_c(g_o, ", %rdi\n");
                                buf_puts_c(g_o, "    movl $");
                                buf_puti(g_o, esz);
                                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
                            } else if (ew == Q_F32 || ew == Q_F64) {
                                to_width(xqw(vec_get(init.elems, k) as Expr*), ew);
                                buf_puts_c(g_o, "    movq ");
                                buf_puts_c(g_o, vm);
                                buf_puts_c(g_o, ", %rcx\n");
                                if (ew == Q_F32) {
                                    buf_puts_c(g_o, "    movss %xmm0, ");
                                    buf_puti(g_o, (k as i32) * esz);
                                    buf_puts_c(g_o, "(%rcx)\n");
                                } else {
                                    buf_puts_c(g_o, "    movsd %xmm0, ");
                                    buf_puti(g_o, (k as i32) * esz);
                                    buf_puts_c(g_o, "(%rcx)\n");
                                }
                            } else {
                                to_width(xqw(vec_get(init.elems, k) as Expr*), ew);
                                buf_puts_c(g_o, "    movq ");
                                buf_puts_c(g_o, vm);
                                buf_puts_c(g_o, ", %rcx\n");
                                u8* em = arena_alloc(g_ar, 32);
                                sview esv = i32_to_str((k as i32) * esz, g_ar);
                                mut u64 w = 0;
                                while (w < esv.len as u64) {
                                    em[w] = esv.ptr[w];
                                    w = w + 1;
                                }
                                em[esv.len as u64] = 40;
                                em[esv.len as u64 + 1] = 37;
                                em[esv.len as u64 + 2] = 114;
                                em[esv.len as u64 + 3] = 99;
                                em[esv.len as u64 + 4] = 120;
                                em[esv.len as u64 + 5] = 41;
                                em[esv.len as u64 + 6] = 0;
                                store_mem(em as char*, ew);
                            }
                            k = k + 1;
                        }
                    }
                    break;
                }
            }
            XV* v = xv_find(nm);
            if (v == null) {
                xerr("decl missing");
                break;
            }
            mut i32 dw = Q_I64;
            if (dt != null) {
                dw = ty_width(dt);
            }
            if (dw == Q_STRUCT && dt != null) {
                emit_val(init);
                char* vm = slot_str(v.slot, v.name);
                mut i32 sz = ty_size(dt);
                buf_puts_c(g_o, "    movq %rax, %rsi\n");
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, vm);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, sz);
                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            } else {
                emit_val(init);
                Type* it2 = xinfer(init);
                mut i32 iw = Q_I64;
                if (it2 != null) {
                    iw = ty_width(it2);
                }
                to_width(iw, dw);
                char* vm = slot_str(v.slot, v.name);
                store_mem(vm, dw);
            }
            i = i + 1;
        }
        return;
    }
    if (s.kind == X_ST_SIMPLE) {
        if (!s.has_assign) {
            emit_val(s.e1);
            return;
        }
        emit_assign_stmt(s.e1, s.e2, s.op);
        return;
    }
    if (s.kind == X_ST_BLOCK) {
        xv_push();
        emit_stmts(s.stmts);
        xv_pop();
        return;
    }
    if (s.kind == X_ST_IF) {
        mut Expr* cnd = s.cond;
        if (s.cond_ex != null) {
            cnd = s.cond_ex;
        }
        emit_val(cnd);
        mut i32 lelse = new_lbl();
        mut i32 lend = new_lbl();
        buf_puts_c(g_o, "    testq %rax, %rax\n    jz .L");
        buf_puti(g_o, lelse);
        buf_putc(g_o, 10);
        xv_push();
        emit_stmts(s.then_s);
        xv_pop();
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, lend);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lelse);
        buf_puts_c(g_o, ":\n");
        mut u64 i = 0;
        while (i < vlen(s.eifs)) {
            EIF* ei = vec_get(s.eifs, i) as EIF*;
            mut i32 le2 = new_lbl();
            if (ei.e != null) {
                emit_val(ei.e);
            } else {
                emit_val(ei.c);
            }
            buf_puts_c(g_o, "    testq %rax, %rax\n    jz .L");
            buf_puti(g_o, le2);
            buf_putc(g_o, 10);
            xv_push();
            emit_stmts(ei.s);
            xv_pop();
            buf_puts_c(g_o, "    jmp .L");
            buf_puti(g_o, lend);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, ".L");
            buf_puti(g_o, le2);
            buf_puts_c(g_o, ":\n");
            i = i + 1;
        }
        if (s.has_els) {
            xv_push();
            emit_stmts(s.els);
            xv_pop();
        }
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lend);
        buf_puts_c(g_o, ":\n");
        return;
    }
    if (s.kind == X_ST_WHILE) {
        mut i32 ltop = new_lbl();
        mut i32 lend = new_lbl();
        loop_push(lend, ltop);
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, ltop);
        buf_puts_c(g_o, ":\n");
        if (s.cond_ex != null) {
            emit_val(s.cond_ex);
        } else {
            emit_val(s.cond);
        }
        buf_puts_c(g_o, "    testq %rax, %rax\n    jz .L");
        buf_puti(g_o, lend);
        buf_putc(g_o, 10);
        xv_push();
        emit_stmts(s.then_s);
        xv_pop();
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, ltop);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lend);
        buf_puts_c(g_o, ":\n");
        loop_pop();
        return;
    }
    if (s.kind == X_ST_FOR_C) {
        mut i32 ltop = new_lbl();
        mut i32 lend = new_lbl();
        xv_push();
        if (!s.for_init_empty) {
            if (s.for_init_is_decl) {
                emit_stmt(s.for_init_decl);
            } else if (s.for_init_simple.has_assign) {
                emit_assign_stmt(s.for_init_simple.e1, s.for_init_simple.e2, s.for_init_simple.op);
            } else {
                emit_val(s.for_init_simple.e1);
            }
        }
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, ltop);
        buf_puts_c(g_o, ":\n");
        loop_push(lend, ltop);
        if (s.has_for_cond) {
            emit_val(s.for_cond);
            buf_puts_c(g_o, "    testq %rax, %rax\n    jz .L");
            buf_puti(g_o, lend);
            buf_putc(g_o, 10);
        }
        emit_stmts(s.then_s);
        if (s.has_incr) {
            if (!s.for_incr.has_assign) {
                emit_val(s.for_incr.e1);
            } else {
                emit_assign_stmt(s.for_incr.e1, s.for_incr.e2, s.for_incr.op);
            }
        }
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, ltop);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lend);
        buf_puts_c(g_o, ":\n");
        loop_pop();
        xv_pop();
        return;
    }
    if (s.kind == X_ST_MATCH_STMT) {
        mut i32 mslot = tmp_find(s as u64);
        mut i32 dslot = tmp_find((s as u64) + 1);
        if (mslot < 0 || dslot < 0) {
            xerr("temp missing (walk/emit skew)");
            return;
        }
        mut char* mm = slot_str(mslot, null as char*);
        mut char* dm = slot_str(dslot, null as char*);
        emit_val(s.m_scrut);
        Type* st = xinfer(s.m_scrut);
        if (st != null && ty_width(st) == Q_STRUCT) {
            mut i32 sz = ty_size(st);
            buf_puts_c(g_o, "    movq %rax, %rsi\n");
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, mm);
            buf_puts_c(g_o, ", %rdi\n");
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, sz);
            buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
        } else if (st != null && (ty_width(st) == Q_F32 || ty_width(st) == Q_F64)) {
            if (ty_width(st) == Q_F32) {
                buf_puts_c(g_o, "    movss %xmm0, ");
            } else {
                buf_puts_c(g_o, "    movsd %xmm0, ");
            }
            buf_puts_c(g_o, mm);
            buf_putc(g_o, 10);
        } else {
            buf_puts_c(g_o, "    movq %rax, ");
            buf_puts_c(g_o, mm);
            buf_putc(g_o, 10);
        }
        buf_puts_c(g_o, "    movq $0, ");
        buf_puts_c(g_o, dm);
        buf_putc(g_o, 10);
        mut u64 i = 0;
        while (i < vlen(s.m_arms)) {
            ArmS* am = vec_get(s.m_arms, i) as ArmS*;
            mut i32 lbody = new_lbl();
            mut i32 lnext = new_lbl();
            buf_puts_c(g_o, "    cmpb $0, ");
            buf_puts_c(g_o, dm);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, "    jne .L");
            buf_puti(g_o, lnext);
            buf_putc(g_o, 10);
            xalt_bool(am.pat, mslot, st);
            buf_puts_c(g_o, "    testb %al, %al\n    jnz .L");
            buf_puti(g_o, lbody);
            buf_putc(g_o, 10);
            mut u64 q = 0;
            while (q < vlen(am.pat.or_next) && q < 8) {
                xalt_bool(vec_get(am.pat.or_next, q) as Pat*, mslot, st);
                buf_puts_c(g_o, "    testb %al, %al\n    jnz .L");
                buf_puti(g_o, lbody);
                buf_putc(g_o, 10);
                q = q + 1;
            }
            buf_puts_c(g_o, "    jmp .L");
            buf_puti(g_o, lnext);
            buf_putc(g_o, 10);
            buf_puts_c(g_o, ".L");
            buf_puti(g_o, lbody);
            buf_puts_c(g_o, ":\n");
            xv_push();
            xbind_add(am.pat, st);
            xbind_copy(am.pat, mslot, st);
            if (am.guard != null) {
                emit_val(am.guard);
                buf_puts_c(g_o, "    testq %rax, %rax\n");
                mut i32 lskip = new_lbl();
                buf_puts_c(g_o, "    jz .L");
                buf_puti(g_o, lskip);
                buf_putc(g_o, 10);
                emit_stmts(am.bs);
                buf_puts_c(g_o, "    movq $1, ");
                buf_puts_c(g_o, dm);
                buf_putc(g_o, 10);
                buf_puts_c(g_o, ".L");
                buf_puti(g_o, lskip);
                buf_puts_c(g_o, ":\n");
            } else {
                emit_stmts(am.bs);
                buf_puts_c(g_o, "    movq $1, ");
                buf_puts_c(g_o, dm);
                buf_putc(g_o, 10);
            }
            xv_pop();
            buf_puts_c(g_o, ".L");
            buf_puti(g_o, lnext);
            buf_puts_c(g_o, ":\n");
            i = i + 1;
        }
        return;
    }
    if (s.kind == X_ST_RETURN) {
        if (!s.has_ret) {
            buf_puts_c(g_o, "    jmp .Lfn");
            buf_puti(g_o, g_fnexit);
            buf_putc(g_o, 10);
            return;
        }
        if (s.ret_e != null && s.ret_e.kind == X_EX_MATCH) {
            i32 rslot = tmp_find(s as u64);
            if (rslot < 0) {
                xerr("temp missing (walk/emit skew)");
                return;
            }
            Type* rt = g_curret;
            char* rm = slot_str(rslot, null as char*);
            mut i32 rsz = 8;
            if (rt != null) {
                rsz = ty_size(rt);
            }
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, rm);
            buf_puts_c(g_o, ", %rdi\n");
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, rsz);
            buf_puts_c(g_o, ", %ecx\n    xorl %eax, %eax\n    rep stosb\n");
            emit_match_value(s.ret_e, rslot, rt);
            if (rt != null && ty_width(rt) == Q_STRUCT) {
                mut i32 sz2 = ty_size(rt);
                buf_puts_c(g_o, "    leaq ");
                buf_puts_c(g_o, rm);
                buf_puts_c(g_o, ", %rsi\n");
                if (g_srethome < 0) {
                    xerr("sret home missing");
                    return;
                }
                char* sm = slot_str(g_srethome, null as char*);
                buf_puts_c(g_o, "    movq ");
                buf_puts_c(g_o, sm);
                buf_puts_c(g_o, ", %rdi\n");
                buf_puts_c(g_o, "    movl $");
                buf_puti(g_o, sz2);
                buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            } else if (rt != null && (ty_width(rt) == Q_F32 || ty_width(rt) == Q_F64)) {
                if (ty_width(rt) == Q_F32) {
                    buf_puts_c(g_o, "    movss ");
                } else {
                    buf_puts_c(g_o, "    movsd ");
                }
                buf_puts_c(g_o, rm);
                buf_puts_c(g_o, ", %xmm0\n");
            } else {
                mut i32 rw = Q_I64;
                if (rt != null) {
                    rw = ty_width(rt);
                }
                load_mem(rm, rw);
            }
            buf_puts_c(g_o, "    jmp .Lfn");
            buf_puti(g_o, g_fnexit);
            buf_putc(g_o, 10);
            return;
        }
        Type* rt = g_curret;
        if (rt != null && ty_width(rt) == Q_STRUCT) {
            emit_val(s.ret_e);
            if (g_srethome < 0) {
                xerr("sret home missing");
                return;
            }
            char* sm = slot_str(g_srethome, null as char*);
            mut i32 sz = ty_size(rt);
            buf_puts_c(g_o, "    movq %rax, %rsi\n");
            buf_puts_c(g_o, "    movq ");
            buf_puts_c(g_o, sm);
            buf_puts_c(g_o, ", %rdi\n");
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, sz);
            buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
        } else if (rt != null && (ty_width(rt) == Q_F32 || ty_width(rt) == Q_F64)) {
            emit_val(s.ret_e);
            Type* bt = xinfer(s.ret_e);
            mut i32 bw = Q_F64;
            if (bt != null) {
                bw = ty_width(bt);
            }
            if (ty_width(rt) == Q_F32) {
                to_width(bw, Q_F32);
            } else {
                to_width(bw, ty_width(rt));
            }
        } else {
            emit_val(s.ret_e);
            Type* bt = xinfer(s.ret_e);
            mut i32 bw = Q_I64;
            if (bt != null) {
                bw = ty_width(bt);
            }
            mut i32 rw = Q_I64;
            if (rt != null) {
                rw = ty_width(rt);
            }
            to_width(bw, rw);
        }
        buf_puts_c(g_o, "    jmp .Lfn");
        buf_puti(g_o, g_fnexit);
        buf_putc(g_o, 10);
        return;
    }
    if (s.kind == X_ST_BREAK) {
        if (g_loopn <= 0) {
            xerr("break outside loop");
            return;
        }
        if (s.label != null) {
            xerr("labeled break/continue TODO in native backend");
            return;
        }
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, loop_top_brk());
        buf_putc(g_o, 10);
        return;
    }
    if (s.kind == X_ST_CONTINUE) {
        if (g_loopn <= 0) {
            xerr("continue outside loop");
            return;
        }
        if (s.label != null) {
            xerr("labeled break/continue TODO in native backend");
            return;
        }
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, loop_top_ct());
        buf_putc(g_o, 10);
        return;
    }
    if (s.kind == X_ST_DEFER) {
        mut i32 ld = new_lbl();
        mut i32 lend = new_lbl();
        mut i32 lok = new_lbl();
        char* hm = slot_str(g_deferhead, null as char*);
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, lend);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, ld);
        buf_puts_c(g_o, ":\n");
        if (s.defer_is_block) {
            xv_push();
            emit_stmts(s.defer_blk);
            xv_pop();
        } else if (s.defer_simple != null) {
            if (s.defer_simple.has_assign) {
                emit_assign_stmt(s.defer_simple.e1, s.defer_simple.e2, s.defer_simple.op);
            } else {
                emit_val(s.defer_simple.e1);
            }
        }
        buf_puts_c(g_o, "    ret\n");
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lend);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    movq $16, %rdi\n");
        buf_puts_c(g_o, "    call malloc@PLT\n");
        buf_puts_c(g_o, "    testq %rax, %rax\n    jnz .L");
        buf_puti(g_o, lok);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, "    movl $1, %edi\n    call exit@PLT\n");
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lok);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    movq ");
        buf_puts_c(g_o, hm);
        buf_puts_c(g_o, ", %rcx\n");
        buf_puts_c(g_o, "    movq %rcx, (%rax)\n");
        buf_puts_c(g_o, "    leaq .L");
        buf_puti(g_o, ld);
        buf_puts_c(g_o, "(%rip), %rcx\n");
        buf_puts_c(g_o, "    movq %rcx, 8(%rax)\n");
        buf_puts_c(g_o, "    movq %rax, ");
        buf_puts_c(g_o, hm);
        buf_putc(g_o, 10);
        return;
    }
    if (s.kind == X_ST_HANDLE_STMT || s.kind == X_ST_TRANSACT_STMT) {
        xv_push();
        emit_stmts(s.stmts);
        xv_pop();
        return;
    }
    xerr("statement TODO in native backend");
    return;
}


fn emit_list_helpers() {
    mut u64 li = 0;
    while (li < vlen(g_xlist)) {
        Type* el = vec_get(g_xlist, li) as Type*;
        i32 ew = ty_width(el);
        mut i32 esz = ty_size(el);
        buf_puts_c(g_o, "List_");
        mangle_rec(el);
        buf_puts_c(g_o, "_push:\n");
        buf_puts_c(g_o, "    pushq %rbp\n    movq %rsp, %rbp\n");
        buf_puts_c(g_o, "    subq $32, %rsp\n");
        buf_puts_c(g_o, "    movq %rdi, -8(%rbp)\n");
        buf_puts_c(g_o, "    movq %rsi, -16(%rbp)\n");
        buf_puts_c(g_o, "    movq -8(%rbp), %rax\n");
        buf_puts_c(g_o, "    movq 8(%rax), %rax\n");
        buf_puts_c(g_o, "    movq -8(%rbp), %rcx\n");
        buf_puts_c(g_o, "    cmpq 16(%rcx), %rax\n");
        mut i32 lok = new_lbl();
        buf_puts_c(g_o, "    jne .L");
        buf_puti(g_o, lok);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, "    movq -8(%rbp), %rax\n");
        buf_puts_c(g_o, "    movq 16(%rax), %rsi\n");
        buf_puts_c(g_o, "    testq %rsi, %rsi\n");
        mut i32 lnz = new_lbl();
        mut i32 lgot = new_lbl();
        buf_puts_c(g_o, "    jnz .L");
        buf_puti(g_o, lnz);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, "    movq $8, %rsi\n");
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, lgot);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lnz);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    leaq (%rsi,%rsi), %rsi\n");
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lgot);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    imulq $");
        buf_puti(g_o, esz);
        buf_puts_c(g_o, ", %rsi\n");
        buf_puts_c(g_o, "    movq -8(%rbp), %rax\n");
        buf_puts_c(g_o, "    movq (%rax), %rdi\n");
        buf_puts_c(g_o, "    call realloc@PLT\n");
        buf_puts_c(g_o, "    testq %rax, %rax\n");
        mut i32 lok2 = new_lbl();
        buf_puts_c(g_o, "    jnz .L");
        buf_puti(g_o, lok2);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, "    movl $1, %edi\n    call exit@PLT\n");
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lok2);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    movq -8(%rbp), %rcx\n");
        buf_puts_c(g_o, "    movq %rax, (%rcx)\n");
        buf_puts_c(g_o, "    movq 16(%rcx), %rsi\n");
        buf_puts_c(g_o, "    testq %rsi, %rsi\n");
        mut i32 lnz2 = new_lbl();
        mut i32 lgot2 = new_lbl();
        buf_puts_c(g_o, "    jnz .L");
        buf_puti(g_o, lnz2);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, "    movq $8, %rsi\n");
        buf_puts_c(g_o, "    jmp .L");
        buf_puti(g_o, lgot2);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lnz2);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    leaq (%rsi,%rsi), %rsi\n");
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lgot2);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    movq %rsi, 16(%rcx)\n");
        buf_puts_c(g_o, ".L");
        buf_puti(g_o, lok);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    movq -8(%rbp), %rax\n");
        buf_puts_c(g_o, "    movq (%rax), %rax\n");
        buf_puts_c(g_o, "    movq -8(%rbp), %rcx\n");
        buf_puts_c(g_o, "    movq 8(%rcx), %rcx\n");
        if (esz == 1) {
            buf_puts_c(g_o, "    addq %rcx, %rax\n");
        } else if (esz == 2 || esz == 4 || esz == 8) {
            buf_puts_c(g_o, "    leaq (%rax,%rcx,");
            buf_puti(g_o, esz);
            buf_puts_c(g_o, "), %rax\n");
        } else {
            buf_puts_c(g_o, "    imulq $");
            buf_puti(g_o, esz);
            buf_puts_c(g_o, ", %rcx\n");
            buf_puts_c(g_o, "    addq %rcx, %rax\n");
        }
        buf_puts_c(g_o, "    movq %rax, -24(%rbp)\n");
        if (ew == Q_STRUCT) {
            buf_puts_c(g_o, "    movq -16(%rbp), %rsi\n");
            buf_puts_c(g_o, "    movq -24(%rbp), %rdi\n");
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, esz);
            buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
        } else if (ew == Q_F32) {
            buf_puts_c(g_o, "    movq -16(%rbp), %rax\n");
            buf_puts_c(g_o, "    movq -24(%rbp), %rcx\n");
            buf_puts_c(g_o, "    movl %eax, (%rcx)\n");
        } else if (ew == Q_F64) {
            buf_puts_c(g_o, "    movq -16(%rbp), %rax\n");
            buf_puts_c(g_o, "    movq -24(%rbp), %rcx\n");
            buf_puts_c(g_o, "    movq %rax, (%rcx)\n");
        } else {
            buf_puts_c(g_o, "    movq -16(%rbp), %rax\n");
            buf_puts_c(g_o, "    movq -24(%rbp), %rcx\n");
            if (esz == 1) {
                buf_puts_c(g_o, "    movb %al, (%rcx)\n");
            } else if (esz == 2) {
                buf_puts_c(g_o, "    movw %ax, (%rcx)\n");
            } else if (esz == 4) {
                buf_puts_c(g_o, "    movl %eax, (%rcx)\n");
            } else {
                buf_puts_c(g_o, "    movq %rax, (%rcx)\n");
            }
        }
        buf_puts_c(g_o, "    movq -8(%rbp), %rax\n");
        buf_puts_c(g_o, "    incq 8(%rax)\n");
        buf_puts_c(g_o, "    leave\n    ret\n");
        li = li + 1;
    }
    return;
}

fn emit_fn(Item* it) {
    Type* rt = it.ret;
    mut i32 rw = Q_VOID;
    if (rt != null) {
        rw = ty_width(rt);
    }
    bool is_sret = rw == Q_STRUCT;
    g_fnexit = new_lbl();
    g_deferhead = g_frameslots;
    g_frameslots = g_frameslots + 1;
    mut i32 ipos = 0;
    mut i32 fpos = 0;
    mut i32 spos = 0;
    if (is_sret) {
        mut i32 slot = tmp_find(it as u64);
        if (slot < 0) {
            xerr("temp missing (walk/emit skew)");
        } else {
            mut char* m = slot_str(slot, null as char*);
            buf_puts_c(g_o, "    movq %rdi, ");
            buf_puts_c(g_o, m);
            buf_putc(g_o, 10);
            g_srethome = slot;
        }
        ipos = 1;
    }
    mut u64 j = 0;
    while (j < vlen(it.params)) {
        Param* pp = vec_get(it.params, j) as Param*;
        Type* pt = pp.ty;
        mut i32 pw = Q_VOID;
        if (pt != null) {
            pw = ty_width(pt);
        }
        mut i32 slots = 1;
        if (pt != null) {
            slots = slots_for_size(ty_size(pt));
        }
        xv_add(pp.nm, pt, slots);
        XV* v = xv_find(pp.nm);
        mut char* dst = slot_str(v.slot, v.name);
        if (pw == Q_STRUCT && pt != null) {
            mut i32 esz = ty_size(pt);
            buf_puts_c(g_o, "    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %rcx\n    pushq %r8\n    pushq %r9\n");
            if (ipos < 6) {
                buf_puts_c(g_o, "    movq ");
                buf_puts_c(g_o, ir_reg(ipos));
                buf_puts_c(g_o, ", %rsi\n");
            } else {
                buf_puts_c(g_o, "    movq ");
                buf_puti(g_o, 16 + spos * 8);
                buf_puts_c(g_o, "(%rbp), %rsi\n");
                spos = spos + 1;
            }
            buf_puts_c(g_o, "    leaq ");
            buf_puts_c(g_o, dst);
            buf_puts_c(g_o, ", %rdi\n");
            buf_puts_c(g_o, "    movl $");
            buf_puti(g_o, esz);
            buf_puts_c(g_o, ", %ecx\n    rep movsb\n");
            buf_puts_c(g_o, "    popq %r9\n    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rdi\n");
            ipos = ipos + 1;
        } else if (pw == Q_F32 || pw == Q_F64) {
            if (fpos < 8) {
                if (pw == Q_F32) {
                    buf_puts_c(g_o, "    movss %xmm");
                    buf_puti(g_o, fpos);
                    buf_puts_c(g_o, ", ");
                    buf_puts_c(g_o, dst);
                    buf_putc(g_o, 10);
                } else {
                    buf_puts_c(g_o, "    movsd %xmm");
                    buf_puti(g_o, fpos);
                    buf_puts_c(g_o, ", ");
                    buf_puts_c(g_o, dst);
                    buf_putc(g_o, 10);
                }
                fpos = fpos + 1;
            } else {
                buf_puts_c(g_o, "    movq ");
                buf_puti(g_o, 16 + spos * 8);
                buf_puts_c(g_o, "(%rbp), %rax\n");
                buf_puts_c(g_o, "    movq %rax, ");
                buf_puts_c(g_o, dst);
                buf_putc(g_o, 10);
                spos = spos + 1;
            }
        } else {
            if (ipos < 6) {
                if (pw == Q_I32 || pw == Q_U32 || pw == Q_BOOL || pw == Q_CHAR) {
                    buf_puts_c(g_o, "    movl ");
                    buf_puts_c(g_o, ir32_reg(ipos));
                    buf_puts_c(g_o, ", ");
                    buf_puts_c(g_o, dst);
                    buf_putc(g_o, 10);
                } else {
                    buf_puts_c(g_o, "    movq ");
                    buf_puts_c(g_o, ir_reg(ipos));
                    buf_puts_c(g_o, ", ");
                    buf_puts_c(g_o, dst);
                    buf_putc(g_o, 10);
                }
                ipos = ipos + 1;
            } else {
                buf_puts_c(g_o, "    movq ");
                buf_puti(g_o, 16 + spos * 8);
                buf_puts_c(g_o, "(%rbp), %rax\n");
                buf_puts_c(g_o, "    movq %rax, ");
                buf_puts_c(g_o, dst);
                buf_putc(g_o, 10);
                spos = spos + 1;
            }
        }
        j = j + 1;
    }
    mut char* hm0 = slot_str(g_deferhead, null as char*);
    buf_puts_c(g_o, "    movq $0, ");
    buf_puts_c(g_o, hm0);
    buf_putc(g_o, 10);
    emit_stmts(it.body);
    buf_puts_c(g_o, ".Lfn");
    buf_puti(g_o, g_fnexit);
    buf_puts_c(g_o, ":\n");
    mut char* hm = slot_str(g_deferhead, null as char*);
    mut i32 ltop = new_lbl();
    mut i32 ldone = new_lbl();
    buf_puts_c(g_o, "    pushq %rax\n");
    buf_puts_c(g_o, ".L");
    buf_puti(g_o, ltop);
    buf_puts_c(g_o, ":\n");
    buf_puts_c(g_o, "    movq ");
    buf_puts_c(g_o, hm);
    buf_puts_c(g_o, ", %rax\n");
    buf_puts_c(g_o, "    testq %rax, %rax\n");
    buf_puts_c(g_o, "    jz .L");
    buf_puti(g_o, ldone);
    buf_putc(g_o, 10);
    buf_puts_c(g_o, "    movq (%rax), %rcx\n");
    buf_puts_c(g_o, "    movq %rcx, ");
    buf_puts_c(g_o, hm);
    buf_putc(g_o, 10);
    buf_puts_c(g_o, "    pushq %rax\n");
    buf_puts_c(g_o, "    movq 8(%rax), %rax\n");
    buf_puts_c(g_o, "    subq $8, %rsp\n");
    buf_puts_c(g_o, "    call *%rax\n");
    buf_puts_c(g_o, "    addq $8, %rsp\n");
    buf_puts_c(g_o, "    popq %rdi\n");
    buf_puts_c(g_o, "    call free@PLT\n");
    buf_puts_c(g_o, "    jmp .L");
    buf_puti(g_o, ltop);
    buf_putc(g_o, 10);
    buf_puts_c(g_o, ".L");
    buf_puti(g_o, ldone);
    buf_puts_c(g_o, ":\n");
    buf_puts_c(g_o, "    popq %rax\n");
    buf_puts_c(g_o, "    leave\n    ret\n");
    return;
}


fn x64_emit_prog(Vec* items, char* out_path) -> i32 {
    g_xss = null;
    g_xes = null;
    g_xfs = null;
    g_xlist = null;
    g_rod = null;
    g_xvs = null;
    g_xvn = 0;
    g_xvdepth = 0;
    g_xvbase = 0;
    g_xts = null;
    g_wts = null;
    g_wtdepth = 0;
    g_frameslots = 0;
    g_lbl = 0;
    g_loopn = 0;
    g_loopbrk = null;
    g_loopct = null;
    g_failed = 0;
    g_ab = 0;
    g_ob = 0;
    build_tables(items);
    g_o = buf_new();
    buf_puts_c(g_o, "    # generated taka -> x86-64 (native, no C)\n");
    buf_puts_c(g_o, "    .text\n");
    mut u64 i = 0;
    while (i < vlen(items)) {
        Item* it = vec_get(items, i) as Item*;
        if (it.kind == X_IT_GLOBAL) {
            Stmt* d = it.gdecl;
            mut u64 k = 0;
            while (k < vlen(d.names)) {
                xv_add_global(vec_get(d.names, k) as char*, d.ty);
                k = k + 1;
            }
        }
        i = i + 1;
    }
    g_xvbase = g_xvn;
    i = 0;
    while (i < vlen(items)) {
        Item* it = vec_get(items, i) as Item*;
        if (it.kind != X_IT_FN || it.is_proto) {
            i = i + 1;
            continue;
        }
        g_frameslots = 0;
        g_xts = null;
        g_maxargs = 0;
        g_wts = null;
        g_wtdepth = 0;
        g_wcurret = it.ret;
        g_lkmode = 0;
        walk_fn_body(it);
        Type* rt = it.ret;
        mut i32 rw = Q_VOID;
        if (rt != null) {
            rw = ty_width(rt);
        }
        if (rw == Q_STRUCT) {
            tmp_for(it as u64, 1);
        }
        g_ab = g_frameslots;
        g_frameslots = g_frameslots + 9 * g_maxargs;
        g_ob = g_ab + 8 * g_maxargs;
        g_xvn = g_xvbase;
        g_xvdepth = 0;
        g_lkmode = 1;
        g_curret = it.ret;
        g_srethome = -1;
        g_loopn = 0;
        g_loopbrk = null;
        g_loopct = null;
        Buf* save = g_o;
        g_o = buf_new();
        emit_fn(it);
        Buf* body = g_o;
        g_o = save;
        mut i32 fbytes = align_up(g_frameslots * 8, 16);
        mut char* nm = it.fn_name;
        if (tk_streq(nm, "main")) {
            nm = "taka_main";
        }
        buf_puts_c(g_o, "    .globl ");
        buf_puts_c(g_o, nm);
        buf_putc(g_o, 10);
        buf_puts_c(g_o, nm);
        buf_puts_c(g_o, ":\n");
        buf_puts_c(g_o, "    pushq %rbp\n    movq %rsp, %rbp\n");
        if (fbytes > 0) {
            buf_puts_c(g_o, "    subq $");
            buf_puti(g_o, fbytes);
            buf_puts_c(g_o, ", %rsp\n");
        }
        buf_puts(g_o, body.data, body.len);
        i = i + 1;
    }
    emit_list_helpers();
    buf_puts_c(g_o, "    .data\n");
    buf_puts_c(g_o, "tk_rt_argc:\n    .long 0\n");
    buf_puts_c(g_o, "tk_rt_argv:\n    .quad 0\n");
    buf_puts_c(g_o, "tk_g_exit:\n    .long 0\n");
    buf_puts_c(g_o, "    .text\n");
    buf_puts_c(g_o, "    .globl tk_argc\ntk_argc:\n");
    buf_puts_c(g_o, "    movl tk_rt_argc(%rip), %eax\n    ret\n");
    buf_puts_c(g_o, "    .globl tk_argv\ntk_argv:\n");
    buf_puts_c(g_o, "    movslq %edi, %rcx\n");
    buf_puts_c(g_o, "    testl %ecx, %ecx\n    js .Largv_null\n");
    buf_puts_c(g_o, "    cmpl tk_rt_argc(%rip), %ecx\n    jae .Largv_null\n");
    buf_puts_c(g_o, "    movq tk_rt_argv(%rip), %rax\n");
    buf_puts_c(g_o, "    movq (%rax,%rcx,8), %rax\n    ret\n");
    buf_puts_c(g_o, ".Largv_null:\n    xorl %eax, %eax\n    ret\n");
    buf_puts_c(g_o, "    .globl tk_eprint_rt\ntk_eprint_rt:\n");
    buf_puts_c(g_o, "    movq %rsi, %rdx\n    movq %rdi, %rsi\n    movl $2, %edi\n");
    buf_puts_c(g_o, "    call write@PLT\n    ret\n");
    buf_puts_c(g_o, "    .globl tk_set_exit\ntk_set_exit:\n");
    buf_puts_c(g_o, "    movl %edi, tk_g_exit(%rip)\n    ret\n");
    buf_puts_c(g_o, "    .globl tk_stdout\ntk_stdout:\n");
    buf_puts_c(g_o, "    movq stdout@GOTPCREL(%rip), %rax\n    movq (%rax), %rax\n    ret\n");
    buf_puts_c(g_o, "    .globl tk_strtod_bits\ntk_strtod_bits:\n");
    buf_puts_c(g_o, "    call strtod@PLT\n    movq %xmm0, %rax\n    ret\n");
    buf_puts_c(g_o, "    .globl main\n");
    buf_puts_c(g_o, "main:\n");
    buf_puts_c(g_o, "    pushq %rbp\n    movq %rsp, %rbp\n");
    buf_puts_c(g_o, "    movl %edi, tk_rt_argc(%rip)\n");
    buf_puts_c(g_o, "    movq %rsi, tk_rt_argv(%rip)\n");
    buf_puts_c(g_o, "    call taka_main\n");
    buf_puts_c(g_o, "    movl tk_g_exit(%rip), %eax\n");
    buf_puts_c(g_o, "    leave\n    ret\n");
    buf_puts_c(g_o, "    .section .rodata\n");
    i = 0;
    while (i < vlen(g_rod)) {
        char* s = vec_get(g_rod, i) as char*;
        buf_puts_c(g_o, ".Lstr_");
        buf_puti(g_o, i as i32);
        buf_puts_c(g_o, ":\n    .asciz ");
        emit_asciz(s as u8*, tk_strlen(s));
        buf_putc(g_o, 10);
        i = i + 1;
    }
    mut bool have_data = false;
    i = 0;
    while (i < vlen(items)) {
        Item* it = vec_get(items, i) as Item*;
        if (it.kind != X_IT_GLOBAL) {
            i = i + 1;
            continue;
        }
        Stmt* d = it.gdecl;
        mut u64 k = 0;
        while (k < vlen(d.names)) {
            Expr* init = vec_get(d.inits, k) as Expr*;
            Type* gt = d.ty;
            mut i32 w = Q_VOID;
            if (gt != null) {
                w = ty_width(gt);
            }
            if (init.kind == X_EX_INT && w != Q_STRUCT && w != Q_F32 && w != Q_F64 && w != Q_VOID) {
                if (!have_data) {
                    buf_puts_c(g_o, "    .data\n");
                    have_data = true;
                }
                char* nm = vec_get(d.names, k) as char*;
                buf_puts_c(g_o, nm);
                buf_puts_c(g_o, ":\n");
                u64 bits = lit_int_bits(init.tstart, init.tlen);
                if (w == Q_I8 || w == Q_U8 || w == Q_BOOL || w == Q_CHAR) {
                    buf_puts_c(g_o, "    .byte ");
                    buf_putu(g_o, bits % 256);
                    buf_putc(g_o, 10);
                } else if (w == Q_I16 || w == Q_U16) {
                    buf_puts_c(g_o, "    .value ");
                    buf_putu(g_o, bits % 65536);
                    buf_putc(g_o, 10);
                } else if (w == Q_I32 || w == Q_U32) {
                    buf_puts_c(g_o, "    .long ");
                    buf_putu(g_o, bits % 4294967296);
                    buf_putc(g_o, 10);
                } else {
                    buf_puts_c(g_o, "    .quad ");
                    buf_putu(g_o, bits);
                    buf_putc(g_o, 10);
                }
            } else if (init.kind == X_EX_STRING) {
                if (!have_data) {
                    buf_puts_c(g_o, "    .data\n");
                    have_data = true;
                }
                mut u64 ilen = 0;
                if (init.tlen >= 2) {
                    ilen = init.tlen - 2;
                }
                i32 id = rod_add(init.tstart + 1, ilen);
                char* nm = vec_get(d.names, k) as char*;
                buf_puts_c(g_o, nm);
                buf_puts_c(g_o, ":\n");
                buf_puts_c(g_o, "    .quad .Lstr_");
                buf_puti(g_o, id);
                buf_putc(g_o, 10);
            } else if (init.kind == X_EX_UNARY && (init.op == K_MINUS || init.op == K_PLUS) && init.lhs != null && init.lhs.kind == X_EX_INT && w != Q_STRUCT && w != Q_F32 && w != Q_F64 && w != Q_VOID) {
                if (!const_int_ok(init)) {
                    xerr("non-constant global initializer TODO in native backend");
                } else {
                    if (!have_data) {
                        buf_puts_c(g_o, "    .data\n");
                        have_data = true;
                    }
                    char* nm = vec_get(d.names, k) as char*;
                    buf_puts_c(g_o, nm);
                    buf_puts_c(g_o, ":\n");
                    i32 cv = const_int_val(init);
                    mut u64 bits = 0;
                    if (cv < 0) {
                        bits = (0 - cv) as u64;
                        bits = 0 - bits;
                    } else {
                        bits = cv as u64;
                    }
                    if (w == Q_I8 || w == Q_U8 || w == Q_BOOL || w == Q_CHAR) {
                        buf_puts_c(g_o, "    .byte ");
                        buf_putu(g_o, bits % 256);
                        buf_putc(g_o, 10);
                    } else if (w == Q_I16 || w == Q_U16) {
                        buf_puts_c(g_o, "    .value ");
                        buf_putu(g_o, bits % 65536);
                        buf_putc(g_o, 10);
                    } else if (w == Q_I32 || w == Q_U32) {
                        buf_puts_c(g_o, "    .long ");
                        buf_putu(g_o, bits % 4294967296);
                        buf_putc(g_o, 10);
                    } else {
                        buf_puts_c(g_o, "    .quad ");
                        buf_putu(g_o, bits);
                        buf_putc(g_o, 10);
                    }
                }
            } else if (init.kind == X_EX_NULL) {
                if (!have_data) {
                    buf_puts_c(g_o, "    .data\n");
                    have_data = true;
                }
                char* nm = vec_get(d.names, k) as char*;
                buf_puts_c(g_o, nm);
                buf_puts_c(g_o, ":\n");
                buf_puts_c(g_o, "    .quad 0\n");
            } else {
                xerr("non-constant global initializer TODO in native backend");
            }
            k = k + 1;
        }
        i = i + 1;
    }
    buf_puts_c(g_o, "    .section .note.GNU-stack,\"\",@progbits\n");
    u8* f = tk_fopen(out_path, "w");
    if (f == null) {
        return 1;
    }
    tk_fwrite(g_o.data, 1, g_o.len, f);
    tk_fclose(f);
    if (g_failed != 0) {
        return 1;
    }
    return 0;
}

fn main() {
    if (tk_argc() < 3) {
        tk_eprint("usage: self_emit <in.sexp> <out.s>\n" as u8*, 35);
        tk_set_exit(1);
        return;
    }
    char* ipath = tk_argv(1);
    char* opath = tk_argv(2);
    u8* memb = tk_malloc(67108864);
    if (memb == null) {
        return;
    }
    Arena ar = arena_mk(memb, 67108864);
    u8* f = tk_fopen(ipath, "r");
    if (f == null) {
        tk_eprint(ipath as u8*, tk_strlen(ipath));
        tk_eprint(": No such file or directory\n" as u8*, 28);
        tk_set_exit(1);
        return;
    }
    tk_fseek(f, 0, 2);
    i64 size = tk_ftell(f);
    tk_fseek(f, 0, 0);
    mut u64 n = size as u64;
    u8* buf = arena_alloc(&ar, n + 8);
    if (buf == null) {
        return;
    }
    tk_fread(buf, 1, n, f);
    tk_fclose(f);
    mut u64 z = 0;
    while (z < 8) {
        buf[n + z] = 0;
        z = z + 1;
    }
    g_ar = &ar;
    SXB xb = SXB { src: buf, len: n, pos: 0, };
    SX* root = sx_read(g_ar, &xb);
    if (root == null) {
        tk_eprint("sexp parse error\n" as u8*, 18);
        tk_set_exit(1);
        return;
    }
    if (root.is_int || vlen(root.kids) == 0) {
        tk_eprint("sexp parse error\n" as u8*, 18);
        tk_set_exit(1);
        return;
    }
    SX* hd = vec_get(root.kids, 0) as SX*;
    if (hd.is_int || !sx_eq(hd, "program", 7)) {
        tk_eprint("sexp parse error\n" as u8*, 18);
        tk_set_exit(1);
        return;
    }
    Vec* items = cv_program(g_ar, root);
    i32 rc = x64_emit_prog(items, opath);
    tk_set_exit(rc);
    return;
}

