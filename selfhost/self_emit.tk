struct Arena { u8* buf, u64 cap, u64 pos, }

fn arena_mk(u8* buf, u64 cap) -> Arena {
    Arena a = Arena { buf: buf, cap: cap, pos: 0, };
    return a;
}

fn arena_alloc(Arena* a, u64 n) -> u8* {
    u64 start = (a.pos + 7) / 8 * 8;
    u64 end = start + n;
    if (end > a.cap) {
        return null;
    }
    a.pos = end;
    return a.buf + start;
}

fn zac(Arena* a, u64 n) -> u8* {    u8* m = arena_alloc(a, n);
    if (m == null) {
        return null;
    }
    mut u64 i = 0;
    while (i < n) {
        m[i] = 0;
        i = i + 1;
    }
    return m;
}

fn i32_to_str(i32 x, Arena* a) -> sview {
    u8* buf = arena_alloc(a, 12);
    bool neg = x < 0;
    mut u64 n = x as u64;
    if (neg) {
        n = (0 - x) as u64;
    }
    mut u64 end = 12;
    if (n == 0) {
        end = end - 1;
        buf[end] = 48;
    }
    while (n > 0) {
        u64 d = n % 10;
        n = n / 10;
        end = end - 1;
        buf[end] = (48 + d) as u8;
    }
    mut u64 at = end;
    if (neg) {
        at = at - 1;
        buf[at] = 45;
    }
    u64 len = 12 - at;
    sview s = tk_sview_u8(buf + at, len);
    return s;
}

struct Vec { u8* buf, u64 len, u64 cap, }
struct Slot { u8* p, }

fn vec_new() -> Vec* {
    mut u8* m = tk_malloc(24);
    Vec* v = m as Vec*;
    v.buf = null;
    v.len = 0;
    v.cap = 0;
    return v;
}

fn vec_push(Vec* v, u8* x) {
    if (v.len == v.cap) {
        mut u64 ncap = 8;
        if (v.cap != 0) {
            ncap = v.cap + v.cap;
        }
        u8* nb = tk_malloc(ncap * 8);
        mut u64 i = 0;
        while (i < v.len) {
            Slot* d = (nb + i * 8) as Slot*;
            Slot* s = (v.buf + i * 8) as Slot*;
            d.p = s.p;
            i = i + 1;
        }
        v.buf = nb;
        v.cap = ncap;
    }
    mut Slot* dst = (v.buf + v.len * 8) as Slot*;
    dst.p = x;
    v.len = v.len + 1;
    return;
}

fn vec_get(Vec* v, u64 i) -> u8* {
    Slot* s = (v.buf + i * 8) as Slot*;
    return s.p;
}

fn vlen(Vec* v) -> u64 {
    if (v == null) {
        return 0;
    }
    return v.len;
}

fn vpush(Vec* v, u8* x) -> Vec* {
    mut Vec* w = v;
    if (w == null) {
        w = vec_new();
    }
    vec_push(w, x);
    return w;
}

struct Buf { u8* data, u64 len, u64 cap, }

fn buf_new() -> Buf* {
    mut u8* m = tk_malloc(24);
    Buf* b = m as Buf*;
    b.data = null;
    b.len = 0;
    b.cap = 0;
    return b;
}

fn buf_reserve(Buf* b, u64 extra) {
    while (b.len + extra > b.cap) {
        mut u64 ncap = 256;
        if (b.cap != 0) {
            ncap = b.cap + b.cap;
        }
        u8* nm = tk_malloc(ncap);
        mut u64 i = 0;
        while (i < b.len) {
            nm[i] = b.data[i];
            i = i + 1;
        }
        b.data = nm;
        b.cap = ncap;
    }
    return;
}

fn buf_putc(Buf* b, u8 c) {
    buf_reserve(b, 1);
    b.data[b.len] = c;
    b.len = b.len + 1;
    return;
}

fn buf_puts(Buf* b, u8* s, u64 n) {
    buf_reserve(b, n);
    mut u64 i = 0;
    while (i < n) {
        b.data[b.len + i] = s[i];
        i = i + 1;
    }
    b.len = b.len + n;
    return;
}

fn buf_puts_c(Buf* b, char* s) {
    buf_puts(b, s as u8*, tk_strlen(s));
    return;
}

fn buf_putu(Buf* b, u64 v) {
    if (v == 0) {
        buf_putc(b, 48);
        return;
    }
    u8* d = tk_malloc(24);
    mut u64 n = 0;
    mut u64 x = v;
    while (x > 0) {
        d[n] = (x % 10 + 48) as u8;
        n = n + 1;
        x = x / 10;
    }
    while (n > 0) {
        n = n - 1;
        buf_putc(b, d[n]);
    }
    return;
}

fn buf_puti(Buf* b, i32 v) {
    if (v < 0) {
        buf_putc(b, 45);
        buf_putu(b, (0 - v) as u64);
    } else {
        buf_putu(b, v as u64);
    }
    return;
}

fn buf_putx(Buf* b, u64 v) {
    if (v == 0) {
        buf_putc(b, 48);
        return;
    }
    u8* d = tk_malloc(24);
    mut u64 n = 0;
    mut u64 x = v;
    while (x > 0) {
        u64 q = x % 16;
        mut u8 c = 48;
        if (q < 10) {
            c = (q + 48) as u8;
        } else {
            c = (q + 87) as u8;
        }
        d[n] = c;
        n = n + 1;
        x = x / 16;
    }
    while (n > 0) {
        n = n - 1;
        buf_putc(b, d[n]);
    }
    return;
}

fn buf_puto3(Buf* b, u64 v) {
    u8 c0 = ((v / 64) % 8 + 48) as u8;
    u8 c1 = ((v / 8) % 8 + 48) as u8;
    u8 c2 = (v % 8 + 48) as u8;
    buf_putc(b, c0);
    buf_putc(b, c1);
    buf_putc(b, c2);
    return;
}

// int literal text (no NUL needed) -> u64 bits; mirrors lit_int_bits.
fn lit_int_bits(u8* s, u64 n) -> u64 {
    u8* b = tk_malloc(128);
    mut u64 m = 0;
    mut u64 i = 0;
    while (i < n && m < 120) {
        u8 c = s[i];
        if (c != 95) {
            if ((c == 105 || c == 117) && m > 0) {
                break;
            }
            b[m] = c;
            m = m + 1;
        }
        i = i + 1;
    }
    if (m > 2 && b[0] == 48 && (b[1] == 120 || b[1] == 88)) {
        mut u64 v = 0;
        mut u64 j = 2;
        while (j < m) {
            u8 h = b[j];
            mut u64 d = 0;
            if (h >= 48 && h <= 57) {
                d = (h - 48) as u64;
            } else if (h >= 97 && h <= 102) {
                d = (h - 87) as u64;
            } else {
                d = (h - 55) as u64;
            }
            v = v * 16 + d;
            j = j + 1;
        }
        return v;
    }
    if (m > 2 && b[0] == 48 && (b[1] == 98 || b[1] == 66)) {
        mut u64 v = 0;
        mut u64 j = 2;
        while (j < m) {
            v = v * 2 + (b[j] - 48) as u64;
            j = j + 1;
        }
        return v;
    }
    mut u64 v = 0;
    mut u64 j = 0;
    while (j < m) {
        v = v * 10 + (b[j] - 48) as u64;
        j = j + 1;
    }
    return v;
}

// char literal slice (with quotes) -> value, -1 on error; mirrors lit_char_val.
fn lit_char_val(u8* s, u64 n) -> i64 {
    if (n < 3) {
        return -1;
    }
    if (s[1] != 92) {
        return s[1] as i64;
    }
    if (n < 4) {
        return -1;
    }
    u8 e = s[2];
    if (e == 110) {
        return 10;
    }
    if (e == 116) {
        return 9;
    }
    if (e == 114) {
        return 13;
    }
    if (e == 48) {
        return 0;
    }
    if (e == 92) {
        return 92;
    }
    if (e == 39) {
        return 39;
    }
    if (e == 34) {
        return 34;
    }
    if (e == 120) {
        mut i64 v = 0;
        mut u64 j = 3;
        while (j + 1 < n) {
            u8 h = s[j];
            mut i64 d = -1;
            if (h >= 48 && h <= 57) {
                d = (h - 48) as i64;
            } else if (h >= 97 && h <= 102) {
                d = (h - 87) as i64;
            } else if (h >= 65 && h <= 70) {
                d = (h - 55) as i64;
            }
            if (d < 0) {
                break;
            }
            v = v * 16 + d;
            j = j + 1;
        }
        return v;
    }
    return -1;
}
