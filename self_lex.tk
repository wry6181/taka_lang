struct Arena { u8* buf, u64 cap, u64 pos, }

fn arena_mk(u8* buf, u64 cap) -> Arena {
    Arena a = Arena { buf: buf, cap: cap, pos: 0, };
    return a;
}

fn arena_alloc(Arena* a, u64 n) -> u8* {
    u64 start = (a.pos + 7) / 8 * 8;
    u64 end = start + n;
    if (end > a.cap) {
        return null;
    }
    a.pos = end;
    return a.buf + start;
}

fn str_eq(sview a, sview b) -> bool {
    if (a.len != b.len) {
        return false;
    }
    mut u64 i = 0;
    while (i < a.len as u64) {
        if (a.ptr[i] != b.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---- self-hosted lexer (stage 1): mirrors lexer.c ----

struct TkTok { i32 kind, u8* start, u64 len, i32 line, i32 col, }
struct TkLex { u8* src, u64 pos, i32 line, i32 col, }

fn tk_peek(TkLex* lx) -> u8 {
    return lx.src[lx.pos];
}

fn tk_peek2(TkLex* lx) -> u8 {
    return lx.src[lx.pos + 1];
}

fn tk_peek3(TkLex* lx) -> u8 {
    return lx.src[lx.pos + 2];
}

fn tk_advance(TkLex* lx) -> u8 {
    u8 c = lx.src[lx.pos];
    lx.pos = lx.pos + 1;
    if (c == 10) {
        lx.line = lx.line + 1;
        lx.col = 1;
    } else {
        lx.col = lx.col + 1;
    }
    return c;
}

fn tk_make(TkLex* lx, i32 kind, u64 start, i32 line, i32 col) -> TkTok {
    TkTok t = TkTok { kind: kind, start: lx.src + start, len: lx.pos - start, line: line, col: col, };
    return t;
}

fn tk_is_alpha(u8 c) -> bool {
    if (c >= 97 && c <= 122) { return true; }
    if (c >= 65 && c <= 90) { return true; }
    return false;
}

fn tk_is_digit(u8 c) -> bool {
    if (c >= 48 && c <= 57) { return true; }
    return false;
}

fn tk_is_alnum(u8 c) -> bool {
    if (tk_is_alpha(c)) { return true; }
    if (tk_is_digit(c)) { return true; }
    return false;
}

fn tk_is_hexdig(u8 c) -> bool {
    if (tk_is_digit(c)) { return true; }
    if (c >= 97 && c <= 102) { return true; }
    if (c >= 65 && c <= 70) { return true; }
    return false;
}

fn tk_skip(TkLex* lx) {
    while (true) {
        u8 c = tk_peek(lx);
        if (c == 32 || c == 9 || c == 13 || c == 10) {
            tk_advance(lx);
        } else if (c == 47 && tk_peek2(lx) == 47) {
            while (tk_peek(lx) != 0 && tk_peek(lx) != 10) { tk_advance(lx); }
        } else if (c == 47 && tk_peek2(lx) == 42) {
            tk_advance(lx);
            tk_advance(lx);
            mut i32 depth = 1;
            while (depth > 0 && tk_peek(lx) != 0) {
                if (tk_peek(lx) == 47 && tk_peek2(lx) == 42) {
                    tk_advance(lx);
                    tk_advance(lx);
                    depth = depth + 1;
                } else if (tk_peek(lx) == 42 && tk_peek2(lx) == 47) {
                    tk_advance(lx);
                    tk_advance(lx);
                    depth = depth - 1;
                } else {
                    tk_advance(lx);
                }
            }
        } else {
            break;
        }
    }
    return;
}

fn tk_match_suffix(TkLex* lx, sview s) -> bool {
    mut u64 i = 0;
    while (i < s.len as u64) {
        if (lx.src[lx.pos + i] != s.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    u8 after = lx.src[lx.pos + i];
    if (tk_is_alnum(after) || after == 95) {
        return false;
    }
    mut u64 j = 0;
    while (j < s.len as u64) {
        tk_advance(lx);
        j = j + 1;
    }
    return true;
}

fn tk_float_suffix(TkLex* lx) {
    if (tk_peek(lx) == 102 && tk_peek2(lx) == 51 && tk_peek3(lx) == 50) {
        u8 a = lx.src[lx.pos + 3];
        if (!tk_is_alnum(a) && a != 95) {
            tk_advance(lx);
            tk_advance(lx);
            tk_advance(lx);
        }
    } else if (tk_peek(lx) == 102 && tk_peek2(lx) == 54 && tk_peek3(lx) == 52) {
        u8 a = lx.src[lx.pos + 3];
        if (!tk_is_alnum(a) && a != 95) {
            tk_advance(lx);
            tk_advance(lx);
            tk_advance(lx);
        }
    }
    return;
}

fn tk_next(TkLex* lx) -> TkTok {
    tk_skip(lx);
    u64 start = lx.pos;
    i32 line = lx.line;
    i32 col = lx.col;
    u8 c = tk_peek(lx);
