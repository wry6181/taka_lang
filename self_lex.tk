fn tk_dump(TkTok* t, u8* base) {
    tk_print_i32(t.kind);
    tk_print_i32((t.start - base) as i32);
    tk_print_i32(t.len as i32);
    tk_print_i32(t.line);
    tk_print_i32(t.col);
    return;
}

fn main() {
    if (tk_argc() < 2) {
        return;
    }
    char* path = tk_argv(1);
    u8* mem = tk_malloc(1048576);
    Arena ar = arena_mk(mem, 1048576);
    u8* f = tk_fopen(path, "r");
    if (f == null) {
        tk_eprint(path as u8*, tk_strlen(path));
        tk_eprint(": No such file or directory\n" as u8*, 28);
        tk_set_exit(1);
        return;
    }
    tk_fseek(f, 0, 2);
    i64 size = tk_ftell(f);
    tk_fseek(f, 0, 0);
    u64 n = size as u64;
    u8* buf = arena_alloc(&ar, n + 8);
    if (buf == null) {
        return;
    }
    u64 got = tk_fread(buf, 1, n, f);
    tk_fclose(f);
    if (got != n) {
        return;
    }
    mut u64 z = 0;
    while (z < 8) {
        buf[n + z] = 0;
        z = z + 1;
    }
    TkLex lx = TkLex { src: buf, pos: 0, line: 1, col: 1, };
    while (true) {
        TkTok t = tk_next(&lx);
        tk_dump(&t, buf);
        if (t.kind == K_EOF) {
            break;
        }
    }
    tk_free(mem);
    return;
}
