extern fn tk_print_i32(i32 x);

enum Color { Red = 1, Green = 2, Blue = 4, }

enum Opt { Some(i32), None, }

enum Shape { Circle(i32), Rect { i32 w, i32 h, }, Empty, }

fn classify(Color c) -> i32 {
    mut i32 out = 0;
    match c {
        Color::Red => { out = 1; },
        Color::Green | Color::Blue => { out = 2; },
        _ => { out = 3; },
    }
    return out;
}

fn opt_val(Opt o) -> i32 {
    mut i32 out = 0;
    match o {
        Opt::Some(x) if x > 10 => { out = x; },
        Opt::Some(x) => { out = x; },
        Opt::None => { out = 0 - 1; },
    }
    return out;
}

fn shape_val(Shape s) -> i32 {
    mut i32 out = 0;
    match s {
        Shape::Circle(r) => { out = r; },
        Shape::Rect { w, h } => { out = w + h; },
        Shape::Empty => { out = 0 - 7; },
    }
    return out;
}

fn ref_val(Opt o) -> i32 {
    mut i32 out = 0;
    match o {
        Opt::Some(&v) => { out = *v + 100; },
        Opt::None => { out = 0 - 2; },
    }
    return out;
}

fn ref_top(Shape s) -> i32 {
    mut i32 out = 0;
    match s {
        &p => { out = 50; },
        _ => { out = 51; },
    }
    return out;
}

fn ref_field(Shape s) -> i32 {
    mut i32 out = 0;
    match s {
        Shape::Rect { w: &wv, h } => { out = *wv + h; },
        _ => { out = 0 - 3; },
    }
    return out;
}

fn main() {
    tk_print_i32(classify(Color::Red));
    tk_print_i32(classify(Color::Blue));
    tk_print_i32(classify(Color::Green));
    Opt a = Opt::Some(5);
    Opt b = Opt::Some(42);
    Opt c = Opt::None;
    tk_print_i32(opt_val(a));
    tk_print_i32(opt_val(b));
    tk_print_i32(opt_val(c));
    Shape s1 = Shape::Circle(7);
    Shape s2 = Shape::Rect { w: 3, h: 4, };
    Shape s3 = Shape::Empty;
    tk_print_i32(shape_val(s1));
    tk_print_i32(shape_val(s2));
    tk_print_i32(shape_val(s3));
    tk_print_i32(ref_val(a));
    tk_print_i32(ref_val(c));
    tk_print_i32(ref_top(s1));
    tk_print_i32(ref_field(s2));
    tk_print_i32(ref_field(s1));
    return;
}
