fn generic_fn<T>(T x) -> T {
    return x;
}
fn generic_bound<T: Clone>(T x) -> T {
    return x;
}
fn generic_where<T>(T x) -> T where T: Clone {
    return x;
}
fn multi_bound<T>(T x) where T: Clone + Copy {
    return x;
}
fn trailing_comma(i32 a, f32 b,) -> i32 {
    return a;
}
fn map_like<T, U>(List<T>* xs, fn(T) <| e> -> U f) <alloc | e> -> List<U> {
    return xs;
}
// NOTE: generic struct lit like List<U> { } does NOT parse today
// (struct_lit has no generic_args) — say if you want it:
// NEG: auto g = List<U> { };
// NOTE: tuple values like (1, 2) do NOT parse today
