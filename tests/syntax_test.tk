    return;
}
pub fn pub_fn(i32 x) -> i32 {
    return x;
}
private fn priv_fn() <pure> {
    return;
}
fn eff_io() <io> {
    return;
}
fn eff_heap() <reads, writes, alloc> {
    return;
}
fn eff_transact() <transacts> {
    return;
}
fn eff_decides(i32 x) <decides> -> i32 {
    return x;
}
fn eff_suspends() <suspends> {
    return;
}
