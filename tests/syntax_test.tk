// ---------- 0. comments ----------
// line comment
/* block comment */
/* nestable /* inner */ outer */

// ---------- 1. imports ----------
import foo;
import foo::bar::baz;

// ---------- 2. visibility on items ----------
pub import pub_stuff;
private import priv_stuff;

// ---------- 3. type aliases + globals ----------
type MyInt = i32;
pub type Pair = (i32, f32);
private type Box<T> = List<T>;
type FnAlias = fn(i32) <io> -> i32;

i32 g_count = 0;
pub mut i32 g_mut = 1;
private sview g_name = "taka";
auto g_auto = 42;
// NEG: <> is illegal — <> bad;

// ---------- 4. structs ----------
struct Point { i32 x, i32 y, }
pub struct PubPoint { pub i32 x, private i32 y, }
private struct PrivPoint { i32 x, i32 y }
struct GenericBox<T> { T value, }
struct Bounded<T> where T: Clone { T v, }
struct WithMisc {
    pub const i32* name,
    private mut u8 flags,
    i32* ptr,
    i32** pptr,
}

// ---------- 5. enums ----------
enum Color { Red = 1, Green = 2, Blue = 4, }
pub enum Shape {
    pub Circle(f32),
    private Rect { f32 w, f32 h, },
    Empty,
}
private enum Verbose<T> where T: Clone {
    Yes(T),
    No,
    Other = 7,
}
enum Mixed {
    A(i32, f32),
    B { i32 x, bool on },
    C = 3,
}

// ---------- 6. effects ----------
effect Log {
    fn log(sview msg),
    fn level() -> i32,
}
pub effect PubEff {
    pub fn a(i32 x) -> i32,
    private fn b(),
}
effect GenericEff<T> {
    fn put(T v),
    fn get() -> T,
}

// ---------- 7. handlers ----------
handler ConsoleLog for Log {
    log(sview msg) => { print(msg); resume(); },
    level() => resume(2),
}
pub handler Full for Log {
    log(sview m) => resume(),
    level() => { resume(0); },
    return (i32 x) => x,
}

