{
  "name": "taka",
  "scopeName": "source.taka",
  "fileTypes": ["tk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#effects" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.taka",
          "match": "//.*$"
        },
        {
          "name": "comment.block.taka",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.taka",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.taka", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.taka",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.taka", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.taka",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?(?:f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.hex.taka",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*(?:i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        },
        {
          "name": "constant.numeric.bin.taka",
          "match": "\\b0[bB][01][01_]*(?:i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        },
        {
          "name": "constant.numeric.integer.taka",
          "match": "\\b\\d[\\d_]*(?:i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.taka",
          "match": "\\b(fn|struct|enum|effect|handler|trait|impl|dyn|type|extern|import|mod)\\b"
        },
        {
          "name": "keyword.modifier.taka",
          "match": "\\b(pub|private|const|mut|auto)\\b"
        },
        {
          "name": "keyword.control.taka",
          "match": "\\b(where|for|in|if|else|while|match|break|continue|return|defer)\\b"
        },
        {
          "name": "keyword.effect-op.taka",
          "match": "\\b(perform|handle|with|resume|transact|spawn)\\b"
        },
        {
          "name": "keyword.operator-word.taka",
          "match": "\\b(as|sizeof|offsetof)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.taka",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|char|bool|sview|never)\\b"
        },
        {
          "name": "storage.type.self.taka",
          "match": "\\bSelf\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        {
          "name": "storage.modifier.effect.taka",
          "match": "\\b(io|alloc|reads|writes|decides|suspends|transacts|pure|ownership)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.taka",
          "match": "\\b(true|false|null|undef)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.taka",
          "match": "=>|->|::|\\.\\.|==|!=|<=|>=|<<=|>>=|<<|>>|&&|\\|\\||\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\+\\+|--|[+\\-*/%=<>!~&|^?:]"
        },
        {
          "name": "punctuation.taka",
          "match": "[(){}\\[\\];,]"
        }
      ]
    }
  }
}
